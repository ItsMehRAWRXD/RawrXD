# MSVC / Visual Studio Artifacts
.vs/
build/
out/
x64/
*.user
*.suo
*.db
*.opendb

# Compiled Binaries (Stored in Release Archive)
*.exe
*.pdb
*.ilk
*.obj
*.lib

# --- CRITICAL: MODEL BLOCK LIST ---
# Prevents massive weights from accidentally being pushed to the remote
*.gguf
*.rom
*.bin
*_shards/
_r1_named/
deepseek*/
kimi*/
phi3*/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
install_manifest.txt

# Build artifacts & test outputs
move10_output.txt
run_converter.bat
run_move10.bat
# The GLSL compute shader sources are tracked; the SPIR-V is generated from
# them at build time by glslangValidator, which ships with the Vulkan SDK.
shaders/*.spv

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
# The certification build tree: a second copy of the build, used to keep a
# certification run from colliding with a build that is already in flight.
build-cert/
