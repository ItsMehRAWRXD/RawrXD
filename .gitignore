# Scratch trees produced by concurrent lanes. These are build output, not
# source: cert_agentic/b15_build is a CMake/Ninja tree (25 files: CMakeCache,
# .ninja_deps, CMakeFiles) that regenerates from cert_agentic/b15_fixture, and
# the __pycache__ entry is CPython bytecode. The fixture source and the
# certification scripts themselves remain tracked.
cert_agentic/b15_build/
__pycache__/

# Zero-byte scratch probe output from server smoke runs (gate1_srv.*).
gate1_srv.err
gate1_srv.out
receipts/ledger/_backups/

# Accidental stale copy of the whole rawrxd/ tree (24,888 files / 7.7 GB),
# created by a Copy-Item/robocopy run with the wrong destination. It is a
# DIVERGENT snapshot, not a copy: Deep2Engine.cpp differs from rawrxd/src/.
# Committing it would add 7.7 GB and a second, conflicting source tree.
/rawrxd copy/

# CLI litter written into the repo root by running project tools with the
# wrong working directory or test positional args. Each one holds a single
# stray workspace.json or receipt written relative to CWD.
valid/
zerofolders/
malformed/
first/
--help/

