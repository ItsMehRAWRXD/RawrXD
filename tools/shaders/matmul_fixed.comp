#version 450

// Matrix multiplication compute shader
// C = A @ B (A: m x k row-major, B: k x n row-major, C: m x n row-major)
//
// Push-constant order is { m, n, k } and MUST match the host dispatcher.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer BufferA {
    float a_data[];
};

layout(std430, binding = 1) readonly buffer BufferB {
    float b_data[];
};

layout(std430, binding = 2) writeonly buffer BufferC {
    float c_data[];
};

layout(push_constant) uniform PushConstants {
    uint m;
    uint n;
    uint k;
};

shared float shared_a[16][16];
shared float shared_b[16][16];

void main() {
    uint row = gl_GlobalInvocationID.y;   // C row   (m dimension)
    uint col = gl_GlobalInvocationID.x;   // C column (n dimension)

    uint local_row = gl_LocalInvocationID.y;
    uint local_col = gl_LocalInvocationID.x;

    // Do NOT return early here. Every invocation in the workgroup must reach
    // the barrier() below, otherwise behaviour is undefined. Out-of-range
    // outputs are guarded at the final store instead.
    bool in_range = (row < m && col < n);

    float sum = 0.0;

    // Tiled matrix multiplication. Tiles are padded with zeros so that
    // dimensions that are not multiples of 16 accumulate correctly.
    uint num_tiles = (k + 15u) / 16u;
    for (uint tile = 0; tile < num_tiles; ++tile) {
        uint a_col = tile * 16u + local_col;
        uint b_row = tile * 16u + local_row;

        shared_a[local_row][local_col] = (a_col < k) ? a_data[row * k + a_col] : 0.0;
        shared_b[local_row][local_col] = (b_row < k) ? b_data[b_row * n + col] : 0.0;

        barrier();

        for (uint i = 0; i < 16u; ++i) {
            sum += shared_a[local_row][i] * shared_b[i][local_col];
        }

        barrier();
    }

    if (in_range) {
        c_data[row * n + col] = sum;
    }
}
