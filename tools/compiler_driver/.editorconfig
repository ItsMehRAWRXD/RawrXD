# EditorConfig for RAWRXD Compiler Driver
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# C/C++ source files
[*.{c,h,cpp,hpp}]
indent_style = space
indent_size = 4
max_line_length = 80

# C# source files
[*.cs]
indent_style = space
indent_size = 4
max_line_length = 120

# Assembly files
[*.{asm,s,nasm}]
indent_style = space
indent_size = 4

# JavaScript/JSON
[*.{js,json}]
indent_style = space
indent_size = 2

# YAML
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
max_line_length = off

# Batch files
[*.{bat,cmd}]
end_of_line = crlf

# Shell scripts
[*.sh]
end_of_line = lf

# Makefile
[Makefile]
indent_style = tab

# Documentation
[*.txt]
indent_style = space
indent_size = 2
