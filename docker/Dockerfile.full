# =============================================================================
# RawrXD Full Stack Container - Security Hardened
# Runs Win32 IDE via Wine + noVNC for browser access + Backend API
# Updated: 2026-07-13 for v1.0.1-hotfix2
# Addresses: Container security vulnerabilities, OpenSSL updates
# =============================================================================

FROM ubuntu:22.04@sha256:0e5e4a57c2499249aafc3b40fcd541e9a456aab7296681a3904b1efbf1dff80d

ENV DEBIAN_FRONTEND=noninteractive
ENV WINEDEBUG=-all
ENV DISPLAY=:1
ENV VNC_PORT=5901
ENV NOVNC_PORT=8080
ENV RAWRXD_PORT=23959

# Security: Create non-root user
RUN groupadd -r rawrxd && useradd -r -g rawrxd -m -s /bin/bash rawrxd

# Install dependencies with security updates
RUN dpkg --add-architecture i386 && \
    apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
    wine64 wine32 xvfb x11vnc novnc websockify \
    python3 python3-pip nodejs npm \
    supervisor fluxbox xterm \
    libvulkan1 mesa-vulkan-drivers \
    libssl3=3.0.2-0ubuntu1.15 \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Setup Wine prefix
ENV WINEPREFIX=/root/.wine
ENV WINEARCH=win64
RUN winecfg && wineserver -w

# Copy IDE binaries
COPY RawrXD-Win32IDE.exe /opt/rawrxd/
COPY RawrXD-Agent.exe /opt/rawrxd/
COPY web_interface/ /opt/rawrxd/web/

# Copy backend
COPY Ship/ /opt/rawrxd/backend/

# Setup supervisor configs
COPY docker/supervisord.conf /etc/supervisor/conf.d/rawrxd.conf

# Security: Set proper permissions
RUN chown -R rawrxd:rawrxd /opt/rawrxd

# Expose ports
EXPOSE 8080 23959 5901

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:23959/health || exit 1

# Security: Switch to non-root user
USER rawrxd

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/rawrxd.conf"]