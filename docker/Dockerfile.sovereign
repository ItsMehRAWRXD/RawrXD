# Sovereign Substrate - Production Docker Image
# Multi-stage build for minimal size

# Stage 1: Build
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    ninja-build \
    git \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /build

# Copy source code
COPY . .

# Configure and build
RUN cmake -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DRAWR_BUILD_TESTS=ON \
    -DRAWR_BUILD_DEMO=ON \
    -DRAWR_SECURITY_HARDENING=ON \
    -DRAWR_MODEL_ADAPTER=ON \
    -DRAWR_PERSISTENCE=ON \
    -DRAWR_TELEMETRY=ON \
    -G Ninja \
    && cmake --build build --parallel $(nproc)

# Run tests
RUN cd build && ctest --output-on-failure

# Stage 2: Runtime
FROM ubuntu:22.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -s /bin/bash sovereign

# Set working directory
WORKDIR /app

# Copy built artifacts from builder
COPY --from=builder /build/build/lib/libsovereign.so /app/lib/
COPY --from=builder /build/build/demo/demo_sovereign_substrate /app/bin/
COPY --from=builder /build/build/tests/*_test /app/tests/

# Copy configuration
COPY --from=builder /build/config/sovereign.json /app/config/

# Set library path
ENV LD_LIBRARY_PATH=/app/lib:$LD_LIBRARY_PATH

# Switch to non-root user
USER sovereign

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Expose ports
EXPOSE 8080 8081

# Default command
CMD ["/app/bin/demo_sovereign_substrate", "--server"]
