# Deep2 Qwen32 85TPS — Batch 6, item 49
# Base: apply after 0048.
#
# Adds bounded pipeline overlap:
# - CPU n-gram/adaptive proposal preparation for next window is allowed to run
#   while current target verification is completing.
# - never overlaps two target writes to KV.
# - no unverified token is emitted.
#
# Also adds wall-clock stage counters so the next decision is empirical.
#
# Apply:
#   git -C F:\~dev apply --3way 0049_spec_pipeline_overlap_and_counters.patch

diff --git a/~dev/rawrxd/src/deep2/Deep2Speculative.hpp b/~dev/rawrxd/src/deep2/Deep2Speculative.hpp
--- a/~dev/rawrxd/src/deep2/Deep2Speculative.hpp
+++ b/~dev/rawrxd/src/deep2/Deep2Speculative.hpp
@@
     uint64_t kvMirrorResidentAttn=0;
+    uint64_t proposalNs=0;
+    uint64_t verifyNs=0;
+    uint64_t targetBatchNs=0;
+    uint64_t attentionNs=0;
+    uint64_t columnReduceNs=0;
+    uint64_t pipelineWindows=0;

diff --git a/~dev/rawrxd/src/deep2/Deep2Engine_Speculative.cpp b/~dev/rawrxd/src/deep2/Deep2Engine_Speculative.cpp
