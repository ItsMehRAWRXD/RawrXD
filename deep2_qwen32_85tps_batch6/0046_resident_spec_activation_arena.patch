# Deep2 Qwen32 85TPS — Batch 6, item 46
# Base: 40TPS Batches 1-4 + 85TPS Batches 1-5
#
# Goal: keep the complete 1..4-token speculative activation set resident on
# the primary GPU across RMSNorm -> QKV -> attention -> O -> residual ->
# FFN norm -> Gate/Up -> SwiGLU -> Down -> residual.
#
# This patch adds a reusable device arena only. Item 47 binds operations to it.
#
# Apply:
#   git -C F:\~dev apply --3way 0046_resident_spec_activation_arena.patch

diff --git a/~dev/rawrxd/src/deep2/vulkan_compute.h b/~dev/rawrxd/src/deep2/vulkan_compute.h
--- a/~dev/rawrxd/src/deep2/vulkan_compute.h
+++ b/~dev/rawrxd/src/deep2/vulkan_compute.h
@@
 public:
+    struct SpecBatchArena {
+        DeviceBuf hidden{}, norm{}, q{}, k{}, v{}, attn{}, proj{};
+        DeviceBuf gate{}, up{}, act{}, down{}, tmp{};
+        uint32_t hiddenWidth=0;
+        uint32_t kvWidth=0;
+        uint32_t intermediate=0;
+        uint32_t batchCapacity=0;
+        bool valid() const noexcept {
+            return hidden&&norm&&q&&k&&v&&attn&&proj&&gate&&up&&act&&down;
+        }
+    };
+
+    bool EnsureSpecBatchArena(uint32_t hidden,uint32_t kvWidth,
+                              uint32_t intermediate,uint32_t batch);
+    SpecBatchArena& SpecArena() noexcept { return specArena_; }
+    void ResetSpecBatchArena();
+
+    bool UploadSpecHidden(const float* src,uint32_t hidden,uint32_t batch);
+    bool DownloadSpecHidden(float* dst,uint32_t hidden,uint32_t batch);
@@
 private:
+    SpecBatchArena specArena_{};

diff --git a/~dev/rawrxd/src/deep2/vulkan_compute.cpp b/~dev/rawrxd/src/deep2/vulkan_compute.cpp
--- a/~dev/rawrxd/src/deep2/vulkan_compute.cpp
+++ b/~dev/rawrxd/src/deep2/vulkan_compute.cpp
@@
+void VulkanCompute::ResetSpecBatchArena() {
+    destroyBuffer(specArena_.hidden); destroyBuffer(specArena_.norm);
+    destroyBuffer(specArena_.q);      destroyBuffer(specArena_.k);
+    destroyBuffer(specArena_.v);      destroyBuffer(specArena_.attn);
+    destroyBuffer(specArena_.proj);   destroyBuffer(specArena_.gate);
+    destroyBuffer(specArena_.up);     destroyBuffer(specArena_.act);
+    destroyBuffer(specArena_.down);   destroyBuffer(specArena_.tmp);
+    specArena_={};
+}
+
+bool VulkanCompute::EnsureSpecBatchArena(
+    uint32_t hidden,uint32_t kvWidth,uint32_t intermediate,uint32_t batch)
+{
+    if(!hidden||!kvWidth||!intermediate||!batch||batch>4) return false;
+    if(specArena_.valid()&&specArena_.hiddenWidth>=hidden&&
+       specArena_.kvWidth>=kvWidth&&specArena_.intermediate>=intermediate&&
+       specArena_.batchCapacity>=batch)
+        return true;
+
+    ResetSpecBatchArena();
+    auto mk=[&](DeviceBuf& b,uint64_t floats)->bool {
+        if(!floats||floats>SIZE_MAX/sizeof(float)) return false;
+        return createBuffer(
+            (size_t)floats*sizeof(float),
+            VK_BUFFER_USAGE_STORAGE_BUFFER_BIT|
+            VK_BUFFER_USAGE_TRANSFER_SRC_BIT|
+            VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+            VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,b);
+    };
+    const uint64_t B=batch;
+    if(!mk(specArena_.hidden,B*hidden) ||
+       !mk(specArena_.norm,B*hidden)   ||
+       !mk(specArena_.q,B*hidden)      ||
+       !mk(specArena_.k,B*kvWidth)     ||
+       !mk(specArena_.v,B*kvWidth)     ||
+       !mk(specArena_.attn,B*hidden)   ||
+       !mk(specArena_.proj,B*hidden)   ||
+       !mk(specArena_.gate,B*intermediate) ||
+       !mk(specArena_.up,B*intermediate)   ||
+       !mk(specArena_.act,B*intermediate)  ||
+       !mk(specArena_.down,B*hidden)   ||
+       !mk(specArena_.tmp,B*std::max(hidden,intermediate))) {
+        ResetSpecBatchArena();
+        return false;
+    }
+    specArena_.hiddenWidth=hidden;
+    specArena_.kvWidth=kvWidth;
+    specArena_.intermediate=intermediate;
+    specArena_.batchCapacity=batch;
+    return true;
+}
+
+bool VulkanCompute::UploadSpecHidden(
+    const float* src,uint32_t hidden,uint32_t batch)
+{
+    if(!src||!EnsureSpecBatchArena(
+            hidden,specArena_.kvWidth?specArena_.kvWidth:hidden,
+            specArena_.intermediate?specArena_.intermediate:hidden*4,batch))
+        return false;
+    return uploadToBuffer(
+        specArena_.hidden,src,(size_t)hidden*batch*sizeof(float));
+}
+
+bool VulkanCompute::DownloadSpecHidden(
+    float* dst,uint32_t hidden,uint32_t batch)
+{
+    if(!dst||!specArena_.hidden||
+       hidden>specArena_.hiddenWidth||batch>specArena_.batchCapacity)
+        return false;
+    return downloadFromBuffer(
+        specArena_.hidden,dst,(size_t)hidden*batch*sizeof(float));
+}
@@
 void VulkanCompute::cleanup() {
     if (device_) vkDeviceWaitIdle(device_);
+    ResetSpecBatchArena();
