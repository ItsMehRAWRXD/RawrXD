OPTION CASEMAP:NONE

RAWR_MAGIC EQU 52574152h
RAWR_VERSION EQU 1
RAWR_MAX_PAYLOAD EQU 16777216
RAWR_TILE EQU 64

R_OK EQU 0
R_ERR EQU -1
R_BOUNDS EQU -2
R_AUTH EQU -3
R_STATE EQU -4
R_IO EQU -5

S_DISCONNECTED EQU 0
S_CONNECTED EQU 1
S_PAIRING EQU 2
S_AUTHENTICATED EQU 3
S_VIEW_ONLY EQU 4
S_CONTROL EQU 5

MSG_HELLO EQU 1
MSG_CHALLENGE EQU 2
MSG_AUTH_PROOF EQU 3
MSG_AUTH_RESULT EQU 4
MSG_FRAME_BEGIN EQU 10h
MSG_TILE EQU 11h
MSG_FRAME_END EQU 12h
MSG_CURSOR EQU 20h
MSG_DISPLAY EQU 21h
MSG_MOUSE EQU 30h
MSG_KEYBOARD EQU 31h
MSG_PING EQU 40h
MSG_PONG EQU 41h
MSG_CLOSE EQU 0FFh

REMOTE_HEADER STRUCT
 magic DWORD ?
 version WORD ?
 type WORD ?
 flags DWORD ?
 sequence QWORD ?
 payloadSize DWORD ?
 reserved DWORD ?
REMOTE_HEADER ENDS

REMOTE_BUFFER STRUCT
 ptr QWORD ?
 size QWORD ?
 capacity QWORD ?
REMOTE_BUFFER ENDS

REMOTE_CAPTURE STRUCT
 screenDC QWORD ?
 memoryDC QWORD ?
 bitmap QWORD ?
 oldBitmap QWORD ?
 pixels QWORD ?
 previous QWORD ?
 bytes QWORD ?
 width DWORD ?
 height DWORD ?
 stride DWORD ?
 initialized DWORD ?
REMOTE_CAPTURE ENDS

REMOTE_SESSION STRUCT
 state DWORD ?
 authenticated DWORD ?
 controlAllowed DWORD ?
 reserved DWORD ?
 txSequence QWORD ?
 rxSequence QWORD ?
 sessionKey BYTE 32 DUP(?)
 challenge BYTE 32 DUP(?)
REMOTE_SESSION ENDS

REMOTE_VIEWER STRUCT
 pixels QWORD ?
 bytes QWORD ?
 width DWORD ?
 height DWORD ?
 stride DWORD ?
 initialized DWORD ?
REMOTE_VIEWER ENDS

REMOTE_TILE_HEADER STRUCT
 x DWORD ?
 y DWORD ?
 width DWORD ?
 height DWORD ?
 encoding DWORD ?
 dataSize DWORD ?
REMOTE_TILE_HEADER ENDS

REMOTE_CURSOR STRUCT
 x SDWORD ?
 y SDWORD ?
 visible DWORD ?
 reserved DWORD ?
REMOTE_CURSOR ENDS

AUTH_INFO STRUCT
 cbSize DWORD ?
 dwInfoVersion DWORD ?
 pbNonce QWORD ?
 cbNonce DWORD ?
 pad0 DWORD ?
 pbAuthData QWORD ?
 cbAuthData DWORD ?
 pad1 DWORD ?
 pbTag QWORD ?
 cbTag DWORD ?
 pad2 DWORD ?
 pbMacContext QWORD ?
 cbMacContext DWORD ?
 cbAAD DWORD ?
 cbData QWORD ?
 dwFlags DWORD ?
 pad3 DWORD ?
AUTH_INFO ENDS
