# Model-free, dependency-free offline extension CLI from the repository root.
get_filename_component(_RAWR_OFFLINE_REPO_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(_RAWR_OFFLINE_CLI "${_RAWR_OFFLINE_REPO_ROOT}/tools/rawrxd_extensions_cli.cpp")
if(EXISTS "${_RAWR_OFFLINE_CLI}" AND NOT TARGET RawrXD-ExtensionsCLI)
    add_executable(RawrXD-ExtensionsCLI "${_RAWR_OFFLINE_CLI}")
    target_compile_features(RawrXD-ExtensionsCLI PRIVATE cxx_std_17)
    if(MSVC)
        target_compile_options(RawrXD-ExtensionsCLI PRIVATE /W4 /WX /EHsc)
    else()
        target_compile_options(RawrXD-ExtensionsCLI PRIVATE -Wall -Wextra -Wpedantic -Werror)
    endif()
    set_target_properties(RawrXD-ExtensionsCLI PROPERTIES OUTPUT_NAME "rawrxd-extensions")
    install(TARGETS RawrXD-ExtensionsCLI RUNTIME DESTINATION bin)
endif()
