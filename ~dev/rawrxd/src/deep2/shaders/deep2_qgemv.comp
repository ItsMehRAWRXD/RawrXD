#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
// Batch 9 packed GGUF GEMV.
// Supported: F16(1), Q4_0(2), Q5_0(6), Q8_0(8), Q2_K(10), Q3_K(11),
// Q4_K(12), Q5_K(13), Q6_K(14), BF16(30).
//
// 40TPS_BATCH2:
//   one workgroup = one output row
//   256 lanes cooperatively consume input columns
//   shared-memory tree reduction emits exactly one row result
layout(local_size_x = 256) in;

layout(set=0,binding=0,std430) readonly buffer W0 { uint w[]; };
layout(set=0,binding=1,std430) readonly buffer X0 { float x[]; };
layout(set=0,binding=2,std430) writeonly buffer Y0 { float y[]; };

layout(push_constant) uniform Push {
    uint type;
    uint rows;
    uint cols;
    uint weightBytes;
} pc;

// AMD target: 256-lane workgroup => at most 8 wave32 subgroups.
shared float subgroupSums[8];

uint getb(uint byteIndex) {
    uint word = w[byteIndex >> 2u];
    return (word >> ((byteIndex & 3u) * 8u)) & 255u;
}
int gets8(uint byteIndex) {
    int v = int(getb(byteIndex));
    return v >= 128 ? v - 256 : v;
}
float geth(uint byteIndex) {
    uint h = getb(byteIndex) | (getb(byteIndex + 1u) << 8u);
    return unpackHalf2x16(h).x;
}

void q4kScaleMin(uint base, uint sb, out uint sc, out uint mn) {
    if (sb < 4u) {
        sc = getb(base + 4u + sb) & 63u;
        mn = getb(base + 8u + sb) & 63u;
    } else {
        uint j = sb - 4u;
        sc = (getb(base + 12u + j) & 15u) |
             ((getb(base + 4u + j) >> 6u) << 4u);
        mn = (getb(base + 12u + j) >> 4u) |
             ((getb(base + 8u + j) >> 6u) << 4u);
    }
}

// DEEP2_GPU_COVERAGE_AUTHORITY: Q4_0 (ggml type 2).
// block_q4_0: d(fp16, 2 bytes) + 16 packed int8 nibble values = 18 bytes, 32 columns.
// weight = d * float(nibble - 8); column i reads the low nibble of qs[i/2]
// when i is even and the high nibble when i is odd (ggml q4_0 layout).
float q4_0_weight(uint rowBase, uint col) {
    uint block = col / 32u;
    uint i = col % 32u;
    uint b = rowBase + block * 18u;
    float d = geth(b);
    uint packed = getb(b + 2u + (i / 2u));
    uint nib = ((i & 1u) == 0u) ? (packed & 15u) : (packed >> 4u);
    return d * float(int(nib) - 8);
}

float f16_weight(uint rowBase, uint col) {
    return geth(rowBase + col * 2u);
}

float bf16_weight(uint rowBase, uint col) {
    uint bits = getb(rowBase + col * 2u) |
                (getb(rowBase + col * 2u + 1u) << 8u);
    return uintBitsToFloat(bits << 16u);
}

float q8_0_weight(uint rowBase, uint col) {
    uint block = col / 32u;
    uint i = col % 32u;
    uint b = rowBase + block * 34u;
    return geth(b) * float(gets8(b + 2u + i));
}

// block_q5_0: d(fp16), qh[4] high bits, qs[16] low nibbles, 32 columns.
// The high bit is stored one bit per element in qh, and the signed value is
// the five-bit code centered at 16.
float q5_0_weight(uint rowBase, uint col) {
    uint block = col / 32u;
    uint i = col % 32u;
    uint b = rowBase + block * 22u;
    float d = geth(b);
    uint lowByte = getb(b + 6u + (i / 2u));
    uint low = ((i & 1u) == 0u) ? (lowByte & 15u) : (lowByte >> 4u);
    uint high = (getb(b + 2u + (i / 8u)) >> (i % 8u)) & 1u;
    return d * float(int(low | (high << 4u)) - 16);
}

float q2k_weight(uint rowBase, uint col) {
    uint block = col / 256u;
    uint idx = col % 256u;
    uint b = rowBase + block * 84u;
    // GGML block_q2_K stores scales[16] at 0, qs[64] at 16,
    // followed by d at 80 and dmin at 82.
    float ds = geth(b + 80u);
    float dm = geth(b + 82u);

    uint chunk = idx / 128u;
    uint rem = idx % 128u;
    uint subBlock = rem / 32u;
    uint group = (rem % 32u) / 16u;
    uint pos = rem % 16u;

    uint scaleIdx = chunk * 8u + subBlock * 2u + group;
    uint packedScale = getb(b + scaleIdx);
    float dl = ds * float(packedScale & 15u);
    float ml = dm * float(packedScale >> 4u);

    uint qsIdx = chunk * 32u + group * 16u + pos;
    uint shift = subBlock * 2u;
    uint q = (getb(b + 16u + qsIdx) >> shift) & 3u;
    return dl * float(q) - ml;
}

// GGML block_q3_K: hmask[32], qs[64], scales[12], d(fp16).
// The scale/high-bit ordering follows ggml dequantize_row_q3_K exactly.
float q3k_weight(uint rowBase, uint col) {
    uint block = col / 256u;
    uint idx = col % 256u;
    uint b = rowBase + block * 110u;
    float d = geth(b + 108u);

    // GGML block_q3_K: hmask[32], qs[64], scales[12], d.
    // Reconstruct the sixteen signed scales exactly as the reference loader.
    uint a0 = getb(b + 96u) | (getb(b + 97u) << 8u) |
              (getb(b + 98u) << 16u) | (getb(b + 99u) << 24u);
    uint a1 = getb(b + 100u) | (getb(b + 101u) << 8u) |
              (getb(b + 102u) << 16u) | (getb(b + 103u) << 24u);
    uint t = getb(b + 104u) | (getb(b + 105u) << 8u) |
             (getb(b + 106u) << 16u) | (getb(b + 107u) << 24u);
    uint s0 = (a0 & 0x0F0F0F0Fu) | (((t >> 0u) & 0x03030303u) << 4u);
    uint s1 = (a1 & 0x0F0F0F0Fu) | (((t >> 2u) & 0x03030303u) << 4u);
    uint s2 = ((a0 >> 4u) & 0x0F0F0F0Fu) | (((t >> 4u) & 0x03030303u) << 4u);
    uint s3 = ((a1 >> 4u) & 0x0F0F0F0Fu) | (((t >> 6u) & 0x03030303u) << 4u);
    uint scaleIndex = idx / 16u;
    uint sw = scaleIndex < 4u ? s0 : (scaleIndex < 8u ? s1 : (scaleIndex < 12u ? s2 : s3));
    uint n128 = (idx / 128u) * 128u;
    uint rem = idx % 128u;
    uint j = rem / 32u;
    uint l = rem % 32u;
    uint scaleIndexExact = (n128 / 128u) * 8u + j * 2u + (l >= 16u ? 1u : 0u);
    uint swExact = scaleIndexExact < 4u ? s0 : (scaleIndexExact < 8u ? s1 : (scaleIndexExact < 12u ? s2 : s3));
    int exactScale = int((swExact >> ((scaleIndexExact & 3u) * 8u)) & 255u);
    if (exactScale >= 128) exactScale -= 256;
    uint q = getb(b + 32u + (n128 / 128u) * 32u + l);
    uint low = (q >> (j * 2u)) & 3u;
    uint high = (getb(b + l) >> j) & 1u;
    return d * float(exactScale) * float(int(low) - (high == 0u ? 4 : 0));
}

float q4k_weight(uint rowBase, uint col) {
    uint block = col / 256u;
    uint idx = col % 256u;
    uint b = rowBase + block * 144u;
    float ds = geth(b + 0u);
    float dm = geth(b + 2u);

    uint sb = idx / 32u;
    uint l = idx % 32u;
    uint sc, mn;
    q4kScaleMin(b, sb, sc, mn);

    uint pair = sb / 2u;
    uint packed = getb(b + 16u + pair * 32u + l);
    uint q = (sb & 1u) == 0u ? (packed & 15u) : (packed >> 4u);
    return ds * float(sc) * float(q) - dm * float(mn);
}

// GGML block_q5_K: d/dmin at 0/2, scales at 4, qh[32] at 16,
// qs[128] at 48, 256 columns per 176-byte block.
float q5k_weight(uint rowBase, uint col) {
    uint block = col / 256u;
    uint idx = col % 256u;
    uint b = rowBase + block * 176u;
    float ds = geth(b + 0u);
    float dm = geth(b + 2u);

    uint sb = idx / 32u;
    uint l = idx % 32u;
    uint sc, mn;
    q4kScaleMin(b, sb, sc, mn);

    uint packed = getb(b + 48u + idx / 2u);
    uint low = ((idx & 1u) == 0u) ? (packed & 15u) : (packed >> 4u);
    uint high = (getb(b + 16u + idx / 8u) >> (idx % 8u)) & 1u;
    uint q = low | (high << 4u);
    return ds * float(sc) * float(q) - dm * float(mn);
}

// Four-column Q4_K dot fragment.
// colBase is always a multiple of four. Q4_K block/sub-block boundaries
// are multiples of 32/256, so the 4-byte qs fetch cannot straddle either.
float q4k_dot4(uint rowBase, uint colBase) {
    uint block = colBase / 256u;
    uint idx = colBase % 256u;
    uint b = rowBase + block * 144u;

    float ds = geth(b + 0u);
    float dm = geth(b + 2u);

    uint sb = idx / 32u;
    uint l = idx % 32u;
    uint sc, mn;
    q4kScaleMin(b, sb, sc, mn);

    uint pair = sb / 2u;
    uint qsByte = b + 16u + pair * 32u + l;
    // qsByte is 4-byte aligned for colBase=(lane*4 + k*1024).
    uint packed4 = w[qsByte >> 2u];

    float d = ds * float(sc);
    float m = dm * float(mn);
    float sum = 0.0;

    for (uint k = 0u; k < 4u; ++k) {
        uint col = colBase + k;
        if (col >= pc.cols) break;
        uint packed = (packed4 >> (k * 8u)) & 255u;
        uint q = (sb & 1u) == 0u ? (packed & 15u) : (packed >> 4u);
        sum += (d * float(q) - m) * x[col];
    }
    return sum;
}

float q6k_weight(uint rowBase, uint col) {
    uint block = col / 256u;
    uint idx = col % 256u;
    uint b = rowBase + block * 210u;
    float ds = geth(b + 208u);

    uint hi128 = idx / 128u;
    uint within = idx % 128u;
    uint cat = within / 32u;
    uint l = within % 32u;
    uint is = l / 16u;

    uint qlBase = b + hi128 * 64u;
    uint qhBase = b + 128u + hi128 * 32u;
    uint scBase = b + 192u + hi128 * 8u;

    uint q = 0u;
    uint scIndex = 0u;
    if (cat == 0u) {
        q = (getb(qlBase + l) & 15u) |
            (((getb(qhBase + l) >> 0u) & 3u) << 4u);
        scIndex = is + 0u;
    } else if (cat == 1u) {
        q = (getb(qlBase + l + 32u) & 15u) |
            (((getb(qhBase + l) >> 2u) & 3u) << 4u);
        scIndex = is + 2u;
    } else if (cat == 2u) {
        q = (getb(qlBase + l) >> 4u) |
            (((getb(qhBase + l) >> 4u) & 3u) << 4u);
        scIndex = is + 4u;
    } else {
        q = (getb(qlBase + l + 32u) >> 4u) |
            (((getb(qhBase + l) >> 6u) & 3u) << 4u);
        scIndex = is + 6u;
    }
    int qs = int(q) - 32;
    int scale = gets8(scBase + scIndex);
    return ds * float(scale) * float(qs);
}

void main() {
    uint row = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;
    if (row >= pc.rows) return;

    uint blocksPerRow = 0u;
    uint rowBytes = 0u;
    if (pc.type == 1u || pc.type == 30u) {
        blocksPerRow = 1u;
        rowBytes = pc.cols * 2u;
    } else if (pc.type == 2u) {
        blocksPerRow = (pc.cols + 31u) / 32u;
        rowBytes = blocksPerRow * 18u;
    } else if (pc.type == 6u) {
        blocksPerRow = (pc.cols + 31u) / 32u;
        rowBytes = blocksPerRow * 22u;
    } else if (pc.type == 8u) {
        blocksPerRow = (pc.cols + 31u) / 32u;
        rowBytes = blocksPerRow * 34u;
    } else if (pc.type == 10u) {
        blocksPerRow = (pc.cols + 255u) / 256u;
        rowBytes = blocksPerRow * 84u;
    } else if (pc.type == 11u || pc.type == 12u || pc.type == 13u) {
        blocksPerRow = (pc.cols + 255u) / 256u;
        rowBytes = blocksPerRow * (pc.type == 11u ? 110u : (pc.type == 12u ? 144u : 176u));
    } else if (pc.type == 14u) {
        blocksPerRow = (pc.cols + 255u) / 256u;
        rowBytes = blocksPerRow * 210u;
    } else {
        y[row] = uintBitsToFloat(0x7fc00000u);
        return;
    }

    uint rb = row * rowBytes;
    if (rb + rowBytes > pc.weightBytes) {
        if (lane == 0u) y[row] = uintBitsToFloat(0x7fc00000u);
        return;
    }

    float acc = 0.0;
    if (pc.type == 12u) {
        // 256 lanes * 4 contiguous values = 1024 columns per sweep.
        for (uint j = lane * 4u; j < pc.cols; j += 1024u)
            acc += q4k_dot4(rb, j);
    } else {
        for (uint j = lane; j < pc.cols; j += 256u) {
            float ww = 0.0;
            if (pc.type == 1u) ww = f16_weight(rb, j);
            else if (pc.type == 2u) ww = q4_0_weight(rb, j);
            else if (pc.type == 6u) ww = q5_0_weight(rb, j);
            else if (pc.type == 8u) ww = q8_0_weight(rb, j);
            else if (pc.type == 10u) ww = q2k_weight(rb, j);
            else if (pc.type == 11u) ww = q3k_weight(rb, j);
            else if (pc.type == 13u) ww = q5k_weight(rb, j);
            else if (pc.type == 14u) ww = q6k_weight(rb, j);
            else if (pc.type == 30u) ww = bf16_weight(rb, j);
            acc += ww * x[j];
        }
    }

    // First reduction is entirely register/wave based.
    float wave = subgroupAdd(acc);
    if (subgroupElect())
        subgroupSums[gl_SubgroupID] = wave;
    barrier();

    // The first subgroup reduces one value per subgroup.
    if (gl_SubgroupID == 0u) {
        float v = gl_SubgroupInvocationID < gl_NumSubgroups
            ? subgroupSums[gl_SubgroupInvocationID]
            : 0.0;
        float total = subgroupAdd(v);
        if (subgroupElect())
            y[row] = total;
    }

}

