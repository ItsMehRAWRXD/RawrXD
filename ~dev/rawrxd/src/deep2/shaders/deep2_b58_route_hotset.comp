#version 460
layout(local_size_x=64) in;

// Device-side hot-set membership helper for routed experts.
layout(set=0,binding=0,std430) readonly buffer Hot { uint hotExpert[]; };
layout(set=0,binding=1,std430) readonly buffer Routed { uint routed[]; };
layout(set=0,binding=2,std430) writeonly buffer Hit { uint isHot[]; };

layout(push_constant) uniform PC {
    uint hotCount;
    uint routedCount;
} pc;

void main(){
    uint i=gl_GlobalInvocationID.x;
    if(i>=pc.routedCount)return;
    uint e=routed[i];
    uint hit=0u;
    for(uint h=0u;h<pc.hotCount;++h)
        if(hotExpert[h]==e){hit=1u;break;}
    isHot[i]=hit;
}
