{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@rawrxd/security-ipc": [
        "../security-ipc/src/index.ts"
      ]
    },
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist"
  },
  "include": [
    "src",
    "tests",
    "../security-ipc/src/node-shims.d.ts"
  ]
}
