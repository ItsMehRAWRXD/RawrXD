{
  "tool": "gcc-compiler",
  "identity": "org.gnu.gcc",
  "executable": "gcc.exe",
  "runtime_limits": {
    "network_access": false,
    "max_memory_mb": 512,
    "max_cpu_percent": 80,
    "max_execution_seconds": 300,
    "allow_child_processes": false
  },
  "capability_allowlist": {
    "fs": ["read:./src/**", "write:./build/**", "read:./include/**"],
    "ipc": ["propose_patch", "request_symbol_map"],
    "env": ["INCLUDE", "LIB", "LIBPATH", "MINGW_PREFIX"]
  },
  "manifest_version": "1.0.0"
}
