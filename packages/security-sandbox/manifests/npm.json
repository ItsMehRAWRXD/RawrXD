{
  "tool": "npm-package-manager",
  "identity": "com.npmjs.npm",
  "executable": "npm.cmd",
  "runtime_limits": {
    "network_access": true,
    "max_memory_mb": 1024,
    "max_cpu_percent": 60,
    "max_execution_seconds": 600,
    "allow_child_processes": true
  },
  "capability_allowlist": {
    "fs": ["read:./package.json", "write:./node_modules/**", "write:./package-lock.json"],
    "ipc": ["request_auth"],
    "env": ["NODE_OPTIONS", "NPM_CONFIG_REGISTRY"]
  },
  "manifest_version": "1.0.0"
}
