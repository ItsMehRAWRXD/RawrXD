# RawrXD Cloud Hosting - Environment Configuration
# Copy to .env and fill in real values before deploying

# Database
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Application
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
API_KEY=CHANGE_ME_TO_A_RANDOM_API_KEY
NODE_ENV=production
PORT=3000
CORS_ORIGIN=*

# Redis
REDIS_MAXMEMORY=256mb

# TLS (paths inside nginx container)
SSL_CERT_PATH=/etc/nginx/ssl/server.crt
SSL_KEY_PATH=/etc/nginx/ssl/server.key
