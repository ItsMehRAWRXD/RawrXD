[submodule "remove-refusals-with-transformers"]
    path = remove-refusals-with-transformers
    url = https://github.com/ItsMehRAWRXD/remove-refusals-with-transformers.git

# Legacy evidence gitlinks are retained in-tree for provenance, but are not
# independently maintained submodules. CI checks out with submodules disabled;
# this inert local URL satisfies Git's credential-cleanup traversal without
# fetching or initializing either evidence directory.
[submodule "ci-orphaned-evidence"]
    path = evidence/TOP25_CLI_GUI_CONTINUE_20261112_030620/ws_git
    url = file:///dev/null

[submodule "ci-orphaned-irc"]
    path = evidence/_irc_orphan_git
    url = file:///dev/null
