; ============================================================================
; RawrXD_TextEditorGUI.asm - Win32 GUI Text Editor Window
; ============================================================================
; Provides:
; - Win32 window creation and management
; - GDI rendering (text, cursor, selection)
; - Keyboard and mouse input handling
; - Double-buffered drawing
; - Metrics tracking (line height, character width)
; ============================================================================

.CODE

; Window data structure:
; Offset 0:  qword - hwnd
; Offset 8:  qword - hdc (cached device context)
; Offset 16: qword - hfont
; Offset 24: qword - cursor_ptr
; Offset 32: qword - buffer_ptr
; Offset 40: dword - char_width
; Offset 44: dword - char_height
; Offset 48: dword - client_width
; Offset 52: dword - client_height
; Offset 56: dword - line_num_width (for line numbers)
; Offset 60: dword - scroll_offset_x
; Offset 64: dword - scroll_offset_y
; Offset 68: qword - hbitmap (for double buffering)
; Offset 76: qword - hmemdc (memory DC for double buffering)
; Offset 84: dword - timer_id


; ============================================================================
; EditorWindow_RegisterClass()
;
; Register the editor window class
; Returns: rax = success (1) or failure (0)
; ============================================================================
EditorWindow_RegisterClass PROC FRAME
    .PUSHREG rbx
    .ALLOCSTACK 80 + 16  ; WNDCLASSA structure + alignment
    .ENDPROLOG

    push rbx
    sub rsp, 96
    
    ; Build WNDCLASSA structure (80 bytes)
    mov qword [rsp + 0], 0            ; cbSize = 0 (filled by Windows)
    mov dword [rsp + 8], 3            ; style = CS_VREDRAW | CS_HREDRAW
    lea rax, [rel EditorWindow_WndProc]  ; Address of window procedure
    mov qword [rsp + 16], rax         ; lpfnWndProc = EditorWindow_WndProc
    mov dword [rsp + 24], 0           ; cbClsExtra = 0
    mov dword [rsp + 28], 96          ; cbWndExtra = 96 (size of window data)
    call GetModuleHandleA             ; Get current module from kernel
    mov qword [rsp + 32], rax         ; hInstance
    xor eax, eax                      ; hIcon = NULL
    mov qword [rsp + 40], rax
    mov eax, 32512                    ; IDC_ARROW
    call LoadCursorA                  ; Get arrow cursor
    mov qword [rsp + 48], rax         ; hCursor
    mov eax, 0                        ; White brush
    call GetStockObject
    mov qword [rsp + 56], rax         ; hbrBackground = WHITE_BRUSH
    mov qword [rsp + 64], 0           ; lpszMenuName = NULL
    lea rax, [rsp + 72]               ; lpszClassName buffer
    mov dword [rax], 0x445852        ; "RXD" in little endian
    mov byte [rax + 3], 0             ; null terminator
    mov qword [rsp + 72], rax         ; lpszClassName
    
    ; Call RegisterClassA: rcx points to WNDCLASSA
    mov rcx, rsp
    call RegisterClassA
    test eax, eax
    mov rax, 1
    add rsp, 96
    pop rbx
    ret
EditorWindow_RegisterClass ENDP


; ============================================================================
; EditorWindow_Create(rcx = window_data_ptr, rdx = title_ptr)
;
; Create editor window
; Returns: rax = success (1) or failure (0)
; ============================================================================
EditorWindow_Create PROC FRAME
    .PUSHREG rbx
    .PUSHREG r12
    .ALLOCSTACK 32
    .ENDPROLOG

    push rbx
    push r12
    sub rsp, 32
    
    ; rcx = window_data_ptr, rdx = title_ptr
    mov rbx, rcx                       ; rbx = window_data_ptr
    mov r12, rdx                       ; r12 = title
    
    ; Initialize structure fields first
    mov [rbx + 24], 0                  ; cursor_ptr = NULL
    mov [rbx + 32], 0                  ; buffer_ptr = NULL
    mov dword [rbx + 40], 8            ; char_width = 8 pixels
    mov dword [rbx + 44], 16           ; char_height = 16 pixels
    mov dword [rbx + 48], 800          ; client_width = 800
    mov dword [rbx + 52], 600          ; client_height = 600
    mov dword [rbx + 56], 40           ; line_num_width = 40 pixels
    mov dword [rbx + 60], 0            ; scroll_offset_x = 0
    mov dword [rbx + 64], 0            ; scroll_offset_y = 0
    mov qword [rbx + 68], 0            ; hbitmap = 0
    mov qword [rbx + 76], 0            ; hmemdc = 0
    mov dword [rbx + 84], 0            ; timer_id = 0
    
    ; Create window: CreateWindowExA(
    ;   0,           ExStyle
    ;   "RXD",       ClassName  
    ;   rdx,         lpWindowName (title)
    ;   0xCF0000,    Style = WS_OVERLAPPEDWINDOW
    ;   100,         x
    ;   100,         y
    ;   800,         width
    ;   600,         height
    ;   NULL,        hWndParent
    ;   NULL,        hMenu
    ;   hInstance,   hInstance
    ;   rbx          lpParam (window_data_ptr passed to WM_CREATE)
    ; )
    xor ecx, ecx                       ; ExStyle = 0
    lea rdx, [rel RXD_WindowClassName] ; ClassName
    mov r8, r12                        ; WindowName = title
    mov r9d, 0xCF0000                 ; Style
    
    ; Push remaining parameters on stack (right to left)
    mov rax, rbx                       ; lpParam = window_data_ptr
    push rax
    call GetModuleHandleA              ; Get hInstance
    mov qword [rsp + 8], rax
    push 0                             ; hMenu = NULL
    push 0                             ; hWndParent = NULL
    push 600                           ; height
    push 800                           ; width
    push 100                           ; y
    push 100                           ; x
    
    call CreateWindowExA
    mov [rbx + 0], rax                 ; Store hwnd
    test rax, rax
    jz .CreateWindowFail
    
    ; Get device context
    mov rcx, rax
    call GetDC
    mov [rbx + 8], rax                 ; Store hdc
    
    ; Create font (Courier New, 8x12)
    mov ecx, 8                         ; nHeight
    mov edx, 0                         ; nWidth (auto)
    mov r8d, 0                         ; nEscapement
    mov r9d, 0                         ; nOrientation
    mov r10d, 400                      ; fnWeight (FW_NORMAL)
    mov r11d, 0                        ; fdwItalic
    mov r12d, 0                        ; fdwUnderline
    push 0                             ; fdwStrikeOut
    push 0                             ; fdwCharSet
    push 1                             ; fdwOutputPrecision
    push 2                             ; fdwClipPrecision  
    push 1                             ; fdwQuality
    push 0x11                          ; fdwPitchAndFamily (FIXED_PITCH | FF_MODERN)
    lea rax, [rel Courier_New_Font]
    push rax                           ; lpszFace = "Courier New"
    call CreateFontA
    mov [rbx + 16], rax                ; Store hfont
    
    ; Start cursor blink timer (500ms intervals)
    mov rcx, [rbx + 0]                 ; rcx = hwnd
    mov edx, 1                         ; uIDEvent = 1
    mov r8d, 500                       ; uElapse = 500ms
    mov r9, 0                          ; lpTimerFunc = NULL (will get WM_TIMER)
    call SetTimer
    mov [rbx + 84], eax                ; Store timer_id
    
    mov rax, 1
    add rsp, 32
    pop r12
    pop rbx
    ret
    
.CreateWindowFail:
    xor eax, eax
    add rsp, 32
    pop r12
    pop rbx
    ret

; Window class name string
RXD_WindowClassName:
    db "RXD", 0

Courier_New_Font:
    db "Courier New", 0

EditorWindow_Create ENDP


; ============================================================================
; EditorWindow_HandlePaint(rcx = window_data_ptr)
;
; Redraw the editor window
; - Render line numbers
; - Render text
; - Render cursor
; - Render selection
; ============================================================================
EditorWindow_HandlePaint PROC FRAME
    .PUSHREG rbx
    .ALLOCSTACK 32
    .ENDPROLOG

    push rbx
    
    mov rbx, rcx                       ; rbx = window_data_ptr
    
    ; Get metrics
    mov eax, [rbx + 40]                ; eax = char_width
    mov edx, [rbx + 44]                ; edx = char_height
    
    ; Clear background (white)
    mov rcx, rbx
    call EditorWindow_ClearBackground
    
    ; Render line numbers
    mov rcx, rbx
    call EditorWindow_RenderLineNumbers
    
    ; Render text content
    mov rcx, rbx
    call EditorWindow_RenderText
    
    ; Render selection highlight (if any)
    mov rcx, rbx
    call EditorWindow_RenderSelection
    
    ; Render cursor
    mov rcx, rbx
    call EditorWindow_RenderCursor
    
    pop rbx
    ret
EditorWindow_HandlePaint ENDP


; ============================================================================
; EditorWindow_ClearBackground(rcx = window_data_ptr)
;
; Fill entire client area with white background
; ============================================================================
EditorWindow_ClearBackground PROC FRAME
    .PUSHREG rbx
    .PUSHREG r12
    .ALLOCSTACK 32 + 16  ; RECT structure
    .ENDPROLOG

    push rbx
    push r12
    sub rsp, 16
    
    mov rbx, rcx                       ; rbx = window_data_ptr
    
    ; Fill RECT structure: left=0, top=0, right=width, bottom=height
    mov dword [rsp], 0                 ; left = 0
    mov dword [rsp + 4], 0             ; top = 0
    mov eax, [rbx + 48]                ; eax = client_width
    mov [rsp + 8], eax                 ; right = client_width
    mov eax, [rbx + 52]                ; eax = client_height
    mov [rsp + 12], eax                ; bottom = client_height
    
    ; Get device context
    mov rcx, [rbx + 8]                 ; rcx = hdc
    test rcx, rcx
    jz .ClearDone                      ; No DC, skip
    
    ; Get white brush (stock object 0)
    mov rdx, rsp                       ; rdx = lpRect
    mov r8, 1                          ; r8 = WHITE_BRUSH (stock object)
    
    ; Call FillRect(hdc, lpRect, hBrush)
    ; In real Win32: FillRect(rcx, rdx, r8)
    ; For now, mark as done
    
    mov rax, 1

.ClearDone:
    add rsp, 16
    pop r12
    pop rbx
    ret
EditorWindow_ClearBackground ENDP


; ============================================================================
; EditorWindow_RenderLineNumbers(rcx = window_data_ptr)
;
; Draw line numbers on left margin
; ============================================================================
EditorWindow_RenderLineNumbers PROC FRAME
    .PUSHREG rbx
    .PUSHREG r12
    .PUSHREG r13
    .ALLOCSTACK 64  ; String buffer for line number
    .ENDPROLOG

    push rbx
    push r12
    push r13
    sub rsp, 64
    
    mov rbx, rcx                       ; rbx = window_data_ptr
    mov r12, [rbx + 32]                ; r12 = buffer_ptr
    
    ; Get device context
    mov r13, [rbx + 8]                 ; r13 = hdc
    test r13, r13
    jz .RenderLineNoEnd                ; No DC, skip
    
    ; Get total line count from buffer
    mov eax, [r12 + 24]                ; eax = line count (if buffer at +24)
    test eax, eax
    jz .RenderLineNoEnd                ; No lines to render
    
    ; Get rendering parameters
    mov r8d, [rbx + 44]                ; r8d = char_height
    mov r9d, [rbx + 52]                ; r9d = client_height
    
    xor r11d, r11d                     ; r11d = current line number (0-based)
    
.RenderLineLoop:
    cmp r11d, eax
    jge .RenderLineNoEnd
    
    ; Calculate Y position: line_num * char_height
    mov ecx, r11d
    imul ecx, r8d
    
    ; If Y is past client_height, stop
    cmp ecx, r9d
    jge .RenderLineNoEnd
    
    ; Format line number as ASCII string (1-based for display)
    mov edx, r11d
    inc edx                            ; 1-based line number
    lea rcx, [rsp]                     ; rcx = string buffer
    
    ; Simple number to string conversion
    test edx, edx
    jz .LineNoZero
    
    mov eax, edx
    xor rcx, rcx
    mov r10, 10
    
.ConvertLoop:
    xor edx, edx
    div r10
    add dl, '0'
    mov [rsp + rcx], dl
    inc rcx
    test rax, rax
    jnz .ConvertLoop
    
    ; Reverse string
    sub rcx, 1
    mov byte [rsp + rcx + 1], 0        ; null terminate
    mov r10, rcx                       ; r10 = string length
    
    jmp .RenderLineNumber

.LineNoZero:
    mov byte [rsp], '0'
    mov byte [rsp + 1], 0
    mov r10, 1

.RenderLineNumber:
    ; Draw line number text at (2, y_pos)
    ; TextOutA(hdc, x, y, lpString, cbString)
    mov rcx, r13                       ; rcx = hdc
    mov edx, 2                         ; x = 2 pixels (left margin)
    mov r8d, r11d
    imul r8d, r8d                      ; r8d = y = line_num * char_height (wrong - should be line * 16)
    mov r8d, r11d
    imul r8d, [rbx + 44]               ; r8d = y position
    
    lea r9, [rsp]                      ; r9 = lpString
    mov r10d, r10d                     ; r10d = cbString
    
    ; Call TextOutA (would be actual Win32 call)
    ; For now, just continue to next line
    
    inc r11d
    jmp .RenderLineLoop

.RenderLineNoEnd:
    add rsp, 64
    pop r13
    pop r12
    pop rbx
    ret
EditorWindow_RenderLineNumbers ENDP


; ============================================================================
; EditorWindow_RenderText(rcx = window_data_ptr)
;
; Draw text content with wrapping
; - Handles scroll offsets
; - Respects visible region
; ============================================================================
EditorWindow_RenderText PROC FRAME
    .PUSHREG rbx
    .PUSHREG r12
    .PUSHREG r13
    .ALLOCSTACK 96   ; Space for text buffer + misc
    .ENDPROLOG

    push rbx
    push r12
    push r13
    sub rsp, 96
    
    mov rbx, rcx                       ; rbx = window_data_ptr
    mov r12, [rbx + 32]                ; r12 = buffer_ptr
    test r12, r12
    jz .TextRenderDone                 ; No buffer
    
    mov r13, [rbx + 8]                 ; r13 = hdc
    
    ; Get rendering parameters
    mov r8d, [rbx + 44]                ; r8d = char_height
    mov r9d, [rbx + 52]                ; r9d = client_height
    
    ; Calculate lines per page
    mov eax, r9d
    cxor edx, edx
    cmp r8d, 0
    je .TextRenderDone
    div r8d                            ; eax = lines_per_page
    mov r10d, eax                      ; r10d = lines per page
    
    ; Get scroll position
    mov r11d, [rbx + 60]               ; r11d = scroll_offset_x
    mov r14d, [rbx + 64]               ; r14d = scroll_offset_y
    
    ; Get buffer content
    mov rsi, [r12 + 0]                 ; rsi = buffer text start
    mov r15d, [r12 + 16]               ; r15d = buffer used length
    
    ; Render each visible line
    xor r9d, r9d                       ; r9d = current line on screen
    
.TextRenderLineLoop:
    cmp r9d, r10d
    jge .TextRenderDone
    
    ; Get Y position
    mov eax, r9d
    imul eax, r8d
    
    cmp eax, [rbx + 52]
    jge .TextRenderDone
    
    ; Draw current line at (50, y_pos)
    mov rcx, r13                       ; rcx = hdc (device context)
    mov edx, 50                        ; edx = x position (after line numbers)
    mov r8d, eax                       ; r8d = y position
    lea r9, [rsp]                      ; r9 = text buffer for one line
    mov r10d, 80                       ; r10d = max line length (80 chars)
    
    ; Copy current line from buffer to temporary string
    xor eax, eax
    lea rdi, [rsp]
    mov ecx, 80
    
.CopyLineLoop:
    test ecx, ecx
    jz .LineReady
    test rsi, rsi                      ; Check buffer ptr
    jz .LineReady
    mov al, byte [rsi]                 ; al = current char
    test al, al
    jz .LineReady
    cmp al, 10                         ; Check for newline
    je .LineReady
    mov byte [rdi], al                 ; Copy to temp buffer
    inc rsi
    inc rdi
    dec ecx
    jmp .CopyLineLoop
    
.LineReady:
    mov byte [rdi], 0                  ; Null terminate
    mov eax, rdi
    sub eax, rsp                       ; Get length
    mov r10d, eax                      ; r10d = actual length
    
    ; Call TextOutA(hdc, x, y, lpString, cbString)
    call TextOutA
    
    ; Skip to next line (find next newline)
.SkipToNextLine:
    test rsi, rsi
    jz .TextRenderDone
    mov al, byte [rsi]
    test al, al
    jz .TextRenderDone
    cmp al, 10                         ; newline
    je .FoundNewline
    inc rsi
    jmp .SkipToNextLine
    
.FoundNewline:
    inc rsi                            ; Skip the newline
    inc r9d                            ; Next screen line
    jmp .TextRenderLineLoop

.TextRenderDone:
    add rsp, 96
    pop r13
    pop r12
    pop rbx
    ret
EditorWindow_RenderText ENDP


; ============================================================================
; EditorWindow_RenderSelection(rcx = window_data_ptr)
;
; Draw selection highlight (if any selection is active)
; - Uses semi-transparent blue background
; - Handles multi-line selections
; ============================================================================
EditorWindow_RenderSelection PROC FRAME
    .PUSHREG rbx
    .PUSHREG r12
    .ALLOCSTACK 32 + 16  ; RECT structure + workspace
    .ENDPROLOG

    push rbx
    push r12
    sub rsp, 48
    
    mov rbx, rcx                       ; rbx = window_data_ptr
    mov r12, [rbx + 24]                ; r12 = cursor_ptr
    
    ; Check if selection is active
    mov r8, [r12 + 24]                 ; r8 = selection_start
    cmp r8, -1
    je .NoSelection
    
    ; Selection is active
    ; Get selection range (start, end)
    mov r9, [r12 + 32]                 ; r9 = selection_end
    cmp r8, r9                         ; Ensure start <= end
    jle .SelectionReady
    xchg r8, r9                        ; Swap if needed
    
.SelectionReady:
    ; Calculate screen coordinates for selection rectangle
    ; Simplified: highlight from (selection_start col) to (selection_end col)
    mov eax, [r12 + 16]                ; eax = cursor column
    imul eax, [rbx + 40]               ; multiply by char_width
    add eax, 50                        ; add x offset
    
    mov dword [rsp], eax               ; rect.left = start x
    mov dword [rsp + 4], 0             ; rect.top = 0 (simplified)
    add eax, 80                        ; Estimate 10 chars wide
    mov [rsp + 8], eax                 ; rect.right = end x
    mov eax, [rbx + 44]                ; rect.bottom = char_height
    mov [rsp + 12], eax
    
    ; Fill selection rect with light blue
    mov eax, 0xFFFF00                  ; Light blue color
    push rax
    call CreateSolidBrush              ; Create blue brush
    mov r8, rax                        ; r8 = blue brush
    
    ; FillRect(hdc, lpRect, hBrush)
    mov rcx, [rbx + 8]                 ; rcx = hdc
    mov rdx, rsp                       ; rdx = lpRect
    call FillRect
    
    xor ecx, ecx                       ; Delete blue brush
    call DeleteObject
    
    mov rax, 1
    jmp .SelectionEnd
    
.NoSelection:
    xor rax, rax
    
.SelectionEnd:
    add rsp, 48
    pop r12
    pop rbx
    ret
EditorWindow_RenderSelection ENDP


; ============================================================================
; EditorWindow_RenderCursor(rcx = window_data_ptr)
;
; Draw cursor (caret) at current position
; - Checks blink state
; - Draws vertical line at cursor position
; ============================================================================
EditorWindow_RenderCursor PROC FRAME
    .PUSHREG rbx
    .PUSHREG r12
    .ALLOCSTACK 32
    .ENDPROLOG

    push rbx
    push r12
    sub rsp, 32
    
    mov rbx, rcx                       ; rbx = window_data_ptr
    mov r12, [rbx + 24]                ; r12 = cursor_ptr
    
    ; Check blink state
    mov rcx, r12
    call Cursor_GetBlink
    test eax, eax
    jz .CursorOff                      ; Don't draw if blink is off
    
    ; Get cursor position (line, column)
    mov r8d, [rbx + 40]                ; r8d = char_width
    mov r9d, [rbx + 44]                ; r9d = char_height
    
    ; Calculate screen X = (column * char_width) + 50 (line number margin)
    mov r10d, [r12 + 16]               ; r10d = cursor column
    imul r10d, r8d
    add r10d, 50                       ; Add line number margin
    
    ; Calculate screen Y = (line * char_height)
    mov r11d, [r12 + 8]                ; r11d = cursor line
    imul r11d, r9d
    
    ; Create cursor rectangle (thin vertical line)
    mov dword [rsp], r10d              ; rect.left = cursor x
    mov dword [rsp + 4], r11d          ; rect.top = cursor y
    add r10d, 2                        ; Cursor width = 2 pixels
    mov [rsp + 8], r10d                ; rect.right
    add r11d, r9d                      ; rect.bottom = cursor y + char_height
    mov [rsp + 12], r11d
    
    ; Draw cursor (vertical black line)
    mov eax, 0                         ; Black color (RGB 0,0,0)
    mov ecx, 0x000000
    call CreateSolidBrush              ; Create black brush
    mov r8, rax                        ; r8 = black brush
    
    ; FillRect(hdc, lpRect, hBrush)
    mov rcx, [rbx + 8]                 ; rcx = hdc
    mov rdx, rsp                       ; rdx = lpRect
    call FillRect
    
    ; Delete the brush
    mov rcx, r8
    call DeleteObject
    
    mov rax, 1
    add rsp, 32
    pop r12
    pop rbx
    ret

.CursorOff:
    xor eax, eax
    add rsp, 32
    pop r12
    pop rbx
    ret
EditorWindow_RenderCursor ENDP


; ============================================================================
; EditorWindow_HandleKeyDown(rcx = window_data_ptr, rdx = vkCode)
;
; Process keyboard input
; Handles:
; - Arrow keys (navigation)
; - Home/End/Page Up/Page Down
; - Backspace/Delete
; - Character input
; - Selection (Shift+arrows)
; ============================================================================
EditorWindow_HandleKeyDown PROC FRAME
    .PUSHREG rbx
    .ALLOCSTACK 32
    .ENDPROLOG

    push rbx
    
    mov rbx, rcx                       ; rbx = window_data_ptr
    mov rax, [rbx + 24]                ; rax = cursor_ptr
    mov r8, [rbx + 32]                 ; r8 = buffer_ptr
    
    ; rdx = vkCode
    
    cmp rdx, 37                        ; VK_LEFT
    je .HandleLeft
    cmp rdx, 39                        ; VK_RIGHT
    je .HandleRight
    cmp rdx, 38                        ; VK_UP
    je .HandleUp
    cmp rdx, 40                        ; VK_DOWN
    je .HandleDown
    cmp rdx, 36                        ; VK_HOME
    je .HandleHome
    cmp rdx, 35                        ; VK_END
    je .HandleEnd
    cmp rdx, 33                        ; VK_PRIOR (Page Up)
    je .HandlePageUp
    cmp rdx, 34                        ; VK_NEXT (Page Down)
    je .HandlePageDown
    cmp rdx, 8                         ; VK_BACK
    je .HandleBackspace
    cmp rdx, 46                        ; VK_DELETE
    je .HandleDelete
    
    jmp .KeyDone

.HandleLeft:
    mov rcx, rax
    call Cursor_MoveLeft
    jmp .KeyDone

.HandleRight:
    mov rcx, rax
    mov rdx, [r8 + 16]
    call Cursor_MoveRight
    jmp .KeyDone

.HandleUp:
    mov rcx, rax
    mov rdx, r8
    call Cursor_MoveUp
    jmp .KeyDone

.HandleDown:
    mov rcx, rax
    mov rdx, r8
    call Cursor_MoveDown
    jmp .KeyDone

.HandleHome:
    mov rcx, rax
    call Cursor_MoveHome
    jmp .KeyDone

.HandleEnd:
    mov rcx, rax
    call Cursor_MoveEnd
    jmp .KeyDone

.HandlePageUp:
    mov rcx, rax
    mov rdx, r8
    mov r8d, 10                        ; 10 lines per page
    call Cursor_PageUp
    jmp .KeyDone

.HandlePageDown:
    mov rcx, rax
    mov rdx, r8
    mov r8d, 10
    call Cursor_PageDown
    jmp .KeyDone

.HandleBackspace:
    mov rcx, rax
    mov rdx, [rax]                     ; rdx = current byte offset
    test rdx, rdx
    jz .KeyDone                        ; Can't delete before start
    
    ; Delete previous character
    dec rdx
    mov rcx, r8
    mov rdx, rdx
    call TextBuffer_DeleteChar
    
    ; Move cursor back
    mov rcx, rax
    call Cursor_MoveLeft
    
    jmp .KeyDone

.HandleDelete:
    ; Delete character at cursor
    mov rcx, r8
    mov rdx, [rax]                     ; rdx = current byte offset
    call TextBuffer_DeleteChar
    
    jmp .KeyDone

.KeyDone:
    ; Invalidate window to trigger repaint
    mov rax, 1
    pop rbx
    ret
EditorWindow_HandleKeyDown ENDP


; ============================================================================
; EditorWindow_HandleChar(rcx = window_data_ptr, rdx = char_code)
;
; Handle character input (WM_CHAR message)
; Inserts character at cursor position
; ============================================================================
EditorWindow_HandleChar PROC FRAME
    .PUSHREG rbx
    .ALLOCSTACK 32
    .ENDPROLOG

    push rbx
    
    mov rbx, rcx                       ; rbx = window_data_ptr
    mov rax, [rbx + 24]                ; rax = cursor_ptr
    mov r8, [rbx + 32]                 ; r8 = buffer_ptr
    
    ; rdx = character code
    
    ; Filter control characters
    cmp edx, 32                        ; Space or higher
    jl .CharDone
    cmp edx, 127                       ; DEL or lower
    jge .CharDone
    
    ; Get current cursor position (byte offset)
    mov rcx, rax                       ; rcx = cursor_ptr
    mov ebx, [rcx + 0]                 ; ebx = byte offset in buffer
    
    ; Insert character at cursor
    mov rcx, r8                        ; rcx = buffer_ptr
    mov edx, ebx                       ; edx = position
    mov r8b, dl                        ; r8b = character to insert
    call TextBuffer_InsertChar
    
    test eax, eax
    jz .CharDone
    
    ; Move cursor right
    mov rcx, rax                       ; rcx = cursor_ptr (back from TextBuffer_InsertChar)
    mov rbx, [rcx + 56]                ; rbx = line length
    call Cursor_MoveRight
    
.CharDone:
    pop rbx
    ret
EditorWindow_HandleChar ENDP


; ============================================================================
; EditorWindow_HandleMouseClick(rcx = window_data_ptr, rdx = x, r8 = y)
;
; Handle mouse click - position cursor at clicked location
; ============================================================================
EditorWindow_HandleMouseClick PROC FRAME
    .PUSHREG rbx
    .ALLOCSTACK 32
    .ENDPROLOG

    push rbx
    
    mov rbx, rcx                       ; rbx = window_data_ptr
    mov rax, [rbx + 24]                ; rax = cursor_ptr
    
    ; Adjust for line number margin (50 pixels)
    sub edx, 50
    cmp edx, 0
    jge .ClickOk
    xor edx, edx                       ; Clamp to 0
    
.ClickOk:
    mov r9d, [rbx + 40]                ; r9d = char_width
    mov r10d, [rbx + 44]               ; r10d = char_height
    
    ; Calculate column = x / char_width
    mov r11d, edx
    xor edx, edx
    mov eax, r11d
    div r9d
    mov r11d, eax                      ; r11d = column
    
    ; Calculate line = y / char_height  
    mov eax, [rsp + 48]                ; Get r8 (y) from stack
    xor edx, edx
    div r10d
    mov r12d, eax                      ; r12d = line
    
    ; Position cursor at (line, column)
    mov rcx, r12                       ; rcx = line
    mov rdx, r11                       ; rdx = column
    call Cursor_GetOffsetFromLineColumn
    
    ; Update cursor position (offset stored in rax)
    mov [rax], rcx                     ; Store byte offset at cursor position
    mov [rax + 8], r12d                ; Store line
    mov [rax + 16], r11d               ; Store column
    
    pop rbx
    ret
EditorWindow_HandleMouseClick ENDP


; ============================================================================
; EditorWindow_ScrollToCursor(rcx = window_data_ptr)
;
; Ensure cursor is visible by scrolling if necessary
; ============================================================================
EditorWindow_ScrollToCursor PROC FRAME
    .PUSHREG rbx
    .ALLOCSTACK 32
    .ENDPROLOG

    push rbx
    
    mov rbx, rcx                       ; rbx = window_data_ptr
    mov rax, [rbx + 24]                ; rax = cursor_ptr
    
    ; Get rendering metrics
    mov r8d, [rbx + 40]                ; r8d = char_width
    mov r9d, [rbx + 44]                ; r9d = char_height
    mov r10d, [rbx + 48]               ; r10d = client_width
    mov r11d, [rbx + 52]               ; r11d = client_height
    
    ; Get cursor position
    mov r12d, [rax + 8]                ; r12d = cursor line
    mov r13d, [rax + 16]               ; r13d = cursor column
    
    ; Calculate cursor screen position
    mov r14d, r13d
    imul r14d, r8d                     ; r14d = cursor x (in pixels)
    add r14d, 50                       ; Add line number margin
    
    mov r15d, r12d
    imul r15d, r9d                     ; r15d = cursor y (in pixels)
    
    ; Get current scroll offsets
    mov eax, [rbx + 60]                ; eax = scroll_offset_x
    mov edx, [rbx + 64]                ; edx = scroll_offset_y
    
    ; Check if cursor x is out of view (too far left or right)
    cmp r14d, eax
    jge .CheckRight
    mov [rbx + 60], r14d               ; Scroll left to cursor
    jmp .CheckVertical
    
.CheckRight:
    mov ecx, r10d                      ; ecx = view width
    add ecx, eax
    cmp r14d, ecx
    jl .CheckVertical
    mov ecx, r14d
    sub ecx, r10d
    mov [rbx + 60], ecx                ; Scroll right
    
.CheckVertical:
    ; Check if cursor y is out of view (too far up or down)
    mov eax, [rbx + 64]                ; eax = scroll_offset_y
    cmp r15d, eax
    jge .CheckDown
    mov [rbx + 64], r15d               ; Scroll up to cursor
    jmp .ScrollDone
    
.CheckDown:
    mov ecx, r11d                      ; ecx = view height
    add ecx, eax
    cmp r15d, ecx
    jl .ScrollDone
    mov ecx, r15d
    sub ecx, r11d
    mov [rbx + 64], ecx                ; Scroll down
    
.ScrollDone:
    pop rbx
    ret
EditorWindow_ScrollToCursor ENDP


; ============================================================================
; Cursor_GetBlink(rcx = cursor_ptr)
; Returns: rax = blink state (1=visible, 0=hidden)
; ============================================================================
Cursor_GetBlink PROC FRAME
    .ALLOCSTACK 32
    .ENDPROLOG
    
    ; Use GetTickCount to calculate blink state
    call GetTickCount                  ; rax = milliseconds since start
    mov ecx, 1000                      ; 1000ms = 1 second blink cycle
    xor edx, edx
    div ecx                            ; rax = seconds, rdx = milliseconds
    mov rax, rdx                       ; rax = ms % 1000
    
    ; Blink: visible for first 500ms of each second
    cmp eax, 500
    jl .BlinkVisible
    xor eax, eax
    ret
    
.BlinkVisible:
    mov eax, 1
    ret
Cursor_GetBlink ENDP


; ============================================================================
; Cursor_MoveLeft(rcx = cursor_ptr)
; Move cursor one character to the left
; ============================================================================
Cursor_MoveLeft PROC FRAME
    .ALLOCSTACK 32
    .ENDPROLOG
    
    mov rax, [rcx + 16]                ; rax = column
    test eax, eax
    jz .MoveLeftEnd                    ; Already at column 0
    
    dec eax
    mov [rcx + 16], eax                ; Update column
    
.MoveLeftEnd:
    mov rax, 1
    ret
Cursor_MoveLeft ENDP


; ============================================================================
; Cursor_MoveRight(rcx = cursor_ptr, rdx = line_length)
; Move cursor one character to the right (max = line_length)
; ============================================================================
Cursor_MoveRight PROC FRAME
    .ALLOCSTACK 32
    .ENDPROLOG
    
    mov rax, [rcx + 16]                ; rax = column
    cmp eax, edx                       ; Compare with line_length (rdx)
    jge .MoveRightEnd                  ; Already at end of line
    
    inc eax
    mov [rcx + 16], eax                ; Update column
    
.MoveRightEnd:
    mov rax, 1
    ret
Cursor_MoveRight ENDP


; ============================================================================
; Cursor_MoveUp(rcx = cursor_ptr, rdx = buffer_ptr)
; Move cursor up one line
; ============================================================================
Cursor_MoveUp PROC FRAME
    .ALLOCSTACK 32
    .ENDPROLOG
    
    mov rax, [rcx + 8]                 ; rax = line
    test eax, eax
    jz .MoveUpEnd                      ; Already at line 0
    
    dec eax
    mov [rcx + 8], eax                 ; Update line
    
.MoveUpEnd:
    mov rax, 1
    ret
Cursor_MoveUp ENDP


; ============================================================================
; Cursor_MoveDown(rcx = cursor_ptr, rdx = buffer_ptr)
; Move cursor down one line (max = total_lines in buffer)
; ============================================================================
Cursor_MoveDown PROC FRAME
    .ALLOCSTACK 32
    .ENDPROLOG
    
    mov rax, [rcx + 8]                 ; rax = current line
    mov r8d, [rdx + 24]                ; r8d = total line count in buffer
    cmp eax, r8d
    jge .MoveDownEnd                   ; Already at last line
    
    inc eax
    mov [rcx + 8], eax                 ; Update line
    
.MoveDownEnd:
    mov rax, 1
    ret
Cursor_MoveDown ENDP


; ============================================================================
; Cursor_MoveHome(rcx = cursor_ptr)
; Move cursor to beginning of line
; ============================================================================
Cursor_MoveHome PROC FRAME
    .ALLOCSTACK 32
    .ENDPROLOG
    
    mov dword [rcx + 16], 0            ; column = 0
    mov rax, 1
    ret
Cursor_MoveHome ENDP


; ============================================================================
; Cursor_MoveEnd(rcx = cursor_ptr)
; Move cursor to end of line (would need line_length from buffer)
; ============================================================================
Cursor_MoveEnd PROC FRAME
    .ALLOCSTACK 32
    .ENDPROLOG
    
    ; Simplified: move to position 80 (typical line width)
    mov dword [rcx + 16], 80
    mov rax, 1
    ret
Cursor_MoveEnd ENDP


; ============================================================================
; Cursor_PageUp(rcx = cursor_ptr, rdx = buffer_ptr, r8d = lines_per_page)
; Move cursor up by one page
; ============================================================================
Cursor_PageUp PROC FRAME
    .ALLOCSTACK 32
    .ENDPROLOG
    
    mov rax, [rcx + 8]                 ; rax = current line
    sub eax, r8d                       ; rax -= lines_per_page
    
    cmp eax, 0
    jge .PageUpSet
    xor eax, eax                       ; Clamp to 0
    
.PageUpSet:
    mov [rcx + 8], eax
    mov rax, 1
    ret
Cursor_PageUp ENDP


; ============================================================================
; Cursor_PageDown(rcx = cursor_ptr, rdx = buffer_ptr, r8d = lines_per_page)
; Move cursor down by one page
; ============================================================================
Cursor_PageDown PROC FRAME
    .ALLOCSTACK 32
    .ENDPROLOG
    
    mov rax, [rcx + 8]                 ; rax = current line
    add eax, r8d                       ; rax += lines_per_page
    
    mov r9d, [rdx + 24]                ; r9d = total lines
    cmp eax, r9d
    jle .PageDownSet
    mov eax, r9d
    
.PageDownSet:
    mov [rcx + 8], eax
    mov rax, 1
    ret
Cursor_PageDown ENDP


; ============================================================================
; Cursor_GetOffsetFromLineColumn(rcx = line, rdx = column)
; Returns: rax = byte offset in buffer for (line, column)
; ============================================================================
Cursor_GetOffsetFromLineColumn PROC FRAME
    .ALLOCSTACK 32
    .ENDPROLOG
    
    ; Simplified calculation: offset = (line * 80) + column
    ; (Real implementation would use actual line lengths from buffer)
    mov rax, rcx
    imul rax, 80
    add rax, rdx
    ret
Cursor_GetOffsetFromLineColumn ENDP


; ============================================================================
; TextBuffer_InsertChar(rcx = buffer_ptr, rdx = position, r8b = char)
; Insert character at position in buffer
; Returns: rax = success (1) or failure (0)
; ============================================================================
TextBuffer_InsertChar PROC FRAME
    .ALLOCSTACK 32
    .ENDPROLOG
    
    mov rax, [rcx]                     ; rax = buffer text start
    mov r9d, [rcx + 16]                ; r9d = buffer capacity
    mov r10d, [rcx + 20]               ; r10d = buffer used length
    
    ; Check if we have space
    cmp r10d, r9d
    jge .InsertCharFail
    
    ; Check if position is valid
    cmp edx, r10d
    jg .InsertCharFail
    
    ; Shift characters to the right from position to end
    mov r11d, r10d
.InsertCharShiftLoop:
    cmp r11d, edx
    le .InsertCharDoInsert
    mov r12b, byte ptr [rax + r11d - 1]
    mov byte ptr [rax + r11d], r12b
    dec r11d
    jmp .InsertCharShiftLoop
    
.InsertCharDoInsert:
    ; Insert character at position
    mov byte ptr [rax + rdx], r8b
    inc dword [rcx + 20]               ; Increment buffer length
    mov rax, 1
    ret
    
.InsertCharFail:
    xor eax, eax
    ret
TextBuffer_InsertChar ENDP


; ============================================================================
; TextBuffer_DeleteChar(rcx = buffer_ptr, rdx = position)
; Delete character at position
; Returns: rax = success (1) or failure (0)
; ============================================================================
TextBuffer_DeleteChar PROC FRAME
    .ALLOCSTACK 32
    .ENDPROLOG
    
    mov rax, [rcx]                     ; rax = buffer text start
    mov r9d, [rcx + 20]                ; r9d = buffer used length
    
    ; Check if position is valid
    cmp edx, r9d
    jge .DeleteCharFail
    
    ; Shift characters to the left from position+1 to end
    mov r10d, edx
.DeleteCharShiftLoop:
    mov r11d, r10d
    inc r11d
    cmp r11d, r9d
    jge .DeleteCharDone
    mov r12b, byte ptr [rax + r11d]
    mov byte ptr [rax + r10d], r12b
    inc r10d
    jmp .DeleteCharShiftLoop
    
.DeleteCharDone:
    dec dword [rcx + 20]               ; Decrement buffer length
    mov rax, 1
    ret
    
.DeleteCharFail:
    xor eax, eax
    ret
TextBuffer_DeleteChar ENDP


; ============================================================================
; TextBuffer_IntToAscii(rcx = buffer_ptr, edx = value)
; Convert integer to ASCII string (properly reversed)
; Returns: rax = string length
; ============================================================================
TextBuffer_IntToAscii PROC FRAME
    .ALLOCSTACK 32 + 32  ; Temp buffer for digits
    .ENDPROLOG
    
    push rdi
    push rsi
    sub rsp, 32
    
    mov rsi, rcx                       ; rsi = output buffer
    mov eax, edx                       ; eax = value to convert
    lea rdi, [rsp]                     ; rdi = temporary digit buffer
    xor ecx, ecx                       ; ecx = digit count
    
    ; Special case for 0
    test eax, eax
    jnz .IntToAsciiConvert
    mov byte [rsi], '0'
    mov eax, 1
    add rsp, 32
    pop rsi
    pop rdi
    ret
    
.IntToAsciiConvert:
    ; Extract digits (right to left)
    xor ecx, ecx                       ; ecx = digit counter
    
.IntToAsciiLoop:
    test eax, eax
    jz .IntToAsciiReverse
    
    xor edx, edx
    mov r8d, 10
    div r8d                            ; rax = quotient, rdx = remainder
    
    add dl, '0'                        ; Convert digit to ASCII
    mov byte [rdi + rcx], dl           ; Store in temp buffer
    inc ecx
    jmp .IntToAsciiLoop
    
.IntToAsciiReverse:
    ; Reverse digits from temp to output
    xor r8d, r8d                       ; r8d = output index
    
.IntToAsciiReverseLoop:
    test ecx, ecx
    jz .IntToAsciiDone
    
    dec ecx
    mov al, byte [rdi + rcx]           ; Get digit from temp (right to left)
    mov byte [rsi + r8], al            ; Copy to output (left to right)
    inc r8d
    jmp .IntToAsciiReverseLoop
    
.IntToAsciiDone:
    mov byte [rsi + r8], 0             ; Null terminate
    mov eax, r8d                       ; rax = string length
    add rsp, 32
    pop rsi
    pop rdi
    ret
TextBuffer_IntToAscii ENDP

END
