#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0, std430) buffer InputA { float a[]; };
layout(binding = 1, std430) buffer InputB { float b[]; };
layout(binding = 2, std430) buffer OutputC { float c[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    c[idx] = a[idx] + b[idx];
}
