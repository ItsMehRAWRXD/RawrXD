<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- RawrXD.Executable.props - Property sheet for Executable projects -->
  <!-- Import this AFTER RawrXD.Common.props -->
  
  <PropertyGroup Label="RawrXD Executable Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <TargetExtension>.exe</TargetExtension>
  </PropertyGroup>

  <PropertyGroup Label="RawrXD Executable Debug" Condition="'$(Configuration)'=='Debug'">
    <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
    <GenerateProgramDatabaseFile>$(OutDir)$(TargetName)d.pdb</GenerateProgramDatabaseFile>
  </PropertyGroup>

  <PropertyGroup Label="RawrXD Executable Release" Condition="'$(Configuration)'=='Release'">
    <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
    <GenerateProgramDatabaseFile>$(OutDir)$(TargetName).pdb</GenerateProgramDatabaseFile>
  </PropertyGroup>

  <PropertyGroup Label="RawrXD Executable RelWithDebInfo" Condition="'$(Configuration)'=='RelWithDebInfo'">
    <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
    <GenerateProgramDatabaseFile>$(OutDir)$(TargetName).pdb</GenerateProgramDatabaseFile>
  </PropertyGroup>

  <PropertyGroup Label="RawrXD Executable MinSizeRel" Condition="'$(Configuration)'=='MinSizeRel'">
    <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
  </PropertyGroup>

  <!-- Executable linker settings -->
  <ItemDefinitionGroup>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <LinkTimeCodeGeneration Condition="'$(Configuration)'!='Debug'">UseLinkTimeCodeGeneration</LinkTimeCodeGeneration>
      <LinkTimeCodeGeneration Condition="'$(Configuration)'=='Debug'">Default</LinkTimeCodeGeneration>
      <SubSystem>Console</SubSystem>
      <EntryPointSymbol>mainCRTStartup</EntryPointSymbol>
    </Link>
  </ItemDefinitionGroup>

  <!-- Windows GUI subsystem variant -->
  <PropertyGroup Label="RawrXD Windows GUI" Condition="'$(RawrXDSubsystem)'=='Windows'">
    <Link>
      <SubSystem>Windows</SubSystem>
      <EntryPointSymbol>WinMainCRTStartup</EntryPointSymbol>
    </Link>
  </PropertyGroup>

  <!-- Resource compiler for version info and icons -->
  <ItemDefinitionGroup>
    <ResourceCompile>
      <PreprocessorDefinitions>
        _WIN32;
        %(PreprocessorDefinitions)
      </PreprocessorDefinitions>
      <AdditionalIncludeDirectories>
        $(SolutionDir)include;
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
    </ResourceCompile>
  </ItemDefinitionGroup>
</Project>