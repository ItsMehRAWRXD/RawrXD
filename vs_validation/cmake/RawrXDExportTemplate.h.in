// RawrXDExportTemplate.h.in
// Template for generating DLL export/import headers
// This file is configured by rawrxd_generate_export_header()

#ifndef @EXPORT_MACRO_NAME_UPPER@_H
#define @EXPORT_MACRO_NAME_UPPER@_H

// Detect platform and compiler for proper export decorations
#if defined(_WIN32) || defined(__CYGWIN__)
  // Windows (MSVC, MinGW, Clang-CL)
  #ifdef @EXPORT_MACRO_NAME@_EXPORTS
    // Building the DLL - export symbols
    #define @EXPORT_MACRO_NAME@ __declspec(dllexport)
  #else
    // Using the DLL - import symbols
    #define @EXPORT_MACRO_NAME@ __declspec(dllimport)
  #endif
#elif defined(__GNUC__) && (__GNUC__ >= 4)
  // GCC/Clang on Linux/macOS with visibility support
  #define @EXPORT_MACRO_NAME@ __attribute__((visibility("default")))
#else
  // Fallback for other compilers
  #define @EXPORT_MACRO_NAME@
#endif

// Helper for deprecated API
#if defined(_WIN32) || defined(__CYGWIN__)
  #ifdef @EXPORT_MACRO_NAME@_EXPORTS
    #define @EXPORT_MACRO_NAME@_DEPRECATED __declspec(deprecated) __declspec(dllexport)
  #else
    #define @EXPORT_MACRO_NAME@_DEPRECATED __declspec(deprecated) __declspec(dllimport)
  #endif
#elif defined(__GNUC__) && (__GNUC__ >= 4)
  #define @EXPORT_MACRO_NAME@_DEPRECATED __attribute__((deprecated)) __attribute__((visibility("default")))
#else
  #define @EXPORT_MACRO_NAME@_DEPRECATED __attribute__((deprecated))
#endif

// Helper for internal (non-exported) symbols
#if defined(_WIN32) || defined(__CYGWIN__)
  #define @EXPORT_MACRO_NAME@_INTERNAL
#elif defined(__GNUC__) && (__GNUC__ >= 4)
  #define @EXPORT_MACRO_NAME@_INTERNAL __attribute__((visibility("hidden")))
#else
  #define @EXPORT_MACRO_NAME@_INTERNAL
#endif

#endif // @EXPORT_MACRO_NAME_UPPER@_H