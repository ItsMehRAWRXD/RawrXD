	$(CXX) $(CXXFLAGS) $(DEFINES) $(INCLUDES) /c src/ai/memory_mapped_file.cpp /Foobj\benchmark_completions\memory_mapped_file.obj

obj\benchmark_completions\streaming_gguf_loader_qt.obj: src/ai/streaming_gguf_loader_qt.cpp
	@echo Compiling src/ai/streaming_gguf_loader_qt.cpp...
	@if not exist obj\benchmark_completions mkdir obj\benchmark_completions
	$(CXX) $(CXXFLAGS) $(DEFINES) $(INCLUDES) /c src/ai/streaming_gguf_loader_qt.cpp /Foobj\benchmark_completions\streaming_gguf_loader_qt.obj

clean:
	@echo Cleaning build artifacts...
	@rmdir /s /q obj bin lib 2>nul || echo Clean complete

