if(NOT DEFINED PLANNER OR NOT DEFINED WORK)
    message(FATAL_ERROR "PLANNER and WORK are required")
endif()
file(MAKE_DIRECTORY "${WORK}")
string(REPEAT "a" 64 hash)
set(receipt "route_records\t6\nshared_records\t6\nrouted_records\t12\nexpert_count\t8\ntop_k\t2\nfirst_shard_sha256\t${hash}\nlayer_filter\t-1\nrewrite_authorized\t0\nexpected_layer\t3\nexpected_layer\t5\n")
set(header "layer\texpert\troutes\tweighted_norm_sum\tmean_weighted_norm\n")
set(a "3\t0\t2\t2\t1\n3\t1\t1\t5\t5\n3\t4\t2\t8\t4\n3\t5\t1\t6\t6\n")
set(b "5\t2\t2\t4\t2\n5\t3\t1\t2\t2\n5\t6\t2\t8\t4\n5\t7\t1\t3\t3\n")
set(scores "${header}${a}${b}")
function(run name expected r s keep groups used)
    file(WRITE "${WORK}/receipt.tsv" "${r}")
    file(WRITE "${WORK}/scores.tsv" "${s}")
    execute_process(COMMAND "${PLANNER}" "${WORK}/receipt.tsv" "${WORK}/scores.tsv" "${keep}" "${groups}" "${used}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
    if(NOT "${rc}" STREQUAL "${expected}")
        message(FATAL_ERROR "${name}: expected ${expected}, got ${rc}: ${out} ${err}")
    endif()
    if(expected EQUAL 0)
        if(NOT out MATCHES "\"rewrite_authorized\": false" OR NOT out MATCHES "\"reference_parity_pass\": false" OR NOT out MATCHES "\"experimental_offline\": false" OR NOT err MATCHES "CANDIDATE_PLAN=PASS")
            message(FATAL_ERROR "${name}: missing fail-closed manifest")
        endif()
        if(name STREQUAL "grouped" AND (NOT out MATCHES "\"layer\": 3, \"selected\": \\[\\{\"expert\": 1\\}, \\{\"expert\": 5\\}\\]" OR NOT out MATCHES "\"layer\": 5, \"selected\": \\[\\{\"expert\": 2\\}, \\{\"expert\": 6\\}\\]"))
            message(FATAL_ERROR "incorrect grouped choices or tie break: ${out}")
        endif()
        if(name STREQUAL "ungrouped" AND NOT out MATCHES "\"layer\": 5, \"selected\": \\[\\{\"expert\": 6\\}, \\{\"expert\": 7\\}\\]")
            message(FATAL_ERROR "incorrect ungrouped ranking: ${out}")
        endif()
    elseif(NOT out STREQUAL "" OR NOT err MATCHES "INVALID_PLAN:")
        message(FATAL_ERROR "${name}: invalid evidence published output")
    endif()
    message(STATUS "PASS ${name}")
endfunction()
run(grouped 0 "${receipt}" "${scores}" 2 2 2)
run(ungrouped 0 "${receipt}" "${scores}" 2 1 1)
run(all_measured 0 "${receipt}" "${scores}" 4 2 2)
run(insufficient_coverage 2 "${receipt}" "${scores}" 6 2 2)
run(below_topk 2 "${receipt}" "${scores}" 1 1 1)
run(group_capacity 2 "${receipt}" "${scores}" 2 2 1)
run(nondivisible 2 "${receipt}" "${scores}" 3 2 2)
run(zero_groups 2 "${receipt}" "${scores}" 2 0 0)
run(missing_layer 2 "${receipt}" "${header}${a}" 2 2 2)
run(duplicate_row 2 "${receipt}" "${scores}3\t0\t1\t1\t1\n" 2 2 2)
string(REPLACE "5\t7\t1\t3\t3" "5\t8\t1\t3\t3" bad "${scores}")
run(expert_out_of_range 2 "${receipt}" "${bad}" 2 2 2)
string(REPLACE "5\t7\t1\t3\t3" "5\t7\t1\t3\t4" bad "${scores}")
run(mean_mismatch 2 "${receipt}" "${bad}" 2 2 2)
string(REPLACE "5\t7\t1\t3\t3" "5\t7\t1\tnan\tnan" bad "${scores}")
run(nonfinite 2 "${receipt}" "${bad}" 2 2 2)
string(REPLACE "layer_filter\t-1" "layer_filter\t3" bad "${receipt}")
run(partial_capture 2 "${bad}" "${scores}" 2 2 2)
string(REPLACE "routed_records\t12" "routed_records\t10" bad "${receipt}")
run(receipt_count_mismatch 2 "${bad}" "${scores}" 2 2 2)
run(duplicate_layer 2 "${receipt}expected_layer\t3\n" "${scores}" 2 2 2)
string(REPLACE "${hash}" "invalid" bad "${receipt}")
run(bad_hash 2 "${bad}" "${scores}" 2 2 2)
string(REPLACE "route_records\t6" "route_records\t18446744073709551615" bad "${receipt}")
run(overflow 2 "${bad}" "${scores}" 2 2 2)
