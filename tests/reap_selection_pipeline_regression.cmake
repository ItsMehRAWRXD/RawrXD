if(NOT DEFINED PLANNER OR NOT DEFINED SCORER OR NOT DEFINED FIXTURE OR NOT DEFINED WORK)
    message(FATAL_ERROR "PLANNER, SCORER, FIXTURE and WORK required")
endif()
file(MAKE_DIRECTORY "${WORK}")
string(REPEAT "a" 64 hash)
set(receipt "route_records\t1\nshared_records\t1\nrouted_records\t2\nexpert_count\t8\ntop_k\t2\nfirst_shard_sha256\t${hash}\nlayer_filter\t-1\nrewrite_authorized\t0\nexpected_layer\t3\n")
file(WRITE "${WORK}/receipt.tsv" "${receipt}")
execute_process(COMMAND "${FIXTURE}" ranking "${WORK}/routes.bin" "${WORK}/outputs.bin" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "fixture failed")
endif()
execute_process(COMMAND "${SCORER}" "${WORK}/routes.bin" "${WORK}/outputs.bin" 8 2 1
    RESULT_VARIABLE rc OUTPUT_FILE "${WORK}/scores.tsv" ERROR_VARIABLE err)
if(NOT rc EQUAL 0 OR NOT err MATCHES "REWRITE_AUTHORIZED=0")
    message(FATAL_ERROR "scorer failed: ${err}")
endif()
execute_process(COMMAND "${PLANNER}" "${WORK}/receipt.tsv" "${WORK}/scores.tsv" 2 1 1
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0 OR NOT out MATCHES "\"selected\": \\[\\{\"expert\": 0\\}, \\{\"expert\": 1\\}\\]" OR NOT out MATCHES "\"rewrite_authorized\": false")
    message(FATAL_ERROR "planner failed: ${out} ${err}")
endif()
message(STATUS "PASS binary capture -> scoring -> candidate selection")
file(APPEND "${WORK}/receipt.tsv" "expected_layer\t4\n")
execute_process(COMMAND "${PLANNER}" "${WORK}/receipt.tsv" "${WORK}/scores.tsv" 2 1 1
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 2 OR NOT out STREQUAL "" OR NOT err MATCHES "INVALID_PLAN:")
    message(FATAL_ERROR "missing source layer not rejected")
endif()
message(STATUS "PASS mismatched source-layer receipt rejected")
