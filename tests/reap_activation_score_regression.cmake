if(NOT DEFINED SCORER OR NOT DEFINED FIXTURE OR NOT DEFINED WORK)
    message(FATAL_ERROR "SCORER, FIXTURE and WORK required")
endif()
file(MAKE_DIRECTORY "${WORK}")
foreach(case IN ITEMS ranking repeat reorder truncated missing extra wrong_step wrong_weight duplicate nan missing_route bad_expert duplicate_route_id)
    execute_process(COMMAND "${FIXTURE}" "${case}" "${WORK}/routes.bin" "${WORK}/outputs.bin" RESULT_VARIABLE fixture_rc)
    if(NOT fixture_rc EQUAL 0)
        message(FATAL_ERROR "${case}: fixture error")
    endif()
    set(count 1)
    if(case STREQUAL "repeat" OR case STREQUAL "missing_route")
        set(count 2)
    endif()
    execute_process(COMMAND "${SCORER}" "${WORK}/routes.bin" "${WORK}/outputs.bin" 8 2 "${count}" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
    if(case STREQUAL "ranking" OR case STREQUAL "repeat" OR case STREQUAL "reorder")
        if(count EQUAL 2)
            set(expected "layer\texpert\troutes\tweighted_norm_sum\tmean_weighted_norm\n3\t1\t2\t10\t5\n3\t0\t2\t1.5\t0.75\n")
        else()
            set(expected "layer\texpert\troutes\tweighted_norm_sum\tmean_weighted_norm\n3\t1\t1\t5\t5\n3\t0\t1\t0.75\t0.75\n")
        endif()
        string(REPLACE "\r\n" "\n" out "${out}")
        if(NOT rc EQUAL 0 OR NOT out STREQUAL expected OR NOT err MATCHES "REWRITE_AUTHORIZED=0")
            message(FATAL_ERROR "${case}: incorrect scores or status: ${rc} ${out} ${err}")
        endif()
    elseif(NOT rc EQUAL 2 OR NOT out STREQUAL "" OR NOT err MATCHES "INVALID_CAPTURE:")
        message(FATAL_ERROR "${case}: invalid capture not rejected: ${rc} ${out} ${err}")
    endif()
    message(STATUS "PASS ${case}")
endforeach()
