# Exercise the actual evaluator executable with binary IEEE-754 fixtures.
# Fixtures are evaluator regression evidence, never model quality evidence.
if(NOT DEFINED EVALUATOR OR NOT DEFINED WORK)
    message(FATAL_ERROR "EVALUATOR and WORK are required")
endif()
file(MAKE_DIRECTORY "${WORK}")
# ASCII byte patterns are finite distinct F32 values on little-endian hosts.
file(WRITE "${WORK}/r0.bin" "AAAABBBBCCCC")
file(WRITE "${WORK}/r1.bin" "CCCCBBBBAAAA")
file(WRITE "${WORK}/c0.bin" "AAAABBBBCCCC")
file(WRITE "${WORK}/c1.bin" "CCCCBBBBAAAA")
file(WRITE "${WORK}/bad.bin" "CCCCBBBBAAAA")
file(WRITE "${WORK}/short.bin" "AAAA")
string(ASCII 1 1 128 127 nan)
file(WRITE "${WORK}/nan.bin" "${nan}BBBBCCCC")
file(WRITE "${WORK}/ref.tsv" "s\t0\t0\t2\tr0.bin\ns\t1\t2\t0\tr1.bin\n")
function(check name expected rows)
    file(WRITE "${WORK}/candidate.tsv" "${rows}")
    execute_process(COMMAND "${EVALUATOR}" "${WORK}/ref.tsv" "${WORK}/candidate.tsv"
        3 2 1 0.999999 0 0 1
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 15)
    if(NOT "${rc}" STREQUAL "${expected}")
        message(FATAL_ERROR "${name}: expected ${expected}, got ${rc}\n${out}\n${err}")
    endif()
    if(expected EQUAL 0 AND NOT out MATCHES "CAPTURE_METRICS=PASS")
        message(FATAL_ERROR "${name}: missing pass receipt")
    elseif(expected EQUAL 1 AND NOT out MATCHES "CAPTURE_METRICS=FAIL")
        message(FATAL_ERROR "${name}: missing mismatch receipt")
    elseif(expected EQUAL 2 AND NOT err MATCHES "INVALID_EVIDENCE:")
        message(FATAL_ERROR "${name}: missing invalid evidence receipt")
    endif()
    message(STATUS "PASS ${name}")
endfunction()
check(identical 0 "s\t0\t0\t2\tc0.bin\ns\t1\t2\t0\tc1.bin\n")
check(mismatch 1 "s\t0\t0\t2\tbad.bin\ns\t1\t2\t0\tc1.bin\n")
check(nonfinite 2 "s\t0\t0\t2\tnan.bin\ns\t1\t2\t0\tc1.bin\n")
check(mismatched_tokens 2 "s\t0\t1\t2\tc0.bin\ns\t1\t2\t0\tc1.bin\n")
check(missing_position 2 "s\t0\t0\t2\tc0.bin\n")
check(reference_reuse 2 "s\t0\t0\t2\tr0.bin\ns\t1\t2\t0\tc1.bin\n")
check(truncated 2 "s\t0\t0\t2\tshort.bin\ns\t1\t2\t0\tc1.bin\n")
check(duplicate_capture 2 "s\t0\t0\t2\tc0.bin\ns\t1\t2\t0\tc0.bin\n")
check(broken_teacher_forcing 2 "s\t0\t0\t2\tc0.bin\ns\t1\t1\t0\tc1.bin\n")
check(position_gap 2 "s\t0\t0\t2\tc0.bin\ns\t2\t2\t0\tc1.bin\n")
check(out_of_vocab 2 "s\t0\t3\t2\tc0.bin\ns\t1\t2\t0\tc1.bin\n")
check(missing_file 2 "s\t0\t0\t2\tnot-present.bin\ns\t1\t2\t0\tc1.bin\n")
