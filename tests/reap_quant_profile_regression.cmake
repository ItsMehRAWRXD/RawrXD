if(NOT DEFINED PLANNER OR NOT DEFINED WORK)
    message(FATAL_ERROR "PLANNER and WORK required")
endif()
file(MAKE_DIRECTORY "${WORK}")
string(REPEAT "a" 64 hash)
set(receipt "route_records\t6\nshared_records\t6\nrouted_records\t12\nexpert_count\t8\ntop_k\t2\nfirst_shard_sha256\t${hash}\nlayer_filter\t-1\nrewrite_authorized\t0\nexpected_layer\t3\nexpected_layer\t5\n")
set(scores "layer\texpert\troutes\tweighted_norm_sum\tmean_weighted_norm\n3\t0\t2\t2\t1\n3\t1\t1\t5\t5\n3\t4\t2\t8\t4\n3\t5\t1\t6\t6\n5\t2\t2\t4\t2\n5\t3\t1\t2\t2\n5\t6\t2\t8\t4\n5\t7\t1\t3\t3\n")
set(base "schema\tRAWRXD_REAP_PRUNE_BUDGET_001\nfirst_shard_sha256\t${hash}\nexpert_count\t8\ntop_k\t2\ngroup_count\t2\ngroups_used\t2\nbudget_bytes\t1000\nminimum_bytes\t700\nmax_retained\t2\npredicted_max_bytes\t700\nrewrite_authorized\t0\nexpected_layer\t3\nexpected_layer\t5\n")
string(REPLACE "BUDGET_001" "BUDGET_002" alt "${base}")
string(REPLACE "minimum_bytes\t700" "minimum_bytes\t500" alt "${alt}")
string(REPLACE "max_retained\t2" "max_retained\t4" alt "${alt}")
string(REPLACE "predicted_max_bytes\t700" "predicted_max_bytes\t900" alt "${alt}")
string(APPEND alt "quantization_profile\tq4k_expert_to_q2k\n")
function(run name expected keep profile original alternative)
    file(WRITE "${WORK}/receipt.tsv" "${receipt}")
    file(WRITE "${WORK}/scores.tsv" "${scores}")
    file(WRITE "${WORK}/base.tsv" "${original}")
    file(WRITE "${WORK}/alt.tsv" "${alternative}")
    execute_process(COMMAND "${PLANNER}" "${WORK}/receipt.tsv" "${WORK}/scores.tsv" --budget-report "${WORK}/base.tsv" --alternative-report "${WORK}/alt.tsv" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
    if(NOT "${rc}" STREQUAL "${expected}")
        message(FATAL_ERROR "${name}: unexpected exit ${rc}: ${out} ${err}")
    endif()
    if(expected EQUAL 0)
        if(NOT out MATCHES "\"retained_experts\": ${keep}," OR NOT out MATCHES "\"quantization_profile\": \"${profile}\"" OR NOT out MATCHES "\"quantization_quality_verified\": false" OR NOT out MATCHES "\"rewrite_authorized\": false")
            message(FATAL_ERROR "${name}: unexpected manifest ${out}")
        endif()
    elseif(NOT out STREQUAL "" OR NOT err MATCHES "INVALID_PLAN:")
        message(FATAL_ERROR "${name}: rejected evidence published output")
    endif()
    message(STATUS "PASS ${name}")
endfunction()
run(larger_quantized_bank 0 4 q4k_expert_to_q2k "${base}" "${alt}")
string(REPLACE "max_retained\t4" "max_retained\t2" tied "${alt}")
run(tie_preserves_precision 0 2 preserve "${base}" "${tied}")
string(REPLACE "minimum_bytes\t700" "minimum_bytes\t1100" impossible "${base}")
string(REPLACE "max_retained\t2" "max_retained\t0" impossible "${impossible}")
string(REPLACE "predicted_max_bytes\t700" "predicted_max_bytes\t0" impossible "${impossible}")
run(only_alternative_fits 0 4 q4k_expert_to_q2k "${impossible}" "${alt}")
string(REPLACE "budget_bytes\t1000" "budget_bytes\t1200" bad "${alt}")
run(different_budgets 2 0 none "${base}" "${bad}")
string(REPLACE "groups_used\t2" "groups_used\t1" bad "${alt}")
run(different_topology 2 0 none "${base}" "${bad}")
string(REPLACE "q4k_expert_to_q2k" "unknown" bad "${alt}")
run(unknown_codec 2 0 none "${base}" "${bad}")
run(duplicate_profile 2 0 none "${base}" "${base}")
string(REPLACE "max_retained\t4" "max_retained\t6" coverage "${alt}")
run(calibration_caps_alternative 0 4 q4k_expert_to_q2k "${base}" "${coverage}")
