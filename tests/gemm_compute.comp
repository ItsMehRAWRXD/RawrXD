#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer InputA {
    float data[];
} matrixA;

layout(std430, binding = 1) readonly buffer InputB {
    float data[];
} matrixB;

layout(std430, binding = 2) writeonly buffer OutputC {
    float data[];
} matrixC;

layout(push_constant) uniform PushConstants {
    uint M;
    uint N;
    uint K;
} dims;

void main() {
    uint row = gl_GlobalInvocationID.x;
    uint col = gl_GlobalInvocationID.y;

    if (row >= dims.M || col >= dims.N) {
        return;
    }

    float sum = 0.0;
    for (uint k = 0; k < dims.K; k++) {
        float a = matrixA.data[row * dims.K + k];
        float b = matrixB.data[k * dims.N + col];
        sum += a * b;
    }
    matrixC.data[row * dims.N + col] = sum;
}
