if(NOT DEFINED PLANNER OR NOT DEFINED WORK)
    message(FATAL_ERROR "PLANNER and WORK required")
endif()
file(MAKE_DIRECTORY "${WORK}")
string(REPEAT "a" 64 hash)
string(REPEAT "A" 64 upperHash)
set(receipt "route_records\t6\nshared_records\t6\nrouted_records\t12\nexpert_count\t8\ntop_k\t2\nfirst_shard_sha256\t${hash}\nlayer_filter\t-1\nrewrite_authorized\t0\nexpected_layer\t3\nexpected_layer\t5\n")
set(header "layer\texpert\troutes\tweighted_norm_sum\tmean_weighted_norm\n")
set(scores "${header}3\t0\t2\t2\t1\n3\t1\t1\t5\t5\n3\t4\t2\t8\t4\n3\t5\t1\t6\t6\n5\t2\t2\t4\t2\n5\t3\t1\t2\t2\n5\t6\t2\t8\t4\n5\t7\t1\t3\t3\n")
set(report "schema\tRAWRXD_REAP_PRUNE_BUDGET_001\nfirst_shard_sha256\t${upperHash}\nexpert_count\t8\ntop_k\t2\ngroup_count\t2\ngroups_used\t2\nbudget_bytes\t1000\nminimum_bytes\t500\nmax_retained\t6\npredicted_max_bytes\t900\nrewrite_authorized\t0\nexpected_layer\t3\nexpected_layer\t5\n")
function(run name expected keep reportText scoreText)
    file(WRITE "${WORK}/receipt.tsv" "${receipt}")
    file(WRITE "${WORK}/scores.tsv" "${scoreText}")
    file(WRITE "${WORK}/budget.tsv" "${reportText}")
    execute_process(COMMAND "${PLANNER}" "${WORK}/receipt.tsv" "${WORK}/scores.tsv" --budget-report "${WORK}/budget.tsv" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
    if(NOT "${rc}" STREQUAL "${expected}")
        message(FATAL_ERROR "${name}: expected ${expected}, got ${rc}: ${out} ${err}")
    endif()
    if(expected EQUAL 0)
        if(NOT out MATCHES "\"retained_experts\": ${keep}," OR NOT out MATCHES "\"rewrite_authorized\": false" OR NOT out MATCHES "\"reference_parity_pass\": false" OR NOT out MATCHES "\"budget_report_consistent\": true" OR NOT err MATCHES "GROUP_GEOMETRY_ATTESTED=0")
            message(FATAL_ERROR "${name}: bad candidate or promotion state: ${out} ${err}")
        endif()
    elseif(NOT out STREQUAL "" OR NOT err MATCHES "INVALID_PLAN:")
        message(FATAL_ERROR "${name}: invalid report emitted candidate")
    endif()
    message(STATUS "PASS ${name}")
endfunction()
