				;   RCX = float* input (32-byte aligned)
				;   RDX = float* output (32-byte aligned)
				;   R8  = float* weights (32-byte aligned)
				;   R9  = size_t size (multiple of 8)
				; Returns: RAX = 0 on success
				; ============================================================================

