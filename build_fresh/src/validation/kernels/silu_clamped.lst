				; ============================================================================
				; MASM_SiLU_Clamped - SiLU with input clamping for numerical stability
				; ============================================================================
				; Parameters:
				;   RCX = float* data (32-byte aligned)
				;   RDX = size_t data_size (in bytes, multiple of 32)
				; Returns: RAX = 0 on success
				; ============================================================================

 00000000			MASM_SiLU_Clamped PROC FRAME
				    ; Prologue - CRITICAL: Save non-volatile registers RBX and RSI
 00000000  55			    push rbp
				    .pushreg rbp
 00000001  48/ 8B EC		    mov rbp, rsp
				    .setframe rbp, 0
 00000004  53			    push rbx
				    .pushreg rbx
 00000005  56			    push rsi
				    .pushreg rsi
 00000006  48/ 83 EC 20		    sub rsp, 32
				    .allocstack 32
				    .endprolog

				    ; Save parameters
 0000000A  48/ 8B F1		    mov rsi, rcx               ; rsi = data pointer
 0000000D  48/ 8B DA		    mov rbx, rdx               ; rbx = data_size
				    
				    ; Validate inputs
 00000010  48/ 85 F6		    test rsi, rsi
 00000013  0F 84 000000EC	    jz error_null
 00000019  48/ 85 DB		    test rbx, rbx
 0000001C  0F 84 000000EC	    jz error_zero
 00000022  48/ F7 C6		    test rsi, 31
	   0000001F
 00000029  0F 85 000000E8	    jnz error_align
 0000002F  48/ F7 C3		    test rbx, 31
	   0000001F
 00000036  0F 85 000000E4	    jnz error_size

				    ; Calculate iterations
 0000003C  48/ 8B CB		    mov rcx, rbx
 0000003F  48/ C1 E9 05		    shr rcx, 5                  ; rcx = number of 32-byte blocks
				    
				    ; Load clamp boundaries
 00000043  C5 7C/ 28 3D		    vmovaps ymm15, YMMWORD PTR [g_neg4]    ; ymm15 = -4.0
	   00000120 R
 0000004B  C5 7C/ 28 35		    vmovaps ymm14, YMMWORD PTR [g_pos4]    ; ymm14 = 4.0
	   00000140 R
				    
				    ; Load exp constants
 00000053  C5 7C/ 28 05		    vmovaps ymm8, YMMWORD PTR [g_exp_c0]   ; 1.0
	   000001A0 R
 0000005B  C5 7C/ 28 0D		    vmovaps ymm9, YMMWORD PTR [g_exp_c1]   ; 1.0
	   000001C0 R
 00000063  C5 7C/ 28 15		    vmovaps ymm10, YMMWORD PTR [g_exp_c2]  ; 0.5
	   000001E0 R
 0000006B  C5 7C/ 28 1D		    vmovaps ymm11, YMMWORD PTR [g_exp_c3]  ; 0.166667
	   00000200 R
 00000073  C5 7C/ 28 25		    vmovaps ymm12, YMMWORD PTR [g_exp_c4]  ; 0.041667
	   00000220 R
 0000007B  C5 7C/ 28 2D		    vmovaps ymm13, YMMWORD PTR [g_one]     ; 1.0
	   00000180 R

 00000083			process_loop:
 00000083  48/ 83 F9 00		    cmp rcx, 0
 00000087  7E 77		    jle done
				    
				    ; Load 8 floats
 00000089  C5 FC/ 28 06		    vmovaps ymm0, YMMWORD PTR [rsi]    ; ymm0 = x
				    
				    ; ============================================================================
				    ; CLAMP INPUT to [-4, 4] before polynomial evaluation
				    ; This prevents catastrophic divergence outside the polynomial's valid range
				    ; ============================================================================
 0000008D  C4 C1 7C/ 5F C7	    vmaxps ymm0, ymm0, ymm15           ; ymm0 = max(x, -4.0)
 00000092  C4 C1 7C/ 5D C6	    vminps ymm0, ymm0, ymm14           ; ymm0 = min(ymm0, 4.0)
				    ; Now ymm0 is clamped to [-4, 4]
				    
				    ; Compute -x for exp(-x)
				    ; Load zero and subtract x
 00000097  C5 F4/ 57 C9		    vxorps ymm1, ymm1, ymm1            ; ymm1 = 0
 0000009B  C5 F4/ 5C C8		    vsubps ymm1, ymm1, ymm0            ; ymm1 = -x
				    
				    ; Compute exp(-x) using polynomial: 1 + y + y^2/2 + y^3/6 + y^4/24
				    ; where y = -x
				    
				    ; y^2
 0000009F  C5 F4/ 59 D1		    vmulps ymm2, ymm1, ymm1            ; ymm2 = y^2
				    
				    ; y^3 = y^2 * y
 000000A3  C5 EC/ 59 D9		    vmulps ymm3, ymm2, ymm1            ; ymm3 = y^3
				    
				    ; y^4 = y^2 * y^2
 000000A7  C5 EC/ 59 E2		    vmulps ymm4, ymm2, ymm2            ; ymm4 = y^4
				    
				    ; exp(y) = 1 + y + y^2/2 + y^3/6 + y^4/24
 000000AB  C4 C1 6C/ 59 D2	    vmulps ymm2, ymm2, ymm10           ; ymm2 = y^2/2
 000000B0  C4 C1 64/ 59 DB	    vmulps ymm3, ymm3, ymm11           ; ymm3 = y^3/6
 000000B5  C4 C1 5C/ 59 E4	    vmulps ymm4, ymm4, ymm12           ; ymm4 = y^4/24
				    
 000000BA  C5 BC/ 58 E9		    vaddps ymm5, ymm8, ymm1            ; ymm5 = 1 + y
 000000BE  C5 D4/ 58 EA		    vaddps ymm5, ymm5, ymm2            ; ymm5 += y^2/2
