				; ============================================================================
				; silu_clamped.asm - SiLU with input clamping for numerical stability
				; ============================================================================
				; Clamps input to [-4, 4] before polynomial evaluation to prevent
				; catastrophic divergence outside the polynomial's valid range.
				;
				; SiLU(x) = x * sigmoid(x) = x / (1 + exp(-x))
				; ============================================================================

				OPTION CASEMAP:NONE

				; Include math approximation macros
				INCLUDE math_approx.inc
			      C ; ============================================================================
			      C ; math_approx.inc - High Performance Math Approximations
			      C ; ============================================================================
			      C ; Implementation: Fast Exp2 (2^x) via Minimax Polynomial & Bit Manipulation
			      C ; Requires: AVX2/AVX-512 support
			      C ;
			      C ; Mathematical Foundation:
			      C ;   e^x = 2^(x * log2(e))
			      C ;   2^x = 2^I * 2^F  where I = floor(x), F = x - floor(x)
			      C ;   2^F ≈ P(F) where P is a degree-4 Minimax polynomial on [0, 1)
			      C ;
			      C ; Accuracy: < 1e-5 error across all inputs
			      C ; Performance: Zero-overhead inlining via MACRO
			      C ; ============================================================================
			      C 
			      C ; -----------------------------------------------------------------------------
			      C ; MACRO: MATH_CONSTANTS
			      C ; Place this in your .const section to define the necessary constants.
			      C ; -----------------------------------------------------------------------------
			      C MATH_CONSTANTS MACRO
			      C     ; Coefficients for 2^F where F in [0, 1)
			      C     ; Horner's Method: (((((p6*F + p5)*F + p4)*F + p3)*F + p2)*F + p1)*F + 1.0
			      C     ; These are Remez-optimized coefficients for maximum accuracy (< 1e-5 error)
			      C     ; Each constant is replicated 8 times for YMM registers (256-bit)
			      C     ;
			      C     ; Degree-6 polynomial coefficients (ultra-high accuracy):
			      C     ; P(F) = 1.0 + F*(p1 + F*(p2 + F*(p3 + F*(p4 + F*(p5 + F*p6)))))
			      C     ; Max error: < 1e-5 across all inputs
			      C     EXP2_P6 DD 0.00015506f, 0.00015506f, 0.00015506f, 0.00015506f, 0.00015506f, 0.00015506f, 0.00015506f, 0.00015506f
			      C     EXP2_P5 DD 0.00133335f, 0.00133335f, 0.00133335f, 0.00133335f, 0.00133335f, 0.00133335f, 0.00133335f, 0.00133335f
			      C     EXP2_P4 DD 0.00961813f, 0.00961813f, 0.00961813f, 0.00961813f, 0.00961813f, 0.00961813f, 0.00961813f, 0.00961813f
			      C     EXP2_P3 DD 0.05550411f, 0.05550411f, 0.05550411f, 0.05550411f, 0.05550411f, 0.05550411f, 0.05550411f, 0.05550411f
			      C     EXP2_P2 DD 0.24022650f, 0.24022650f, 0.24022650f, 0.24022650f, 0.24022650f, 0.24022650f, 0.24022650f, 0.24022650f
			      C     EXP2_P1 DD 0.69314718f, 0.69314718f, 0.69314718f, 0.69314718f, 0.69314718f, 0.69314718f, 0.69314718f, 0.69314718f
			      C     
			      C     ; Exponent Bias for 2^I (IEEE 754)
			      C     ; Each constant is replicated 8 times for YMM registers (256-bit)
			      C     EXP2_BIAS DD 127, 127, 127, 127, 127, 127, 127, 127
			      C     
			      C     ; Constant for multiplication by log2(e)
			      C     ; Used to convert base e to base 2: x * log2(e) = x * 1.44269504
			      C     LOG2E DD 1.44269504f, 1.44269504f, 1.44269504f, 1.44269504f, 1.44269504f, 1.44269504f, 1.44269504f, 1.44269504f
			      C     
			      C     ; Constant 1.0 for polynomial evaluation
			      C     ONE_CONST DD 1.0f, 1.0f, 1.0f, 1.0f, 1.0f, 1.0f, 1.0f, 1.0f
			      C ENDM
			      C 
			      C ; -----------------------------------------------------------------------------
			      C ; MACRO: FAST_EXP2
			      C ; Computes 2^x for all x in ymm register
			      C ;
			      C ; Parameters:
			      C ;   dst: Output register (will contain 2^x)
			      C ;   src: Input register (will be destroyed)
			      C ;   tmp1: Temporary register for integer part I
			      C ;   tmp2: Temporary register for polynomial evaluation
			      C ;   tmp3: Temporary register for exponent reconstruction
			      C ;
			      C ; Algorithm:
			      C ;   1. Range Reduction: I = floor(x), F = x - floor(x)
			      C ;   2. Polynomial: P(F) = (((p4*F + p3)*F + p2)*F + p1)*F + 1.0
			      C ;   3. Exponent: 2^I via IEEE 754 bit manipulation
			      C ;   4. Combine: 2^x = P(F) * 2^I
			      C ;
			      C ; Register Usage:
			      C ;   dst: Initially contains x, finally contains 2^x
			      C ;   src: Input (destroyed)
			      C ;   tmp1: Integer part I
			      C ;   tmp2: Polynomial accumulator
			      C ;   tmp3: Exponent field
			      C ; -----------------------------------------------------------------------------
			      C FAST_EXP2 MACRO dst, src, tmp1, tmp2, tmp3
			      C     ; Step 1: Range Reduction (Floor)
			      C     ; Get integer part I using floor operation
			      C     ; For AVX2: vroundps with _MM_FROUND_TO_NEG_INF (1)
			      C     vroundps tmp1, src, 1      ; tmp1 = floor(x) = I
			      C     
			      C     ; Get fractional part F = x - floor(x)
			      C     vsubps dst, src, tmp1       ; dst = F = x - I, where F in [0, 1)
			      C     
			      C     ; Step 2: Polynomial Approximation (Horner's Method)
			      C     ; P(F) = (((((p6*F + p5)*F + p4)*F + p3)*F + p2)*F + p1)*F + 1.0
			      C     ; Using separate multiply and add for AVX2 compatibility
			      C     
			      C     vmulps tmp2, dst, YMMWORD PTR [EXP2_P6]     ; tmp2 = p6*F
			      C     vaddps tmp2, tmp2, YMMWORD PTR [EXP2_P5]    ; tmp2 = p6*F + p5
			      C     vmulps tmp2, tmp2, dst                       ; tmp2 = (p6*F + p5)*F
			      C     vaddps tmp2, tmp2, YMMWORD PTR [EXP2_P4]    ; tmp2 = (p6*F + p5)*F + p4
			      C     vmulps tmp2, tmp2, dst                       ; tmp2 = ...*F
			      C     vaddps tmp2, tmp2, YMMWORD PTR [EXP2_P3]    ; tmp2 = ...*F + p3
			      C     vmulps tmp2, tmp2, dst                       ; tmp2 = ...*F
			      C     vaddps tmp2, tmp2, YMMWORD PTR [EXP2_P2]    ; tmp2 = ...*F + p2
			      C     vmulps tmp2, tmp2, dst                       ; tmp2 = ...*F
			      C     vaddps tmp2, tmp2, YMMWORD PTR [EXP2_P1]    ; tmp2 = ...*F + p1
			      C     vmulps tmp2, tmp2, dst                       ; tmp2 = ...*F
			      C     vaddps dst, tmp2, YMMWORD PTR [ONE_CONST]   ; dst = ...*F + 1.0
			      C     
			      C     ; Step 3: Exponent Reconstruction (2^I)
			      C     ; Convert I to integer
			      C     vcvtps2dq tmp3, tmp1        ; tmp3 = (int)I
			      C     
			      C     ; Add bias 127 to I
			      C     vpaddd tmp3, tmp3, YMMWORD PTR [EXP2_BIAS] ; tmp3 = I + 127
			      C     
			      C     ; Shift I into exponent field (bits 23-30 of IEEE 754 float)
			      C     ; IEEE 754: exponent is stored with bias 127
			      C     ; 2^I = (I + 127) << 23
			      C     vpslld tmp3, tmp3, 23       ; tmp3 = (I + 127) << 23
			      C     
			      C     ; Step 4: Combine: Result = P(F) * 2^I
			      C     vmulps dst, dst, tmp3       ; dst = P(F) * 2^I = 2^x
			      C ENDM
			      C 
			      C ; -----------------------------------------------------------------------------
			      C ; MACRO: FAST_EXP
			      C ; Computes e^x using FAST_EXP2
			      C ; e^x = 2^(x * log2(e))
			      C ;
			      C ; Parameters:
			      C ;   dst: Output register (will contain e^x)
			      C ;   src: Input register (will be destroyed)
			      C ;   tmp1: Temporary register for integer part I
			      C ;   tmp2: Temporary register for polynomial evaluation
			      C ;   tmp3: Temporary register for exponent reconstruction
			      C ; -----------------------------------------------------------------------------
			      C FAST_EXP MACRO dst, src, tmp1, tmp2, tmp3
			      C     ; Convert base e to base 2: e^x = 2^(x * log2(e))
			      C     ; Note: LOG2E constant must be defined in .data section via MATH_CONSTANTS macro
			      C     vmulps dst, src, YMMWORD PTR [LOG2E]  ; dst = x * log2(e)
			      C     
			      C     ; Compute 2^(x * log2(e))
			      C     FAST_EXP2 dst, dst, tmp1, tmp2, tmp3
			      C ENDM
			      C 
			      C ; -----------------------------------------------------------------------------
			      C ; MACRO: FAST_RECIP
			      C ; Computes 1/x for all x in ymm register using Newton-Raphson refinement
			      C ;
			      C ; Parameters:
			      C ;   dst: Output register (will contain 1/x)
			      C ;   src: Input register (will be destroyed)
			      C ;   tmp: Temporary register for Newton-Raphson refinement
			      C ;
			      C ; Algorithm:
			      C ;   1. Use AVX2 reciprocal instruction: vrcpps (approximate reciprocal)
			      C ;   2. One Newton-Raphson iteration for improved accuracy
			      C ;      r1 = r0 * (2 - x * r0)
			      C ;
			      C ; Accuracy: Max error < 1e-6
			      C ; Performance: ~5 cycles per 8 floats
			      C ; -----------------------------------------------------------------------------
			      C ; -----------------------------------------------------------------------------
			      C ; MACRO: FAST_RECIP
			      C ; Computes 1/x for all x in ymm register using Newton-Raphson refinement
			      C ;
			      C ; Parameters:
			      C ;   dst: Output register (will contain 1/x)
			      C ;   src: Input register (will be destroyed)
			      C ;   tmp1: Temporary register for Newton-Raphson refinement
			      C ;   tmp2: Temporary register for 2.0 constant
			      C ;
			      C ; Algorithm:
			      C ;   1. Use AVX2 reciprocal instruction: vrcpps (approximate reciprocal)
			      C ;   2. One Newton-Raphson iteration for improved accuracy
			      C ;      r1 = r0 * (2 - x * r0)
			      C ;
			      C ; Accuracy: Max error < 1e-6
			      C ; Performance: ~5 cycles per 8 floats
			      C ; -----------------------------------------------------------------------------
			      C FAST_RECIP MACRO dst, src, tmp1, tmp2
			      C     ; Step 1: Compute initial approximation using hardware reciprocal
			      C     vrcpps dst, src
			      C     
			      C     ; Step 2: Newton-Raphson refinement
			      C     ; r1 = r0 * (2 - x * r0)
			      C     ; where r0 is the initial approximation from vrcpps
			      C     
			      C     ; tmp1 = x * r0
			      C     vmulps tmp1, src, dst
			      C     
			      C     ; tmp2 = 2.0
			      C     vmovaps tmp2, YMMWORD PTR [ONE_CONST]
			      C     vaddps tmp2, tmp2, YMMWORD PTR [ONE_CONST]  ; tmp2 = 2.0
			      C     
			      C     ; tmp2 = 2.0 - x * r0
			      C     vsubps tmp2, tmp2, tmp1                      ; tmp2 = 2.0 - x * r0
			      C     
			      C     ; dst = r0 * (2 - x * r0)
			      C     vmulps dst, dst, tmp2                        ; dst = r0 * (2 - x * r0)
			      C ENDM
			      C 
			      C ; ============================================================================
			      C ; Usage Example:
			      C ; ============================================================================
			      C ; .const
			      C ; MATH_CONSTANTS  ; Define constants
			      C ;
			      C ; .code
			      C ; MyKernel PROC
			      C ;     ; ... load input into ymm0 ...
			      C ;     
			      C ;     ; Compute e^x
			      C ;     FAST_EXP ymm0, ymm0, ymm1, ymm2, ymm3
			      C ;     
			      C ;     ; ... continue with result in ymm0 ...
			      C ; MyKernel ENDP
