				; ============================================================================
				; abi_integrity_simple.asm - Simplified ABI Compliance Test
				; ============================================================================
				; 
				; PURPOSE: Check if MASM kernel preserves non-volatile registers
				; 
				; This is a simplified version that:
				; 1. Saves non-volatile registers (RBX, RSI, RDI, R12-R15)
				; 2. Calls the MASM kernel
				; 3. Checks if non-volatile registers are preserved
				; 4. Returns 0 if compliant, 1 if violations detected
				; 
				; CRITICAL: This is for development/debugging ONLY.
				; 
				; ============================================================================

				OPTION CASEMAP:NONE

				; External MASM kernel to test
				extern MASM_SiLU_Clamped : proc

 00000000			.code

				; ============================================================================
				; TestABIIntegrity_Simple - Tests MASM_SiLU_Clamped for ABI compliance
				; ============================================================================
				; Parameters:
				;   RCX = void* data       (pointer to float array)
				;   RDX = size_t data_size (number of bytes)
				; Returns:
				;   RAX = 0 if ABI compliant, 1 if violations detected
				; ============================================================================

 00000000			TestABIIntegrity_Simple PROC FRAME

				    ; Prologue - save non-volatile registers
 00000000  55			    push rbp
				    .pushreg rbp
 00000001  48/ 8B EC		    mov rbp, rsp
				    .setframe rbp, 0
				    
				    ; Save non-volatile registers on stack
 00000004  53			    push rbx
				    .pushreg rbx
 00000005  56			    push rsi
				    .pushreg rsi
 00000006  57			    push rdi
				    .pushreg rdi
 00000007  41/ 54		    push r12
				    .pushreg r12
 00000009  41/ 55		    push r13
				    .pushreg r13
 0000000B  41/ 56		    push r14
				    .pushreg r14
 0000000D  41/ 57		    push r15
				    .pushreg r15
				    
 0000000F  48/ 83 EC 20		    sub rsp, 32
				    .allocstack 32
				    .endprolog
				    
				    ; Save parameters (RCX, RDX are volatile, but we need them after call)
 00000013  4C/ 8B E1		    mov r12, rcx          ; r12 = data pointer (non-volatile)
 00000016  4C/ 8B EA		    mov r13, rdx          ; r13 = data_size (non-volatile)
				    
				    ; Save original values of non-volatile registers
 00000019  48/ 89 5D F8		    mov [rbp-8], rbx      ; Save RBX
 0000001D  48/ 89 75 F0		    mov [rbp-16], rsi     ; Save RSI
 00000021  48/ 89 7D E8		    mov [rbp-24], rdi     ; Save RDI
 00000025  4C/ 89 65 E0		    mov [rbp-32], r12     ; Save R12 (original data pointer)
 00000029  4C/ 89 6D D8		    mov [rbp-40], r13     ; Save R13 (original data_size)
 0000002D  4C/ 89 75 D0		    mov [rbp-48], r14     ; Save R14
 00000031  4C/ 89 7D C8		    mov [rbp-56], r15     ; Save R15
				    
				    ; ========================================
				    ; Call the MASM kernel
				    ; ========================================
				    
 00000035  49/ 8B CC		    mov rcx, r12          ; Restore data pointer
 00000038  49/ 8B D5		    mov rdx, r13          ; Restore data_size
				    
 0000003B  E8 00000000 E	    call MASM_SiLU_Clamped
				    
				    ; Save return value
 00000040  4C/ 8B F8		    mov r15, rax          ; r15 = kernel return value
				    
				    ; ========================================
				    ; Check non-volatile registers
				    ; ========================================
				    
 00000043  48/ 33 C0		    xor rax, rax          ; rax = 0 (assume pass)
				    
				    ; Check RBX
 00000046  48/ 3B 5D F8		    cmp rbx, [rbp-8]
 0000004A  74 07		    je check_rsi
 0000004C  48/ C7 C0		    mov rax, 1            ; Mark as failed
