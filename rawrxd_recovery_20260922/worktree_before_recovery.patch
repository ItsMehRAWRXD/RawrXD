-;   RCX = source pointer (Q4_0 blocks)
-;   RDX = destination pointer (float32 output)
-;   R8  = number of blocks
-;
-; Returns:
-;   RAX = 0 on success, -1 on error
-; ----------------------------------------------------------------------------
-Aperture_Q4_0_Dequant_AVX512 PROC EXPORT FRAME
-    ; Save non-volatile registers
-    push    rbx
-    .pushreg rbx
