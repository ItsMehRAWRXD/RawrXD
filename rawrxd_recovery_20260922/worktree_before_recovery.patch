-; ============================================================================;
-Memory_Store proc
-    push rbx
-    push r12
-    push r13
-    push r14
-    push r15
-    sub rsp, 56
-    
-    ; Save arguments
-    mov r12, rcx            ; R12 = key
-    mov r13, rdx            ; R13 = key_len
-    mov r14, r8             ; R14 = data
-    mov r15, r9             ; R15 = data_len
