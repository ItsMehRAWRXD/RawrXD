-    mov hFile, rax
-    
-    lea rdx, qwSizeHigh
-    mov rcx, hFile
-    call GetFileSizeEx
-    test eax, eax
-    jz @@error_close
-    mov rax, [rsp+30h]
-    mov qwFileSize, rax
-    
-    cmp rax, MAX_FILE_SIZE
-    ja @@error_close
-    
-    xor ecx, ecx
-    xor edx, edx
-    mov r8, qwFileSize
-    xor r9d, r9d
-    mov rcx, hFile
-    call CreateFileMappingA
-    test rax, rax
-    jz @@error_close
-    mov hMapping, rax
-    
-    xor ecx, ecx
-    xor edx, edx
-    xor r8d, r8d
-    mov r9, qwFileSize
-    mov rcx, hMapping
-    call MapViewOfFile
-    test rax, rax
-    jz @@error_map
-    mov pFileBuffer, rax
-    
-    mov rcx, hMapping
