-    movzx eax, BYTE PTR [pCode+1]
-    cmp al, 0xB8
-    jb @@unknown
-    
-    mov rcx, pOutput
-    mov rdx, OFFSET szMov
-    call lstrcpyA
-    mov eax, 10         ; mov rax, imm64 = 10 bytes
-    ret
-    
-@@unknown:
-    mov rcx, pOutput
-    mov rdx, OFFSET szDb
-    call lstrcpyA
-    mov eax, 1
-    ret
