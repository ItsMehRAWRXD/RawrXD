-ALIGN 16
-slot_used:
-    db MEMORY_SLOT_COUNT dup(0)
-
-; Slot timestamps for LRU eviction
-slot_timestamp:
-    dq MEMORY_SLOT_COUNT dup(0)
-
-; Current timestamp counter
-current_timestamp       dq 0
-
-; Statistics
-mem_store_count         dq 0
-mem_recall_count        dq 0
-mem_eviction_count      dq 0
-
-; ============================================================================
