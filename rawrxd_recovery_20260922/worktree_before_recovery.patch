-    ; RAX = PEB, [RAX+18h] = PEB_LDR_DATA
-    mov rax, [rax + 18h]
-    test rax, rax
-    jz @@fail
-    
-    ; [RAX+20h] = InMemoryOrderModuleList (LIST_ENTRY)
-    lea rbx, [rax + 20h]            ; RBX = ListHead (points to first blink/flink)
-    
-    ; First entry is the EXE itself
