-    mov byte ptr [slot_used + rbx], 1
-    
-    ; Update timestamp
-    inc qword ptr [current_timestamp]
-    mov rax, [current_timestamp]
-    mov [slot_timestamp + rbx * 8], rax
-    
-    ; Compute slot address
-    mov rax, rbx
-    imul rax, MEMORY_SLOT_SIZE
