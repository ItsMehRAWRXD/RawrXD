-    ; 3. Attention scores: Q @ K^T
-    lea     rcx, q_buffer
-    lea     rdx, k_buffer
-    lea     r8, attn_scores
-    mov     r9d, SEQ_LEN
-    mov     eax, SEQ_LEN
