-.q4_0:
-    mov eax, Q4_0_BLOCK_SIZE
-    ret
-.q4_1:
-    mov eax, Q4_1_BLOCK_SIZE
-    ret
-.q8_0:
-    mov eax, Q8_0_BLOCK_SIZE
-    ret
-.f16:
-    mov eax, 2          ; 2 bytes per element
-    ret
-.f32:
-    mov eax, 4          ; 4 bytes per element
