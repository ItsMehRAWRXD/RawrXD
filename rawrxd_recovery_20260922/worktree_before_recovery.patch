-    
-    ; Store key (up to MEMORY_KEY_SIZE)
-    mov rcx, rdi
-    mov rdx, r12
-    mov r8, r13
-    cmp r8, MEMORY_KEY_SIZE
-    jbe @@key_copy_ok
-    mov r8, MEMORY_KEY_SIZE
-@@key_copy_ok:
