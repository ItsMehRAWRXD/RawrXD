-    mov [rsp+28h], rax
-    mov rax, (RECONSTRUCTED_FUNC PTR [pFuncInfo]).ReturnType
-    mov [rsp+30h], rax
-    mov rax, (RECONSTRUCTED_FUNC PTR [pFuncInfo]).FunctionName
-    mov [rsp+38h], rax
