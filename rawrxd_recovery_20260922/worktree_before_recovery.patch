-
-    ; Process each layer
-    xor     r15d, r15d                  ; R15D = layer index
-
-@layer_loop:
-    cmp     r15d, r14d
-    jge     @forward_done
-
-    mov     [current_layer], r15d
-
-    ; === ATTENTION BLOCK ===
-    ; 1. RMSNorm (pre-attention)
-    mov     rcx, r12
-    mov     edx, HIDDEN_SIZE
-    call    RMSNorm_F32
-
-    ; 2. QKV Projections using GEMM
-    mov     rcx, r12                    ; input
-    lea     rdx, layer_q_weights        ; weights
-    mov     r8d, r15d                   ; layer
-    call    Get_Layer_Weights
-    lea     r8, q_buffer
-    mov     r9d, HIDDEN_SIZE
-    mov     eax, HIDDEN_SIZE
