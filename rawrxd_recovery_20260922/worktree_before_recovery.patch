-GetQuantBlockSize PROC PRIVATE
-    cmp ecx, APERTURE_Q4_0
-    je .q4_0
-    cmp ecx, APERTURE_Q4_1
-    je .q4_1
-    cmp ecx, APERTURE_Q8_0
-    je .q8_0
-    cmp ecx, APERTURE_F16
-    je .f16
-    cmp ecx, APERTURE_F32
-    je .f32
