-RunFullAnalysis PROC FRAME
-    ; Phase 1: PE Structure
-    mov rcx, OFFSET szStatusParsing
-    call Print
-    
-    call ParsePEAdvanced
-    test eax, eax
-    jz @@error
-    
-    ; Phase 2: String Analysis
