-; Detect and remove control flow flattening
-RemoveFlattening PROC FRAME pFuncStart:QWORD, dwFuncSize:DWORD
-    LOCAL pCode:QWORD
-    LOCAL dwStateVar:DWORD
-    
-    ; Look for state machine pattern:
-    ; mov eax, [state]
-    ; switch (eax) { ... }
