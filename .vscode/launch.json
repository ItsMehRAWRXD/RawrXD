      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        { "name": "RAWRXD_DEBUG", "value": "1" },
        { "name": "VK_LAYER_PATH", "value": "C:/VulkanSDK/1.3.296.0/Bin" },
