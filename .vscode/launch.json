    {
      "name": "Debug: RawrXD-InferenceEngine (Vulkan)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/Debug/RawrXD-InferenceEngined.exe",
      "args": [
        "--model", "${workspaceFolder}/models/qwen2.5-7b-instruct-q4_k_m.gguf",
        "--backend", "vulkan",
        "--device", "0",
        "--prompt", "Test Vulkan backend",
        "--tokens", "100"
