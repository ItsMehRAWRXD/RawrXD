{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: RawrXD-Win32IDE",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/Debug/RawrXD-Win32IDEd.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        { "name": "RAWRXD_DEBUG", "value": "1" },
        { "name": "RAWRXD_LOG_LEVEL", "value": "DEBUG" }
      ],
      "console": "integratedTerminal",
      "preLaunchTask": "PowerBuild: Debug",
      "symbolSearchPath": "${workspaceFolder}/bin/Debug;${workspaceFolder}/bin/Release;C:\\Windows\\SymbolCache;SRV*C:\\Symbols*https://msdl.microsoft.com/download/symbols",
      "sourceFileMap": {
        "D:\\RawrXD": "${workspaceFolder}",
        "C:\\Program Files\\Microsoft Visual Studio\\2022\\BuildTools\\VC\\Tools\\MSVC\\14.44.35207\\include": "C:/Program Files/Microsoft Visual Studio/2022/BuildTools/VC/Tools/MSVC/14.44.35207/include"
      },
      "visualizerFile": "${workspaceFolder}/.vscode/natvis/rawrxd.natvis"
    },
