// ============================================================================
// RawrXD.rc — Resource Script
// Version info, icons, manifests
// ============================================================================

#include <windows.h>

// ============================================================================
// Version Info
// ============================================================================
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "RawrXD\0"
            VALUE "FileDescription",  "RawrXD Sovereign Runtime\0"
            VALUE "FileVersion",      "1.0.0.0\0"
            VALUE "InternalName",     "RawrXD\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 RawrXD\0"
            VALUE "OriginalFilename", "RawrXD.exe\0"
            VALUE "ProductName",      "RawrXD Sovereign Platform\0"
            VALUE "ProductVersion",   "1.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// ============================================================================
// Application Icon
// ============================================================================
IDI_MAIN_ICON   ICON    "rawrxd.ico"

// ============================================================================
// Application Manifest
// ============================================================================
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "RawrXD.exe.manifest"
