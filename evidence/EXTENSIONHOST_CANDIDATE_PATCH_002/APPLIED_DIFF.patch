+std::string QuoteWindowsArg(const std::string& value) {
+    std::string out = "\"";
+    unsigned slashes = 0;
+    for (char c : value) {
+        if (c == '\\') { ++slashes; continue; }
+        if (c == '"') out.append(slashes * 2 + 1, '\\');
+        else out.append(slashes, '\\');
+        out.push_back(c);
+        slashes = 0;
+    }
+    out.append(slashes * 2, '\\');
+    out.push_back('"');
+    return out;
+}
+}
