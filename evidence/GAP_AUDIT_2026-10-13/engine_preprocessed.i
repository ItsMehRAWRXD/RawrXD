            const unsigned int _Day_of_year = _Day_of_century - ((1461 * _Year_of_century) >> 2); 
            
            const unsigned int _Mp = (535 * _Day_of_year + 333) >> 14; 
            
            const unsigned int _Day   = _Day_of_year - ((979 * _Mp + 19) >> 5) + 1; 
            const unsigned int _Month = _Mp + (_Mp < 10 ? 3 : static_cast<unsigned int>(-9)); 
