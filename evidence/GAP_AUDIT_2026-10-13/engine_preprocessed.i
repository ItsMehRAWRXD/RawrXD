    if (r.rawKv.count("tokenizer.ggml.padding_token_id"))
        (void)ReqKvU32(r, "tokenizer.ggml.padding_token_id", t.PAD_TOKEN_ID, t, "PAD");
    if (t.BOS_TOKEN_ID >= t.VOCAB_SIZE || t.EOS_TOKEN_ID >= t.VOCAB_SIZE) {
