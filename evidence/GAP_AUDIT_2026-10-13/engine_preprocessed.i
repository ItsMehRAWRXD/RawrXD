inline bool ReqKvU32(const Deep2::GGUFLoadResult& r, const char* key, uint32_t& out, TokEogSeal& t,
                     const char* tag) {
    if (!r.rawKv.count(key)) {
        TBlock(t, tag, key, "absent", "missing", "TOKENIZER_TEMPLATE_EOG");
        return false;
    }
    char* e = nullptr;
