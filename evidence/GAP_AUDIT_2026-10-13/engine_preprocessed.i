static void dequantizeQ4_1Block(const block_q4_1* block, float* out) {
    float d = fp16ToFloat(block->d);
    float m = fp16ToFloat(block->m);
    for (int i = 0; i < 16; ++i) {
        uint8_t byte = block->qs[i];
        int lo = byte & 0x0F;
        int hi = (byte >> 4) & 0x0F;
        out[i]      = d * lo + m;
        out[i + 16] = d * hi + m;
    }
}




