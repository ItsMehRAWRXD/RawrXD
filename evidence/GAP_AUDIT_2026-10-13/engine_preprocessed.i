    [[nodiscard]] auto _Make_unique_tzdb_info(_Types&&... _Args) {
        const auto _Raw_ptr = _Get_tzdb_info(::std:: forward<_Types>(_Args)...);

        using _Tzdb_info = remove_pointer_t<decltype(_Raw_ptr)>;

        unique_ptr<_Tzdb_info, _Tzdb_deleter<_Tzdb_info>> _Info{_Raw_ptr};

        if (_Info == nullptr) {
