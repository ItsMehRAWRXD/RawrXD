    d.id = id;
    d.shard = shard;
    d.byteLength = byteLength;
    d.type = type;
    uint64_t absOff = 0;
    if (CheckedAddU64(dataOffset, relOffset, absOff) && byteLength > 0) {
        d.fileOffset = absOff;
        d.addressed = true;
    }
    return d;
}

