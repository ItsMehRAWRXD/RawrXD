        fprintf(o, "DEEP2_GPU_FORWARD_LAYERS=%llu\n", (unsigned long long)c.forwardLayers);
        fprintf(o, "DEEP2_GPU_FORWARD_SLOT_0=%llu\n", (unsigned long long)c.forwardSlot[0]);
