        unpackQ4KScaleMin(block->scales, is, sc0, m0);
        unpackQ4KScaleMin(block->scales, is + 1, sc1, m1);
        const float d1 = d * sc0;
        const float min1 = dmin * m0;
        const float d2 = d * sc1;
        const float min2 = dmin * m1;
