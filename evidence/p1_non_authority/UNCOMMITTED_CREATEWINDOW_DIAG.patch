+// Reverse-engineered createWindow ladder ΓÇö every gate flushed to disk + stderr.
+namespace {
+char g_reLastGate[256] = "G_NONE";
+char g_reLastDetail[512] = "";
+} // namespace
+
+extern "C" void RawrXD_ReManifest(const char* gate, const char* detail)
+{
+    if (!gate)
+        gate = "G_NULL";
+    if (!detail)
+        detail = "";
+    strncpy_s(g_reLastGate, gate, _TRUNCATE);
+    strncpy_s(g_reLastDetail, detail, _TRUNCATE);
+
+    char line[1024];
+    SYSTEMTIME st{};
+    GetLocalTime(&st);
+    _snprintf_s(line, _TRUNCATE, "%02u:%02u:%02u.%03u pid=%lu %s %s\n",
+                (unsigned)st.wHour, (unsigned)st.wMinute, (unsigned)st.wSecond,
+                (unsigned)st.wMilliseconds, (unsigned long)GetCurrentProcessId(), gate, detail);
+    OutputDebugStringA(line);
+    fputs(line, stderr);
+    fflush(stderr);
+    FILE* f = nullptr;
+    fopen_s(&f, "re_createwindow_ladder.log", "a");
+    if (f) {
+        fputs(line, f);
+        fflush(f);
+        fclose(f);
+    }
+    fileTrace(line);
+}
+
+extern "C" const char* RawrXD_ReManifestLastGate(void) { return g_reLastGate; }
+extern "C" const char* RawrXD_ReManifestLastDetail(void) { return g_reLastDetail; }
