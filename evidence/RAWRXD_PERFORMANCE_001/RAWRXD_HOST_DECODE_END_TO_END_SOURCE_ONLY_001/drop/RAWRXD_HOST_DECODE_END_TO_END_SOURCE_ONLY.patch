+
+void MoEWeightProxy::StartHostPrefetchThread() {
+    std::lock_guard<std::mutex> lock(hostPrefetchMutex_);
+    if (hostPrefetchThread_.joinable()) return;
+    hostPrefetchStop_ = false;
+    hostPrefetchThread_ = std::thread(&MoEWeightProxy::HostPrefetchThreadBody, this);
+}
+
+void MoEWeightProxy::StopHostPrefetchThread() {
+    {
+        std::lock_guard<std::mutex> lock(hostPrefetchMutex_);
+        hostPrefetchStop_ = true;
+        hostPrefetchQueue_.clear();
+    }
+    hostPrefetchCv_.notify_all();
+    if (hostPrefetchThread_.joinable()) hostPrefetchThread_.join();
+    {
+        std::lock_guard<std::mutex> lock(hostPrefetchMutex_);
+        hostPrefetchPending_.clear();
+        hostPrefetchStop_ = false;
+    }
+    hostPrefetchCv_.notify_all();
+}
+
+void MoEWeightProxy::HostPrefetchThreadBody() {
+    for (;;) {
+        std::pair<int, int> item{};
+        {
+            std::unique_lock<std::mutex> lock(hostPrefetchMutex_);
+            hostPrefetchCv_.wait(lock, [this] {
+                return hostPrefetchStop_ || !hostPrefetchQueue_.empty();
+            });
+            if (hostPrefetchStop_ && hostPrefetchQueue_.empty()) break;
+            item = hostPrefetchQueue_.front();
+            hostPrefetchQueue_.pop_front();
+        }
+
+        MoEWeightsLoader* loader = nullptr;
+        {
+            std::lock_guard<std::mutex> lock(attachMutex_);
+            loader = loader_;
+        }
+
+        const void* loaded = loader ? loader->LoadExpert(item.first, item.second) : nullptr;
+        {
+            std::lock_guard<std::mutex> lock(hostPrefetchMutex_);
+            hostPrefetchPending_.erase(HostPrefetchKey(item.first, item.second));
+        }
+        if (loaded) {
+            stats_.hostPrefetchCompleted.fetch_add(1, std::memory_order_relaxed);
+        }
+        hostPrefetchCv_.notify_all();
+    }
+}
+
+void MoEWeightProxy::PrefetchHostAsync(int layer,
+                                       const std::vector<int>& expertIds) {
+    std::vector<int> ids = expertIds;
+    MoEEliminate_FilterPrefetch(layer, ids);
+
+    uint64_t submitted = 0;
+    {
+        std::lock_guard<std::mutex> lock(hostPrefetchMutex_);
+        if (hostPrefetchStop_ || !hostPrefetchThread_.joinable()) return;
+        for (int expert : ids) {
+            const uint64_t key = HostPrefetchKey(layer, expert);
+            if (!hostPrefetchPending_.insert(key).second) continue;
+            hostPrefetchQueue_.emplace_back(layer, expert);
+            ++submitted;
+        }
+    }
+    if (submitted) {
+        stats_.hostPrefetchSubmitted.fetch_add(submitted, std::memory_order_relaxed);
+        hostPrefetchCv_.notify_one();
+    }
+}
