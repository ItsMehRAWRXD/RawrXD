#version 450
/* Packed Q2_K GEMV — no full-tensor FP16 materialization */
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) readonly buffer W { uint packed[]; };
layout(set = 0, binding = 1) readonly buffer In { float x[]; };
layout(set = 0, binding = 2) writeonly buffer Out { float y[]; };
layout(push_constant) uniform PC { uint rows; uint cols; uint codec; } pc;

uint u8(uint off) {
    uint w = packed[off >> 2];
    return (w >> ((off & 3u) * 8u)) & 0xFFu;
}
float f16(uint h) { return unpackHalf2x16(h).x; }

void main() {
    uint row = gl_GlobalInvocationID.x;
    if (row >= pc.rows) return;
    /* codec 10 = GGML Q2_K; block = 84 bytes, QK=256 */
    uint nblk = (pc.cols + 255u) / 256u;
    uint rowOff = row * nblk * 84u;
    float sum = 0.0;
    for (uint b = 0u; b < nblk; ++b) {
        uint blk = rowOff + b * 84u;
        float d = f16(u8(blk + 80u) | (u8(blk + 81u) << 8));
        float dm = f16(u8(blk + 82u) | (u8(blk + 83u) << 8));
        uint sc = blk;
        uint q = blk + 16u;
        uint base = b * 256u;
        for (uint g = 0u; g < 16u; ++g) {
            uint sv = u8(sc + g);
            float ds = d * float(sv & 15u);
            float ms = dm * float(sv >> 4);
            uint chunk = g / 8u;
            uint rem = g % 8u;
            uint sh = 2u * (rem / 2u);
            uint sub = rem & 1u;
            for (uint l = 0u; l < 16u; ++l) {
                uint idx = base + g * 16u + l;
                if (idx >= pc.cols) continue;
                uint qb = u8(q + chunk * 32u + sub * 16u + l);
                float qq = float((qb >> sh) & 3u);
                sum += (ds * qq - ms) * x[idx];
            }
        }
    }
    y[row] = sum;
}
