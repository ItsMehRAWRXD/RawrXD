; Deep2 no-dependency ABI constants -- x64 MASM / Windows ABI
option casemap:none

D2DEC_MAGIC              EQU 03244454332443244h ; "2D2ECDB2" opaque magic
D2DEC_VERSION            EQU 00010000h

; D2DecodeCtx byte offsets (all qword unless noted)
D2_CTX_MAGIC             EQU 0
D2_CTX_VERSION           EQU 8      ; dword
D2_CTX_FLAGS             EQU 12     ; dword
D2_CTX_POSITION          EQU 16
D2_CTX_TARGET_TOKENS     EQU 24
D2_CTX_GENERATED         EQU 32
D2_CTX_ERROR             EQU 40     ; dword
D2_CTX_AUTHORITY         EQU 44     ; dword
D2_CTX_EXEC_GENERATION   EQU 48
D2_CTX_FORWARD_CALLS     EQU 56
D2_CTX_SELECT_CALLS      EQU 64
D2_CTX_COMMIT_CALLS      EQU 72
D2_CTX_ADVANCE_CALLS     EQU 80
D2_CTX_FULL_FORWARD_OBS  EQU 88
D2_CTX_TOKEN_SELECT_OBS  EQU 96
D2_CTX_TOKEN_COMMIT_OBS  EQU 104
D2_CTX_STATE_ADVANCE_OBS EQU 112
D2_CTX_USER              EQU 120
D2_CTX_FORWARD_FN        EQU 128
D2_CTX_SELECT_FN         EQU 136
D2_CTX_COMMIT_FN         EQU 144
D2_CTX_ADVANCE_FN        EQU 152
D2_CTX_LOGITS_HANDLE     EQU 160
D2_CTX_VOCAB             EQU 168
D2_CTX_SELECTED_TOKEN    EQU 176
D2_CTX_SELECTED_AUX      EQU 184
D2_CTX_FAIL_STAGE        EQU 192    ; dword
D2_CTX_FAIL_REASON       EQU 196    ; dword
D2_CTX_BLOCK_CURSOR      EQU 200
D2_CTX_BLOCKS_ENTERED    EQU 208
D2_CTX_BLOCKS_COMPLETED  EQU 216
D2_CTX_KV_POSITION       EQU 224
D2_CTX_EXPECTED_POSITION EQU 232
D2_CTX_PROMPT_TOKENS     EQU 240
D2_CTX_PLAN_GENERATION   EQU 248
D2_CTX_TICKET_GENERATION EQU 256
D2_CTX_SIZE              EQU 264

; Config offsets
D2_CFG_USER              EQU 0
D2_CFG_FORWARD_FN        EQU 8
D2_CFG_SELECT_FN         EQU 16
D2_CFG_COMMIT_FN         EQU 24
D2_CFG_ADVANCE_FN        EQU 32
D2_CFG_SIZE              EQU 40

; Authority bits -- only runtime observation may set these
D2_AUTH_FULL_FORWARD     EQU 00000001h
D2_AUTH_TOKEN_SELECTED   EQU 00000002h
D2_AUTH_TOKEN_COMMITTED  EQU 00000004h
D2_AUTH_STATE_ADVANCED   EQU 00000008h
D2_AUTH_FULL_DECODE      EQU 00000010h
D2_AUTH_PERF_050MS       EQU 00000020h

; Errors
D2_ERR_NONE              EQU 0
D2_ERR_BAD_CTX           EQU 1
D2_ERR_BAD_CONFIG        EQU 2
D2_ERR_BAD_TARGET        EQU 3
D2_ERR_BAD_POSITION      EQU 4
D2_ERR_FORWARD_FAILED    EQU 5
D2_ERR_BAD_LOGITS        EQU 6
D2_ERR_SELECT_FAILED     EQU 7
D2_ERR_COMMIT_FAILED     EQU 8
D2_ERR_ADVANCE_FAILED    EQU 9
D2_ERR_FORWARD_UNPROVEN  EQU 10
D2_ERR_AUTH_UNPROVEN     EQU 11

; Forward diagnostic stages
D2_FW_NONE               EQU 0
D2_FW_BAD_USER_CONTEXT   EQU 1
D2_FW_MODEL_GEN_MISMATCH EQU 2
D2_FW_DECODE_GEN_MISMATCH EQU 3
D2_FW_POSITION_MISMATCH  EQU 4
D2_FW_INPUT_NOT_READY    EQU 5
D2_FW_KV_POS_MISMATCH    EQU 6
D2_FW_PLAN_NOT_READY     EQU 7
D2_FW_PLAN_CURSOR_STALE  EQU 8
D2_FW_BLOCK_LOOP_FAIL    EQU 9
D2_FW_FINAL_NORM_FAIL    EQU 10
D2_FW_LM_HEAD_FAIL       EQU 11
D2_FW_LOGITS_EXPORT_FAIL EQU 12
D2_FW_STALE_TICKET       EQU 13

; Gate observation bits used by acceleration ABI wrappers
D2_OBS_FINAL_NORM_LMHEAD EQU 00000001h
D2_OBS_GPU_TOKEN_SELECT  EQU 00000002h
D2_OBS_GPU_ROPE_KV_ATTN  EQU 00000004h
D2_OBS_GPU_MOE_ROUTER    EQU 00000008h
D2_OBS_EXPERT_DISPATCH   EQU 00000010h
D2_OBS_GROUPED_TOP8      EQU 00000020h
D2_OBS_Q4_FUSED_GEMV     EQU 00000040h
D2_OBS_FUSED_NORM_PROJ   EQU 00000080h
D2_OBS_FUSED_RESID_NORM  EQU 00000100h
D2_OBS_ACT_PINGPONG      EQU 00000200h
D2_OBS_PERSISTENT_PLAN   EQU 00000400h
D2_OBS_EXACT_RANGE_NP1   EQU 00000800h
D2_OBS_EXPERT_HOTSET     EQU 00001000h
D2_OBS_FASTPATH          EQU 00002000h

; Generic gate request: caller provides actual product callback.
D2_GATE_CTX              EQU 0
D2_GATE_PAYLOAD          EQU 8
D2_GATE_FN               EQU 16
D2_GATE_OBS_PTR          EQU 24
D2_GATE_SIZE             EQU 32

; Exact range descriptor/ticket
D2_RANGE_REGION_ID       EQU 0
D2_RANGE_SHARD_ID        EQU 8
D2_RANGE_OFFSET          EQU 16
D2_RANGE_BYTES           EQU 24
D2_RANGE_CODEC           EQU 32
D2_RANGE_OWNER_COOKIE    EQU 40
D2_RANGE_GENERATION      EQU 48
D2_RANGE_STATE           EQU 56
D2_RANGE_SIZE            EQU 64

D2_RES_COLD              EQU 0
D2_RES_MG                EQU 1
D2_RES_WARM              EQU 2
D2_RES_HOT               EQU 3

; Expert descriptor: layer/expert + gate/up/down generic range references
D2_EXPERT_LAYER          EQU 0
D2_EXPERT_ID             EQU 8
D2_EXPERT_GATE_PTR       EQU 16
D2_EXPERT_UP_PTR         EQU 24
D2_EXPERT_DOWN_PTR       EQU 32
D2_EXPERT_RES_GEN        EQU 40
D2_EXPERT_SIZE           EQU 48

; Hotset entry
D2_HOT_REGION_ID         EQU 0
D2_HOT_GENERATION        EQU 8
D2_HOT_LAST_USE          EQU 16
D2_HOT_STATE             EQU 24
D2_HOT_SIZE              EQU 32
