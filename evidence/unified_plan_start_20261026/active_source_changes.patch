+    manifest["end_to_end_forward_parity"] = {
+        {"status", "verified"},
+        {"verified_by", "MODEL_GENIE_NATIVE_FORWARD_001 Gate 4"},
+        {"evidence", "evidence/GAP_AUDIT_2026-10-13/GATE4_CERTIFICATION_2026-10-13.md"}
+    };
+    manifest["multi_token_kv_parity"] = {
