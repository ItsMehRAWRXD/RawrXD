    "audit":  {
                  "question":  "what could be reused before new parsing logic was written",
                  "examined":  [
                                   {
                                       "path":  "compilers/native_compiler/tools/recovered_c/c_compiler_minimal.c",
                                       "finding":  "the shape of the solution: a token array driving a recursive descent parser, with a generic node and a child list",
                                       "reusable":  "the architecture only",
                                       "limits":  "the expression grammar handles the addition and the subtraction of two numbers only, and the tree has five node kinds"
                                   },
                                   {
                                       "path":  "the rest of the repository",
                                       "finding":  "no other parser implementation of C exists in the tree",
                                       "reusable":  "nothing",
                                       "limits":  "the AST files under src\\core are for a Rust and a graph engine, not for C"
                                   }
                               ],
                  "conclusion":  "no parsing logic was reusable, so the parser was written against the certified C10 token stream"
              },
    "design":  {
                   "syntax_only":  "the tree records what was written down; the semantic analysis decides what it means",
                   "spans":  "every node carries the file, the byte range, the line and the column it came from",
                   "ownership":  "the nodes live in an arena that the tree owns; a pointer to a node stays valid for as long as the tree does, and nothing is freed while the tree is built",
                   "precedence":  "one table drives the expression grammar, so the precedence and the associativity of every operator live in one place",
                   "declarators":  "a declarator is a chain of constructors, which is what tells an array of pointers apart from a pointer to an array",
                   "recovery":  "a syntax error is reported with its line and its column, and the parser carries on so that the rest of the file is still parsed"
               },
