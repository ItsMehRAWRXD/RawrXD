    "defects_found":  [
                          {
                              "where":  "the token stream",
                              "defect":  "the stream holds no end of file token, because the lexer stops when the input ends",
                              "effect":  "every loop that waited for an end of file token waited for ever, and a missing brace hung the parser",
                              "fix":  "the parser tests the end of the stream itself"
                          },
                          {
                              "where":  "the tree printer",
                              "defect":  "the printer wrote the node and never walked its children",
                              "effect":  "every tree came out as a single line",
                              "fix":  "the printer walks the children of a node after writing it"
                          },
                          {
                              "where":  "the declarator",
                              "defect":  "the prefix pointers of a declarator were read and thrown away",
                              "effect":  "int *p and int p produced the same tree, and an array of pointers could not be told from a pointer to an array",
                              "fix":  "each pointer is a step of the declarator chain, and the order of the steps is the order the type is built"
                          },
                          {
                              "where":  "the parameter list",
                              "defect":  "a parameter without a name, as in int f(void), was an error",
                              "effect":  "the common shape of a function that takes nothing was rejected",
                              "fix":  "the name of a parameter is optional"
                          }
                      ],
