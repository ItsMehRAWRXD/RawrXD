    "assembler_defects_fixed":  [
                                    {
                                        "id":  "A-01",
                                        "title":  "mov r64, imm was truncated",
                                        "file":  "compilers/native_compiler/src/asm/X64Assembler.cpp",
                                        "function":  "EncodeMov",
                                        "cause":  "the B8 form takes a 64 bit immediate, so writing only four bytes of it truncated the instruction and the bytes after it were decoded as part of it",
                                        "fix":  "a 64 bit destination with a sign extendable value uses the C7 /0 form; a larger value uses the full 64 bit immediate",
                                        "regression":  "C07 encodes the 64 bit immediate byte for byte"
                                    },
                                    {
                                        "id":  "A-02",
                                        "title":  "the displacement of an rbp based operand was zeroed",
                                        "file":  "compilers/native_compiler/src/asm/X64Assembler.cpp",
                                        "function":  "EncodeMemory",
                                        "cause":  "the encoder forced mod = 1 and then set the displacement to zero, so [rbp-8] was encoded as [rbp+0] and the operand read or wrote the wrong address",
                                        "fix":  "the displacement is kept; the mod is chosen from its size",
                                        "regression":  "the C07 memory form table covers [rbp]"
                                    },
                                    {
                                        "id":  "A-03",
                                        "title":  "the sign of a memory term was read after the term it belonged to",
                                        "file":  "compilers/native_compiler/src/asm/X64Assembler.cpp",
                                        "function":  "ParseOperand",
                                        "cause":  "the sign was consumed after the term had been processed, so [rbp-8] lost its sign entirely",
                                        "fix":  "the sign is read before the term it belongs to",
                                        "regression":  "the C07 memory form table and the Stage 2 locals cover it"
                                    }
                                ],
