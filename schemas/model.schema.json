{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rawrxd.ai/schemas/model.schema.json",
  "title": "RawrXD Model Configuration Schema",
  "description": "Schema for validating model-specific configuration",
  "type": "object",
  "required": ["name", "format", "architecture"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9]+)?$"
    },
    "format": {
      "type": "string",
      "enum": ["gguf", "ggml", "safetensors", "onnx", "pytorch", "tensorflow"]
    },
    "architecture": {
      "type": "string",
      "enum": ["llama", "llama2", "llama3", "mistral", "mixtral", "qwen", "qwen2", "phi", "phi3", "gemma", "gemma2", "falcon", "gpt2", "gptj", "gptneox", "mpt", "bloom", "starcoder", "starcoder2", "codellama", "deepseek", "command-r", "other"]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "size_bytes"],
        "properties": {
          "path": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        }
      }
    },
    "parameters": {
      "type": "object",
      "properties": {
        "vocab_size": {
          "type": "integer",
          "minimum": 1
        },
        "context_length": {
          "type": "integer",
          "minimum": 1
        },
        "embedding_length": {
          "type": "integer",
          "minimum": 1
        },
        "block_count": {
          "type": "integer",
          "minimum": 1
        },
        "feed_forward_length": {
          "type": "integer",
          "minimum": 1
        },
        "attention_head_count": {
          "type": "integer",
          "minimum": 1
        },
        "attention_head_count_kv": {
          "type": "integer",
          "minimum": 1
        },
        "rope_dimension_count": {
          "type": "integer",
          "minimum": 1
        },
        "rope_freq_base": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "quantization": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["Q4_0", "Q4_1", "Q5_0", "Q5_1", "Q8_0", "Q8_1", "Q2_K", "Q3_K_S", "Q3_K_M", "Q3_K_L", "Q4_K_S", "Q4_K_M", "Q5_K_S", "Q5_K_M", "Q6_K", "Q8_K", "IQ2_XXS", "IQ2_XS", "IQ3_XXS", "IQ3_XS", "IQ3_S", "IQ3_M", "IQ4_XS", "IQ4_NL", "F32", "F16", "BF16", "FP8", "none"]
        },
        "bits": {
          "type": "number",
          "minimum": 1,
          "maximum": 32
        },
        "group_size": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "chat": {
          "type": "boolean",
          "default": true
        },
        "completion": {
          "type": "boolean",
          "default": true
        },
        "embedding": {
          "type": "boolean",
          "default": false
        },
        "function_calling": {
          "type": "boolean",
          "default": false
        },
        "vision": {
          "type": "boolean",
          "default": false
        },
        "tools": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "prompt_template": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
        "assistant": {
          "type": "string"
        },
        "stop_tokens": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
