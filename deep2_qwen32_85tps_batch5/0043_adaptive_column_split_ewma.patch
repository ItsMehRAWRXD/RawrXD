-        return p==o.p&&bytes==o.bytes&&rows==o.rows&&cols==o.cols;
+        return p==o.p&&bytes==o.bytes&&rows==o.rows&&cols==o.cols&&
+               ratioPermille==o.ratioPermille;
     }
 };
