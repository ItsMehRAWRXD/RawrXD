 00001215  48/ 8B CB		    mov  rcx, rbx
 00001218  E8 FFFFF9BF		    call EditorFreeContext
 0000121D			st_fail1:
 0000121D  B8 00000001		    mov  eax, 1
 00001222			st_ret:
 00001222  48/ 83 C4 30		    add  rsp, 48
 00001226  41/ 5D		    pop  r13
 00001228  41/ 5C		    pop  r12
