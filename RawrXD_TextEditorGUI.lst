	   00000000
 000004D9  49/ C7 45 00		    mov  qword ptr [r13 + LIX_COUNT], 1
	   00000001
 000004E1  49/ 8B 4C 24		    mov  rcx, [r12 + BUF_LEN]
	   10
 000004E6  48/ C7 C2		    mov  rdx, 0
	   00000000
 000004ED			lr_scan:
 000004ED  48/ 3B D1		    cmp  rdx, rcx
 000004F0  73 1A		    jae  lr_exit
 000004F2  66| 41/ 83 3C 52	    cmp  word ptr [r10 + rdx*2], 10
	   0A
 000004F8  75 0D		    jne  lr_scannext
 000004FA  49/ 8B 45 00		    mov  rax, [r13 + LIX_COUNT]
 000004FE  49/ 89 14 C3		    mov  qword ptr [r11 + rax*8], rdx
 00000502  49/ 83 45 00		    add  qword ptr [r13 + LIX_COUNT], 1
	   01
 00000507			lr_scannext:
 00000507  48/ FF C2		    inc  rdx
 0000050A  EB E1		    jmp  lr_scan
 0000050C			lr_exit:
 0000050C  B8 00000001		    mov  eax, 1
 00000511  EB 02		    jmp  lr_ret
 00000513			lr_fail:
 00000513  33 C0		    xor  eax, eax
 00000515			lr_ret:
 00000515  48/ 83 C4 40		    add  rsp, 64
 00000519  41/ 5F		    pop  r15
 0000051B  41/ 5E		    pop  r14
 0000051D  41/ 5D		    pop  r13
 0000051F  41/ 5C		    pop  r12
 00000521  5B			    pop  rbx
 00000522  C3			    ret
 00000523			LinesRebuild ENDP

