 000011D6  74 3D		    jz   st_free
 000011D8  49/ 8B 44 24		    mov  rax, [r12 + BUF_LEN]
	   10
 000011DD  48/ 83 F8 08		    cmp  rax, 8
 000011E1  75 32		    jne  st_free                     ; length drift == broken insert

				    ; force an out-of-range caret offset, then require the clamp to fix it
 000011E3  4C/ 8B 6B 28		    mov  r13, [rbx + CTX_CURSOR]
 000011E7  4D/ 85 ED		    test r13, r13
