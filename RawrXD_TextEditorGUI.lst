				; ============================================================================
				; Line index -- the single source of truth for offset <-> (line, col) mapping.
				; Rebuilt on every structural edit so cursor math can never drift out of range.
				; ============================================================================
 000003F6			LinesRebuild PROC
 000003F6  53			    push rbx
 000003F7  41/ 54		    push r12
 000003F9  41/ 55		    push r13
 000003FB  41/ 56		    push r14
 000003FD  41/ 57		    push r15
 000003FF  48/ 83 EC 40		    sub  rsp, 64

 00000403  48/ 85 C9		    test rcx, rcx
 00000406  0F 84 00000107	    jz   lr_fail
 0000040C  48/ 8B D9		    mov  rbx, rcx
 0000040F  4C/ 8B 63 20		    mov  r12, [rbx + CTX_BUF]
 00000413  4D/ 85 E4		    test r12, r12
 00000416  0F 84 000000F7	    jz   lr_fail
 0000041C  4C/ 8B 6B 40		    mov  r13, [rbx + CTX_LINES]
				    ; [H-21] ALWAYS recount from the buffer. The old code reused LIX_COUNT as
				    ; the allocation hint; on a freshly allocated index that is 0, so the
				    ; first newline wrote items[1] into a one-slot array (heap overflow).
 00000420  EB 00		    jmp  lr_write
 00000422			lr_write:
				    ; count lines present in the buffer
 00000422  49/ 8B 44 24		    mov  rax, [r12 + BUF_LEN]
	   10
 00000427  48/ 85 C0		    test rax, rax
 0000042A  74 25		    jz   lr_empty
 0000042C  49/ 8B 3C 24		    mov  rdi, [r12 + BUF_DATA]
 00000430  49/ C7 C6		    mov  r14, 1
	   00000001
 00000437  45/ 33 FF		    xor  r15d, r15d
 0000043A			lr_count:
 0000043A  4C/ 3B F8		    cmp  r15, rax
 0000043D  73 10		    jae  lr_countdone
 0000043F  66| 42/ 83 3C 7F	    cmp  word ptr [rdi + r15*2], 10
	   0A
 00000445  75 03		    jne  lr_countnext
 00000447  49/ FF C6		    inc  r14
 0000044A			lr_countnext:
 0000044A  49/ FF C7		    inc  r15
 0000044D  EB EB		    jmp  lr_count
 0000044F			lr_countdone:
 0000044F  EB 10		    jmp  lr_grow
 00000451			lr_empty:
 00000451  49/ C7 C6		    mov  r14, 1
	   00000001
 00000458  49/ C7 C5		    mov  r13, 0
	   00000000
 0000045F  EB 00		    jmp  lr_grow

 00000461			lr_grow:
 00000461  49/ C7 C7		    mov  r15, 0
	   00000000
 00000468  49/ 8B C6		    mov  rax, r14                      ; required item count
 0000046B			lr_sizeloop:
 0000046B  49/ C7 C7		    mov  r15, 1
	   00000001
 00000472  4C/ 3B F8		    cmp  r15, rax
 00000475  73 05		    jae  lr_sized
 00000477  49/ D1 E7		    shl  r15, 1
 0000047A  EB EF		    jmp  lr_sizeloop
 0000047C			lr_sized:
				    ; allocate index header + items in one block
 0000047C  48/ C7 C1		    mov  rcx, LIX_SIZE
	   00000010
 00000483  49/ 03 CF		    add  rcx, r15
 00000486  49/ 03 CF		    add  rcx, r15                      ; items are qword, so *8 = *2*4
				    ; (items array is 8 bytes wide) -> recompute properly
 00000489  48/ C7 C1		    mov  rcx, LIX_SIZE
	   00000010
 00000490  4A/ 8D 14 FD		    lea  rdx, [r15*8]
	   00000000
 00000498  48/ 03 CA		    add  rcx, rdx
 0000049B  E8 FFFFFB73		    call MemAlloc
 000004A0  48/ 85 C0		    test rax, rax
 000004A3  74 6E		    jz   lr_fail
 000004A5  4C/ 8B E8		    mov  r13, rax

				    ; [H-07] release the previous index exactly once
 000004A8  48/ 8B 4B 40		    mov  rcx, [rbx + CTX_LINES]
 000004AC  48/ 85 C9		    test rcx, rcx
 000004AF  74 05		    jz   lr_store
 000004B1  E8 FFFFFC0E		    call MemFree
 000004B6			lr_store:
 000004B6  4C/ 89 6B 40		    mov  [rbx + CTX_LINES], r13
 000004BA  49/ C7 45 00		    mov  qword ptr [r13 + LIX_COUNT], 0
	   00000000
 000004C2  49/ 8B 04 24		    mov  rax, [r12 + BUF_DATA]
 000004C6  4C/ 8B D0		    mov  r10, rax
 000004C9  4D/ 85 D2		    test r10, r10
 000004CC  74 45		    jz   lr_fail
 000004CE  4D/ 8D 5D 08		    lea  r11, [r13 + LIX_ITEMS]
