+static void UpdateStatusBarLineCol(HWND hEdit) {
+    if (!g_hStatusBar || !hEdit) return;
+    CHARRANGE cr;
+    SendMessageW(hEdit, EM_EXGETSEL, 0, (LPARAM)&cr);
+    int line = (int)SendMessageW(hEdit, EM_LINEFROMCHAR, cr.cpMin, 0) + 1;
+    int col = cr.cpMin - (int)SendMessageW(hEdit, EM_LINEINDEX, -1, 0) + 1;
+    wchar_t buf[64];
+    swprintf(buf, 64, L"Ln %d, Col %d", line, col);
+    StatusBarSetText(1, buf);
+}
+
+static void SaveTabByIndex(int index) {
+    if (index < 0 || index >= g_nTabCount) return;
+    if (g_Tabs[index].bUntitled || !g_Tabs[index].hEdit) return;
+    FILE* f = _wfopen(g_Tabs[index].szFilePath, L"wb");
+    if (!f) return;
+    int len = GetWindowTextLengthW(g_Tabs[index].hEdit);
+    wchar_t* wcontent = (wchar_t*)malloc((len + 1) * sizeof(wchar_t));
+    if (!wcontent) { fclose(f); return; }
+    GetWindowTextW(g_Tabs[index].hEdit, wcontent, len + 1);
+    int utf8len = WideCharToMultiByte(CP_UTF8, 0, wcontent, -1, NULL, 0, NULL, NULL);
+    char* content = (char*)malloc(utf8len);
+    if (!content) { free(wcontent); fclose(f); return; }
+    WideCharToMultiByte(CP_UTF8, 0, wcontent, -1, content, utf8len, NULL, NULL);
+    fwrite(content, 1, utf8len - 1, f);
+    fclose(f);
+    free(wcontent);
+    free(content);
+    g_Tabs[index].bModified = FALSE;
+}
+
+static void AppendRichText(HWND hRich, const wchar_t* text, COLORREF color) {
+    // Move to end
+    int len = GetWindowTextLengthW(hRich);
+    SendMessageW(hRich, EM_SETSEL, len, len);
+    
+    // Set color
+    CHARFORMAT2W cfAppend;
+    ZeroMemory(&cfAppend, sizeof(cfAppend));
+    cfAppend.cbSize = sizeof(cfAppend);
+    cfAppend.dwMask = CFM_COLOR;
+    cfAppend.crTextColor = color;
+    SendMessageW(hRich, EM_SETCHARFORMAT, SCF_SELECTION, (LPARAM)&cfAppend);
+    
+    // Insert text
+    SendMessageW(hRich, EM_REPLACESEL, FALSE, (LPARAM)text);
+    
+    // Scroll to end
+    SendMessageW(hRich, WM_VSCROLL, SB_BOTTOM, 0);
 }
 
