+    
+    // Get path from item
+    TVITEMW item = { 0 };
+    item.mask = TVIF_PARAM;
+    item.hItem = hItem;
+    TreeView_GetItem(hTree, &item);
+    
+    wchar_t* path = (wchar_t*)item.lParam;
+    if (path) {
+        PopulateTreeView(hTree, path, hItem);
+    }
 }
 
