+        do {
+            if (wcscmp(fd.cFileName, L".") == 0 || wcscmp(fd.cFileName, L"..") == 0)
+                continue;
+            
+            wchar_t fullPath[MAX_PATH];
+            swprintf(fullPath, MAX_PATH, L"%s%s%s", path, 
+                path[wcslen(path)-1] == L'\\' ? L"" : L"\\", fd.cFileName);
