+static void SaveTabByIndex(int index) {
+    if (index < 0 || index >= g_nTabCount) return;
+    if (g_Tabs[index].bUntitled || !g_Tabs[index].hEdit) return;
+    FILE* f = _wfopen(g_Tabs[index].szFilePath, L"wb");
+    if (!f) return;
+    int len = GetWindowTextLengthW(g_Tabs[index].hEdit);
+    wchar_t* wcontent = (wchar_t*)malloc((len + 1) * sizeof(wchar_t));
+    if (!wcontent) { fclose(f); return; }
+    GetWindowTextW(g_Tabs[index].hEdit, wcontent, len + 1);
+    int utf8len = WideCharToMultiByte(CP_UTF8, 0, wcontent, -1, NULL, 0, NULL, NULL);
+    char* content = (char*)malloc(utf8len);
+    if (!content) { free(wcontent); fclose(f); return; }
+    WideCharToMultiByte(CP_UTF8, 0, wcontent, -1, content, utf8len, NULL, NULL);
+    fwrite(content, 1, utf8len - 1, f);
+    fclose(f);
+    free(wcontent);
+    free(content);
+    g_Tabs[index].bModified = FALSE;
+}
