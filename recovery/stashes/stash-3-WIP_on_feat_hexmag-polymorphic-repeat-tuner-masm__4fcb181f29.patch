+    void SaveStep(const std::string& step_dir) {
+        if (!enabled) return;
+        
+        // Create step directory
+        std::fprintf(stderr, "[DIFF] SaveStep called for %s\n", step_dir.c_str());
+        DWORD result = CreateDirectoryA(step_dir.c_str(), NULL);
+        if (result == 0 && GetLastError() != ERROR_ALREADY_EXISTS) {
+            std::fprintf(stderr, "[DIFF] Failed to create step directory: %s (error %lu)\n", 
+                         step_dir.c_str(), GetLastError());
+            return;
+        }
+        std::fprintf(stderr, "[DIFF] Step directory created: %s\n", step_dir.c_str());
+        
+        // Save records to step directory (use records vector directly but with step_dir as output_dir)
+        std::string old_output_dir = output_dir;
+        output_dir = step_dir;
+        SaveAll();
+        output_dir = old_output_dir;
+        
+        // Clear records after saving
+        records.clear();
+        
+        std::fprintf(stderr, "[DIFF] Step saved to %s, records cleared\n", step_dir.c_str());
