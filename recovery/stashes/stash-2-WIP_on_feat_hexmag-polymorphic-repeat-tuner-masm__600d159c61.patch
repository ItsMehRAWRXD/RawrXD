@@ -181,6 +181,28 @@ add_executable(RawrXDCore_Test test_main.cpp)
 target_link_libraries(RawrXDCore_Test PRIVATE RawrXDCore)
 target_include_directories(RawrXDCore_Test PRIVATE ${CMAKE_CURRENT_BINARY_DIR})
 
+# DEEP2_RUNTIME_OWNERSHIP_001: the legacy Deep2_* C ABI is now a thin client of
+# the certified ModelGenie runtime (ModelGenieRuntime), so building it can no
+# longer introduce a second inference engine. It links the authority directly
+# rather than the DLL, which keeps the certified DLL's binary untouched.
+add_library(Deep2InferenceAdapter STATIC Deep2InferenceAdapter.cpp)
+target_link_libraries(Deep2InferenceAdapter PRIVATE ModelGenieRuntime)
+target_include_directories(Deep2InferenceAdapter PRIVATE
+    ${CMAKE_CURRENT_SOURCE_DIR}
+    ${RAWRXD_SOURCE_DIR}/include
+)
+set_target_properties(Deep2InferenceAdapter PROPERTIES CXX_STANDARD 20)
+
+# Ownership proof: drives the adapter ABI against the authority and asserts
+# that the numbers are the authority's, not a second engine's.
+add_executable(Deep2OwnershipTest ownership_test.cpp)
+target_link_libraries(Deep2OwnershipTest PRIVATE Deep2InferenceAdapter)
+target_include_directories(Deep2OwnershipTest PRIVATE
+    ${CMAKE_CURRENT_SOURCE_DIR}
+    ${RAWRXD_SOURCE_DIR}/include
+)
+set_target_properties(Deep2OwnershipTest PROPERTIES CXX_STANDARD 20)
+
 # Set test executable properties
 set_target_properties(RawrXDCore_Test PROPERTIES
     RUNTIME_OUTPUT_DIRECTORY_DEBUG "${CMAKE_BINARY_DIR}/bin/Debug"
