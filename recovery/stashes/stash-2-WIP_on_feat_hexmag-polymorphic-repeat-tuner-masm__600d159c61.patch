+    // mathematically but rounds every element, which measures 2.8e-3 off on a
+    // real q4_K matmul (512 -> 4096, layer 0 attn_kv_b) where this order agrees
+    // with llama.cpp to 1e-8. The activation scale is kept in f32: the
+    // reference build this is measured against does not round it to fp16.
+    //-------------------------------------------------------------------------
+    static constexpr int kQK_K = 256;
