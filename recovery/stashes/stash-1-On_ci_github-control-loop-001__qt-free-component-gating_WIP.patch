+# Strict GPU build contract.
+#
+# ENABLE_VULKAN defaults to ON but is deliberately non-fatal when the SDK is
+# absent, so dependency-free builds still configure. That means a build can
+# silently end up with VulkanCompute using the local stub header, which
+# declares only opaque handles and makes src/vulkan_compute.cpp uncompilable.
+#
+# When GPU support is explicitly required, that silent degradation must not
+# happen: set RAWXXD_REQUIRE_VULKAN=ON and configuration fails instead.
+option(RAWXXD_REQUIRE_VULKAN
+       "Fail configuration if a real Vulkan SDK cannot be used" OFF)
+
 # Try to find Vulkan (Cross-platform)
 if(ENABLE_VULKAN)
     find_package(Vulkan QUIET)
@@ -364,24 +376,40 @@ if(ENABLE_VULKAN)
         if(NOT _rawrxd_vk_inc)
             set(_rawrxd_vk_inc "${Vulkan_INCLUDE_DIR}")
         endif()
+
+        set(_rawrxd_vk_hdr "")
         if(_rawrxd_vk_inc)
             file(TO_CMAKE_PATH "${_rawrxd_vk_inc}" _rawrxd_vk_inc)
             set(_rawrxd_vk_hdr "${_rawrxd_vk_inc}/vulkan/vulkan.h")
-            if(EXISTS "${_rawrxd_vk_hdr}")
-                # BEFORE so the real SDK header is selected rather than the
-                # local stub. It also puts vk_video/ on the search path, which
-                # vulkan_core.h needs for its transitive includes.
-                include_directories(BEFORE SYSTEM "${_rawrxd_vk_inc}")
-                add_compile_definitions(
-                    RAWXRD_VULKAN_SDK_HEADER="${_rawrxd_vk_hdr}")
-                message(STATUS "Vulkan header: ${_rawrxd_vk_hdr}")
-            else()
-                message(WARNING "Vulkan found but header not located at ${_rawrxd_vk_hdr}; the local stub will be used and real GPU code will not compile")
+        endif()
+
+        if(_rawrxd_vk_hdr AND EXISTS "${_rawrxd_vk_hdr}")
+            # BEFORE so the real SDK header is selected rather than the local
+            # stub. It also puts vk_video/ on the search path, which
+            # vulkan_core.h needs for its transitive includes.
+            include_directories(BEFORE SYSTEM "${_rawrxd_vk_inc}")
+            add_compile_definitions(
+                RAWXRD_VULKAN_SDK_HEADER="${_rawrxd_vk_hdr}")
+            message(STATUS "Vulkan header: ${_rawrxd_vk_hdr}")
+        else()
+            if(RAWXXD_REQUIRE_VULKAN)
+                message(FATAL_ERROR
+                    "RAWXXD_REQUIRE_VULKAN is ON but the Vulkan SDK header was "
+                    "not located (looked for '${_rawrxd_vk_hdr}'). Refusing to "
+                    "configure: the local stub header would silently produce a "
+                    "CPU-only build.")
             endif()
+            message(WARNING "Vulkan found but header not located; the local stub will be used and real GPU code will not compile")
         endif()
 
         set(GPU_BACKEND_LIBS ${GPU_BACKEND_LIBS} Vulkan::Vulkan)
     else()
+        if(RAWXXD_REQUIRE_VULKAN)
+            message(FATAL_ERROR
+                "RAWXXD_REQUIRE_VULKAN is ON but no Vulkan SDK was found. "
+                "Refusing to configure: this would silently produce a CPU-only "
+                "build.")
+        endif()
         message(STATUS "Vulkan not found - Vulkan Compute support disabled")
     endif()
 endif()
