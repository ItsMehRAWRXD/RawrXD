-    
-    void** obj = &m_workspaceSettings;
-    for (int i = 0; i < parts.size() - 1; ++i) {
-        if (!obj->contains(parts[i])) {
-            obj->insert(parts[i], void*());
-        }
-        QJsonValueRef ref = (*obj)[parts[i]];
-        if (!ref.isObject()) {
-            ref = void*();
