-                                // to avoid adding an empty block every time a
-                                // gzip stream is normalized.
-                                num = prev;
-                                buf &= last - 1;    // zero the pad bits
-                            }
-                        }
-                        else if (((buf >> prev) & 6) == 0) {
-                            // This is a stored block. Flush to the next
-                            // byte boundary after the three-bit header.
-                            num = (prev + 10) & ~7;
-                            buf &= last - 1;        // zero the pad bits
