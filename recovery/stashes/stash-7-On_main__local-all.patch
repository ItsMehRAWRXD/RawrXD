-        // Skip empty lines and comments
-        if (line.empty() || line.startsWith("//") || line.startsWith("#") || line.startsWith("/*")) {
-            continue;
-        }
-        
-        ControlFlowNode node;
-        node.id = nodeId++;
-        node.lineNumber = i + 1;
-        
-        // Identify node type
-        if (line.contains("if ") || line.contains("if(")) {
