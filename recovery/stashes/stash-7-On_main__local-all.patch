-    // Local labels (.label)
-    std::regex localLabelExpr("\\.[a-zA-Z_][a-zA-Z0-9_]*");
-    std::sregex_iterator localIt = localLabelExpr;
-    while (localItfalse) {
-        std::smatch match = localIt;
