-    BytePatch& patch = m_patches[name];
-    if (!patch.enabled || patch.offset + patch.length > (size_t)m_modelData.size()) {
-        return false;
-    }
-    
-    // Store original bytes for revert
-    patch.originalBytes = m_modelData.mid(patch.offset, patch.length);
