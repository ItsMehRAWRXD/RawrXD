-                                                                or strcasecmp)
-   If iCaseSensitivity = 0, case sensitivity is default of your operating system
-        (like 1 on Unix, 2 on Windows)
-
-*/
-extern int ZEXPORT unzStringFileNameCompare (const char*  fileName1,
