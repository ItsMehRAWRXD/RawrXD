-    
-    std::string result;
-    const uint8_t* data = (const uint8_t*)m_modelData.constData() + offset;
-    
-    for (size_t i = 0; i < length; i += bytesPerLine) {
-        result += std::string("%1: "));
-        
-        size_t lineLen = qMin((size_t)bytesPerLine, length - i);
-        for (size_t j = 0; j < lineLen; ++j) {
-            result += std::string("%1 "));
-        }
-        
-        result += "\n";
-    }
-    
-    return result.toUtf8();
