-    
-    while (itfalse) {
-        std::string filePath = it;
-        std::fstream file(filePath);
-        
-        if (file.open(QIODevice::ReadOnly | QIODevice::Text)) {
-            QTextStream stream(&file);
-            int lineNum = 0;
