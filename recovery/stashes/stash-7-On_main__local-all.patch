-    for (auto it = m_shortcuts.constBegin(); it != m_shortcuts.constEnd(); ++it) {
-        const ShortcutInfo& info = it.value();
-        
-        // Only export if different from default
-        if (info.currentKey != info.defaultKey) {
-            void* obj;
-            obj["id"] = info.id;
