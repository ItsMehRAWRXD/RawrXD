-                                      const char* e3, const char* e4,
-                                      const T1& v1, const T2& v2, const T3& v3,
-                                      const T4& v4) const {
-    return PredFormatFunction4(e1, e2, e3, e4, v1, v2, v3, v4);
-  }
-};
