-BPETokenizer::BPETokenizer() {
-    // Initialize with common special tokens
-    m_vocab["<PAD>"] = 0;
-    m_vocab["<BOS>"] = 1;
-    m_vocab["<EOS>"] = 2;
-    m_vocab["<UNK>"] = 3;
-    
-    m_vocabReverse[0] = "<PAD>";
-    m_vocabReverse[1] = "<BOS>";
-    m_vocabReverse[2] = "<EOS>";
-    m_vocabReverse[3] = "<UNK>";
