-        if (line.contains("if") || line.contains("else")) {
-            ControlFlowNode node;
-            node.id = nodeId++;
-            node.type = "branch";
-            node.description = line.trimmed();
-            nodes.append(node);
-        } else if (line.contains("for") || line.contains("while")) {
-            ControlFlowNode node;
-            node.id = nodeId++;
-            node.type = "loop";
-            node.description = line.trimmed();
