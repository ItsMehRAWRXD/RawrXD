-    if (GTEST_KILLED_BY_SIGNAL_OVERRIDE_(signum_, exit_status, &result)) {
-      return result;
-    }
-  }
-#endif  // defined(GTEST_KILLED_BY_SIGNAL_OVERRIDE_)
