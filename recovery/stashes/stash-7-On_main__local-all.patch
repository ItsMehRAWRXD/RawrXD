-        GetCapturedStdout().c_str(),
-        ContainsRegex(severity == kWarning
-                          ? "^\nGMOCK WARNING:\nTest log\\.\nStack trace:\n"
-                          : "^\nTest log\\.\nStack trace:\n"));
