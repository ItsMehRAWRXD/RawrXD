-        int actualLength = static_cast<int>(SendMessage(m_editorHwnd, EM_GETLINE, lineNum, 
-                                                       reinterpret_cast<LPARAM>(lineBuffer.data())));
-        
-        if (actualLength > 0) {
-            std::string lineText(lineBuffer.data(), actualLength);
