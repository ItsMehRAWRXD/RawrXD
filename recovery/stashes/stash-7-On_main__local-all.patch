-  // Success cases.
-  EXPECT_PRED1(IsEvenFunctor(), 2) << "This failure is UNEXPECTED!";
-  ASSERT_PRED1(IsEven, 4);
-
-  // Failure cases.
-  EXPECT_NONFATAL_FAILURE(
-      {  // NOLINT
-        EXPECT_PRED1(IsEven, 5) << "This failure is expected.";
