-
-# The help message must match this regex.
-HELP_REGEX = re.compile(
-    FLAG_PREFIX
-    + r'list_tests.*'
-    + FLAG_PREFIX
-    + r'filter=.*'
-    + FLAG_PREFIX
-    + r'also_run_disabled_tests.*'
-    + FLAG_PREFIX
-    + r'repeat=.*'
-    + FLAG_PREFIX
-    + r'shuffle.*'
-    + FLAG_PREFIX
-    + r'random_seed=.*'
-    + FLAG_PREFIX
-    + r'color=.*'
-    + FLAG_PREFIX
-    + r'brief.*'
-    + FLAG_PREFIX
-    + r'print_time.*'
-    + FLAG_PREFIX
-    + r'output=.*'
-    + FLAG_PREFIX
-    + r'break_on_failure.*'
-    + FLAG_PREFIX
-    + r'throw_on_failure.*'
-    + FLAG_PREFIX
-    + r'catch_exceptions=0.*',
-    re.DOTALL,
-)
