-        saveAllDirtyTabs();
-        DestroyWindow(m_hwnd);
-        break;
-
-    // ========== EDIT COMMANDS ==========
-    case IDM_EDIT_UNDO:
-        performUndo();
-        break;
-    case IDM_EDIT_REDO:
-        performRedo();
-        break;
-    case IDM_EDIT_CUT:
