-            compiler: gcc
-
-          # Test out of source builds
-          - name: Ubuntu GCC OSB
-            os: ubuntu-latest
-            compiler: gcc
-            build-dir: ../build
-            src-dir: ../zlib
-
-          - name: Ubuntu GCC -O3
-            os: ubuntu-latest
-            compiler: gcc
-            cflags: -O3
-
-          - name: Ubuntu Clang
