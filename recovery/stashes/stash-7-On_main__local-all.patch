-    bitShift = bitShift % 8;
-    
-    for (size_t i = 0; i < size; ++i) {
-        uint8_t* byte = (uint8_t*)(m_modelData.data() + offset + i);
-        if (leftShift) {
-            *byte = (*byte << bitShift) | (*byte >> (8 - bitShift));
