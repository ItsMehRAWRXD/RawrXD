-void GGUFServer::stop() {
-    if (!m_isRunning) {
-        return;
-    }
-    
-    // Don't use std::lock_guard<std::mutex> here - it can deadlock during shutdown
-    m_mutex.lock();
-    bool wasRunning = m_isRunning;
-    m_isRunning = false;
-    m_mutex.unlock();
-    
-    if (!wasRunning) {
-        return;
