-TEST(ThrowActionTest, Times0) {
-  EXPECT_NONFATAL_FAILURE(
-      [] {
-        try {
-          MockObject m;
-          ON_CALL(m, Func()).WillByDefault([] { throw "something"; });
-          EXPECT_CALL(m, Func()).Times(0);
-          m.Func();
-        } catch (...) {
-          // Exception is caught but Times(0) still triggers a failure.
-        }
-      }(),
-      "");
-}
-
