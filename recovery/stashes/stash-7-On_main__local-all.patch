-    
-    std::string result = templateStr;
-    for (auto it = parameters.begin(); it != parameters.end(); ++it) {
-        std::string placeholder = "{" + it.key() + "}";
-        result.replace(placeholder, it.value());
-    }
-    return result;
-}
