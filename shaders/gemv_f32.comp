#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// Row-major GEMV: y[rows] = W[rows][cols] * x[cols]
layout(set = 0, binding = 0, std430) buffer WBuf { float W[]; };
layout(set = 0, binding = 1, std430) buffer XBuf { float x[]; };
layout(set = 0, binding = 2, std430) buffer YBuf { float y[]; };

layout(push_constant) uniform push_const {
    uint rows;
    uint cols;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.rows) return;
    float acc = 0.0f;
    for (uint k = 0; k < pc.cols; ++k) {
        acc += W[i * pc.cols + k] * x[k];
    }
    y[i] = acc;
}
