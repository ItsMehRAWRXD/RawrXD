#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// Q2_K quantized matrix-vector multiplication: y = dequantize(W) @ x
//
// The block layout is the one ggml uses and the one the CPU dequantizer in
// src/quant_kernels.cpp implements. A block_q2_K is 84 bytes:
//
//   scales[16]  @ 0    the super-block scales
//   qs[64]      @ 16   256 values, 2 bits each
//   d           @ 80   fp16
//   dmin        @ 82   fp16
//
// A value is reconstructed as
//
//   value = d * (sc & 0xF) * q - dmin * (sc >> 4)
//
// where sc is the scale byte for the value's sub-block. That byte carries a
// 4-bit scale in the low nibble and a 4-bit minimum in the high nibble, so
// the quantisation is affine rather than symmetric, and the minimum term is
// not optional: dropping it changes every value.
//
// The 256 values of a block are laid out as two halves of 128. Each half is
// four groups of 32 values, and each group is two sub-blocks of 16. The
// group index picks which 2-bit field inside the quant byte holds the
// value, and the sub-block index picks which of the group's two scale bytes
// applies.
//
// The previous version of this shader read the scales from offset 64 and
// the quants from offset 0, used a symmetric (q - 1.5) * scale * d
// reconstruction with no minimum term, and took the first value of a byte
// from the high bits. Every one of those was wrong. The parity gate in
// rom_audit (q2k-parity) is what catches it.

layout(push_constant) uniform push_const {
    uint num_rows;
    uint num_cols;
    uint block_size;
    uint pad0;
} pc;

layout(set = 0, binding = 0, std430) readonly buffer WeightBuffer { uint w[]; } weights;
layout(set = 0, binding = 1, std430) readonly buffer InputBuffer { float x[]; } inBuf;
layout(set = 0, binding = 2, std430) writeonly buffer OutputBuffer { float y[]; } outBuf;

// The block being decoded.
//
// 84 bytes is 21 words, and a block always starts on a word boundary, so the
// whole block is read with 21 aligned word loads rather than one load per
// byte.
uint g_block[21];

uint block_byte(uint off) {
    return (g_block[off >> 2] >> ((off & 3u) * 8u)) & 0xFFu;
}

// fp16 to fp32, without depending on the shaderFloat16 feature.
float fp16_to_f32(uint h) {
    const uint sign = (h & 0x8000u) << 16;
    const uint exp = (h & 0x7C00u) >> 10;
    const uint frac = h & 0x03FFu;

    if (exp == 0x1Fu) {
        // Infinity or NaN.
        return uintBitsToFloat(sign | 0x7F800000u | (frac << 13));
    }
    if (exp == 0u) {
        if (frac == 0u) return uintBitsToFloat(sign);
        // Subnormal. Shift the mantissa up until the hidden bit appears and
        // adjust the exponent to match.
        int e = -1;
        uint f = frac;
        while ((f & 0x0400u) == 0u) { f <<= 1; e--; }
        e++;
        f &= 0x03FFu;
        return uintBitsToFloat(sign | (uint(e + 112) << 23) | (f << 13));
    }
    return uintBitsToFloat(sign | ((exp + 112u) << 23) | (frac << 13));
}

void main() {
    const uint row = gl_GlobalInvocationID.x;
    if (row >= pc.num_rows) return;

    // The column count has to be a whole number of blocks, otherwise the
    // last block of a row would not be a block. The host side rejects a
    // shape that does not satisfy this.
    const uint blocks_per_row = pc.num_cols / pc.block_size;

    float acc = 0.0f;

    for (uint b = 0; b < blocks_per_row; ++b) {
        const uint block_idx = row * blocks_per_row + b;
        const uint word_base = (block_idx * 84u) >> 2;
        for (uint w = 0; w < 21u; ++w) {
            g_block[w] = weights.w[word_base + w];
        }

        const float d = fp16_to_f32(uint(block_byte(80u)) | (uint(block_byte(81u)) << 8));
        const float dmin = fp16_to_f32(uint(block_byte(82u)) | (uint(block_byte(83u)) << 8));

        const uint base_col = b * pc.block_size;

        for (uint halfIdx = 0; halfIdx < 2u; ++halfIdx) {
            for (uint j = 0; j < 4u; ++j) {
                const uint shift = j * 2u;
                for (uint sub = 0; sub < 2u; ++sub) {
                    const uint sc = block_byte(halfIdx * 8u + j * 2u + sub);
                    const float dl = d * float(sc & 0x0Fu);
                    const float ml = dmin * float(sc >> 4u);
                    const uint qbase = 16u + halfIdx * 32u + sub * 16u;
                    for (uint l = 0; l < 16u; ++l) {
                        const uint q = (block_byte(qbase + l) >> shift) & 3u;
                        const uint col = base_col + halfIdx * 128u + j * 32u + sub * 16u + l;
                        acc += (dl * float(q) - ml) * inBuf.x[col];
                    }
                }
            }
        }
    }

    outBuf.y[row] = acc;
}
