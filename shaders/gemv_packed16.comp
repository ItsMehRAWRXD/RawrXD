#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer WeightWords { uint words[]; } weights;
layout(set = 0, binding = 1, std430) readonly buffer InputValues { float values[]; } inputData;
layout(set = 0, binding = 2, std430) writeonly buffer OutputValues { float values[]; } outputData;

layout(push_constant) uniform Parameters {
    uint rows;
    uint cols;
    uint weightEncoding; // 0=F32 bit pattern, 1=IEEE F16, 2=BF16
} params;

float loadWeight(uint index) {
    if (params.weightEncoding == 0u) {
        return uintBitsToFloat(weights.words[index]);
    }
    uint packed = weights.words[index >> 1u];
    uint halfBits = ((index & 1u) == 0u) ? (packed & 0xffffu) : (packed >> 16u);
    if (params.weightEncoding == 1u) {
        return unpackHalf2x16(packed)[index & 1u];
    }
    return uintBitsToFloat(halfBits << 16u);
}

void main() {
    uint row = gl_GlobalInvocationID.x;
    if (row >= params.rows) return;
    float sum = 0.0;
    uint base = row * params.cols;
    for (uint col = 0u; col < params.cols; ++col) {
        sum += loadWeight(base + col) * inputData.values[col];
    }
    outputData.values[row] = sum;
}
