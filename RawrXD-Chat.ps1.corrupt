function Start-OllamaHealthMonitoring {
    if ($script:OllamaHealthMonitor) {
        $script:OllamaHealthMonitor.Stop()($server.BaseURL)/api/generate"
        $script:OllamaHealthMonitor.Dispose()($server.SecureURL)/api/generate"
