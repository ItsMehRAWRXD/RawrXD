// ============================================================================
// RawrXD-Win32IDE.rc
// RAWRXD_WIN32IDE_RESOURCE_001
//
// This file was a one-line "// STUB:" placeholder that was nevertheless wired
// into the live RawrXD-Win32IDE target. A stub resource script still compiles,
// so the defect was invisible: the shipping binary simply had no application
// manifest, no icon, and no version metadata.
//
// Four defects followed from that:
//   1. No manifest -> no requestedExecutionLevel, so the IDE could not declare
//      asInvoker explicitly and received no virtualization redirect.
//   2. No DPI declaration -> Windows applied DPI virtualization. At 150% the
//      whole IDE rendered bitmap-scaled and blurry, and the custom editor's
//      mouse hit-test in Win32IDE_EditorEngine.cpp computes logical pixel
//      coordinates, so the caret landed away from where the user clicked.
//   3. No icon -> generic executable icon in Explorer and the taskbar.
//   4. No VERSIONINFO -> no file version, product name, or company metadata.
//
// Resource ID 1 (RT_MANIFEST) and ID 2 (RT_GROUP_ICON) must not be changed:
// the manifest is looked up by resource id 1 regardless of its internal name.
// ============================================================================

#include <windows.h>

// RAWRXD_APP_VERSION is the single source of truth for the version, so the
// manifest identity and the VERSIONINFO block cannot drift apart.
#ifndef RAWRXD_APP_VERSION_MAJOR
#define RAWRXD_APP_VERSION_MAJOR 14
#endif
#ifndef RAWRXD_APP_VERSION_MINOR
#define RAWRXD_APP_VERSION_MINOR 7
#endif
#ifndef RAWRXD_APP_VERSION_PATCH
#define RAWRXD_APP_VERSION_PATCH 3
#endif
#ifndef RAWRXD_APP_VERSION_BUILD
#define RAWRXD_APP_VERSION_BUILD 0
#endif

// ----------------------------------------------------------------------------
// Application manifest: execution level + PerMonitorV2 DPI awareness.
// ----------------------------------------------------------------------------
1 RT_MANIFEST "rawrxd.manifest"

// ----------------------------------------------------------------------------
// Application icon.
// ----------------------------------------------------------------------------
2 ICON "rawrxd.ico"

// ----------------------------------------------------------------------------
// Version information.
// ----------------------------------------------------------------------------
1 VERSIONINFO
FILEVERSION    RAWRXD_APP_VERSION_MAJOR,RAWRXD_APP_VERSION_MINOR,RAWRXD_APP_VERSION_PATCH,RAWRXD_APP_VERSION_BUILD
PRODUCTVERSION RAWRXD_APP_VERSION_MAJOR,RAWRXD_APP_VERSION_MINOR,RAWRXD_APP_VERSION_PATCH,RAWRXD_APP_VERSION_BUILD
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS      VS_FF_DEBUG
#else
FILEFLAGS      0x0L
#endif
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "RawrXD"
            VALUE "FileDescription",  "RawrXD Win32 IDE"
            VALUE "FileVersion",      "14.7.3.0"
            VALUE "InternalName",     "RawrXD-Win32IDE"
            VALUE "LegalCopyright",   "Copyright (C) 2026 RawrXD"
            VALUE "OriginalFilename", "RawrXD-Win32IDE.exe"
            VALUE "ProductName",      "RawrXD Win32 IDE"
            VALUE "ProductVersion",   "14.7.3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
