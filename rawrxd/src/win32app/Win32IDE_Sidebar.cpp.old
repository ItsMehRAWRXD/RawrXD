// Win32IDE_Sidebar.cpp — file tree sidebar with expand/collapse
#include <windows.h>
#include <string>
#include <vector>
#include <algorithm>
#include <functional>
#include <cstdio>

namespace RawrXD::IDE {

HFONT IDECore_UIFont();
bool  EditorEngine_OpenFile(const std::string& path);

struct TreeNode {
    std::string name;
    std::string fullPath;
    bool        isDir     = false;
    bool        expanded  = false;
    int         depth     = 0;
    std::vector<TreeNode> children;
};

struct SidebarState {
    HWND   hwnd       = nullptr;
    TreeNode root;
    int    scrollLine = 0;
    int    selectedLine = -1;
    int    lineH      = 20;
    std::vector<TreeNode*> flatList; // flattened visible nodes
    std::function<void(const std::string&)> onFileOpen;
};

static SidebarState g_sidebar;

// ── Build flat visible list ───────────────────────────────────────────────────
static void Flatten(TreeNode& node, std::vector<TreeNode*>& out)
{
    for (auto& child : node.children) {
        out.push_back(&child);
        if (child.isDir && child.expanded)
            Flatten(child, out);
    }
}

static void RebuildFlat()
{
    g_sidebar.flatList.clear();
    Flatten(g_sidebar.root, g_sidebar.flatList);
}

// ── Load directory into tree node ────────────────────────────────────────────
static void LoadDir(TreeNode& node, int maxDepth = 0)
{
    node.children.clear();
    std::string pattern = node.fullPath + "\\*";
    WIN32_FIND_DATAA fd;
    HANDLE h = FindFirstFileA(pattern.c_str(), &fd);
    if (h == INVALID_HANDLE_VALUE) return;

    std::vector<TreeNode> dirs, files;
    do {
        if (strcmp(fd.cFileName, ".") == 0 || strcmp(fd.cFileName, "..") == 0) continue;
        // Skip hidden/system
        if (fd.dwFileAttributes & (FILE_ATTRIBUTE_HIDDEN | FILE_ATTRIBUTE_SYSTEM)) continue;
        TreeNode child;
        child.name     = fd.cFileName;
        child.fullPath = node.fullPath + "\\" + fd.cFileName;
        child.depth    = node.depth + 1;
        child.isDir    = !!(fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY);
        if (child.isDir) dirs.push_back(child);
        else             files.push_back(child);
    } while (FindNextFileA(h, &fd));
    FindClose(h);

    std::sort(dirs.begin(),  dirs.end(),  [](auto& a, auto& b){ return a.name < b.name; });
    std::sort(files.begin(), files.end(), [](auto& a, auto& b){ return a.name < b.name; });
    for (auto& d : dirs)  node.children.push_back(d);
    for (auto& f : files) node.children.push_back(f);
}

// ── Paint ─────────────────────────────────────────────────────────────────────
static void SidebarPaint(HWND hwnd)
{
    PAINTSTRUCT ps;
    HDC hdc = BeginPaint(hwnd, &ps);
    RECT rc; GetClientRect(hwnd, &rc);
    int W = rc.right, H = rc.bottom;

    HDC mem = CreateCompatibleDC(hdc);
    HBITMAP bmp = CreateCompatibleBitmap(hdc, W, H);
    HBITMAP old = (HBITMAP)SelectObject(mem, bmp);

    HBRUSH bg = CreateSolidBrush(RGB(37, 37, 38));
    FillRect(mem, &rc, bg);
    DeleteObject(bg);

    HFONT font = IDECore_UIFont();
    HFONT oldFont = (HFONT)SelectObject(mem, font);
    SetBkMode(mem, TRANSPARENT);

    // Header
    SetTextColor(mem, RGB(150, 150, 150));
    RECT hdrRc = {6, 2, W - 4, 20};
    DrawTextA(mem, "EXPLORER", -1, &hdrRc, DT_LEFT | DT_SINGLELINE | DT_VCENTER);

    int y = 22 - g_sidebar.scrollLine * g_sidebar.lineH;
    for (int i = 0; i < (int)g_sidebar.flatList.size(); ++i) {
        TreeNode* n = g_sidebar.flatList[i];
        if (y + g_sidebar.lineH < 22 || y > H) { y += g_sidebar.lineH; continue; }

        if (i == g_sidebar.selectedLine) {
            RECT selRc = {0, y, W, y + g_sidebar.lineH};
            HBRUSH selBr = CreateSolidBrush(RGB(38, 79, 120));
            FillRect(mem, &selRc, selBr);
            DeleteObject(selBr);
        }

        int indent = 6 + n->depth * 14;
        // Arrow for dirs
        if (n->isDir) {
            SetTextColor(mem, RGB(200, 200, 200));
            const char* arrow = n->expanded ? "v " : "> ";
            RECT arRc = {indent, y, indent + 16, y + g_sidebar.lineH};
            DrawTextA(mem, arrow, -1, &arRc, DT_LEFT | DT_SINGLELINE | DT_VCENTER);
            indent += 16;
        } else {
            indent += 16;
        }

        COLORREF col = n->isDir ? RGB(220, 220, 100) : RGB(212, 212, 212);
        SetTextColor(mem, col);
        RECT nr = {indent, y, W - 4, y + g_sidebar.lineH};
        DrawTextA(mem, n->name.c_str(), -1, &nr, DT_LEFT | DT_SINGLELINE | DT_VCENTER | DT_END_ELLIPSIS);
        y += g_sidebar.lineH;
    }

    SelectObject(mem, oldFont);
    BitBlt(hdc, 0, 0, W, H, mem, 0, 0, SRCCOPY);
    SelectObject(mem, old);
    DeleteObject(bmp);
    DeleteDC(mem);
    EndPaint(hwnd, &ps);
}

static LRESULT CALLBACK SidebarWndProc(HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam)
{
    switch (msg) {
    case WM_PAINT:      SidebarPaint(hwnd); return 0;
    case WM_ERASEBKGND: return 1;
    case WM_SIZE:       InvalidateRect(hwnd, nullptr, FALSE); return 0;
    case WM_MOUSEWHEEL: {
        int delta = GET_WHEEL_DELTA_WPARAM(wParam);
        g_sidebar.scrollLine -= delta / WHEEL_DELTA * 3;
        g_sidebar.scrollLine = std::max(0, g_sidebar.scrollLine);
        InvalidateRect(hwnd, nullptr, FALSE);
        return 0;
    }
    case WM_LBUTTONDOWN: {
        int my = HIWORD(lParam);
        int idx = (my - 22 + g_sidebar.scrollLine * g_sidebar.lineH) / std::max(1, g_sidebar.lineH);
        if (idx >= 0 && idx < (int)g_sidebar.flatList.size()) {
            g_sidebar.selectedLine = idx;
            TreeNode* n = g_sidebar.flatList[idx];
            if (n->isDir) {
                if (!n->expanded && n->children.empty())
                    LoadDir(*n);
                n->expanded = !n->expanded;
                RebuildFlat();
            }
            InvalidateRect(hwnd, nullptr, FALSE);
        }
        return 0;
    }
    case WM_LBUTTONDBLCLK: {
        int my = HIWORD(lParam);
        int idx = (my - 22 + g_sidebar.scrollLine * g_sidebar.lineH) / std::max(1, g_sidebar.lineH);
        if (idx >= 0 && idx < (int)g_sidebar.flatList.size()) {
            TreeNode* n = g_sidebar.flatList[idx];
            if (!n->isDir) {
                EditorEngine_OpenFile(n->fullPath);
                if (g_sidebar.onFileOpen) g_sidebar.onFileOpen(n->fullPath);
            }
        }
        return 0;
    }
    }
    return DefWindowProcA(hwnd, msg, wParam, lParam);
}

// ── Public API ────────────────────────────────────────────────────────────────
void Sidebar_Register(HINSTANCE hInst)
{
    WNDCLASSEXA wc = {};
    wc.cbSize        = sizeof(wc);
    wc.lpfnWndProc   = SidebarWndProc;
    wc.hInstance     = hInst;
    wc.lpszClassName = "RawrXDSidebar";
    wc.hCursor       = LoadCursor(nullptr, IDC_ARROW);
    wc.style         = CS_DBLCLKS;
    RegisterClassExA(&wc);
}

HWND Sidebar_Create(HWND parent, int x, int y, int w, int h, HINSTANCE hInst)
{
    g_sidebar.hwnd = CreateWindowExA(0, "RawrXDSidebar", nullptr,
        WS_CHILD | WS_VISIBLE | CS_DBLCLKS,
        x, y, w, h, parent, nullptr, hInst, nullptr);
    return g_sidebar.hwnd;
}

void Sidebar_SetRoot(const std::string& dir)
{
    g_sidebar.root.fullPath = dir;
    g_sidebar.root.name     = dir;
    g_sidebar.root.isDir    = true;
    g_sidebar.root.depth    = -1;
    LoadDir(g_sidebar.root);
    RebuildFlat();
    if (g_sidebar.hwnd) InvalidateRect(g_sidebar.hwnd, nullptr, FALSE);
}

void Sidebar_SetFileOpenCallback(std::function<void(const std::string&)> cb)
{
    g_sidebar.onFileOpen = std::move(cb);
}

void Sidebar_Refresh()
{
    if (!g_sidebar.root.fullPath.empty()) {
        LoadDir(g_sidebar.root);
        RebuildFlat();
        if (g_sidebar.hwnd) InvalidateRect(g_sidebar.hwnd, nullptr, FALSE);
    }
}

} // namespace RawrXD::IDE
