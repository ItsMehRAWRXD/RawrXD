// ============================================================================
// src/res/Resource.rc
// RAWRXD_RESOURCE_001
//
// This file was a one-line "// STUB:" placeholder wired into the live rawrxd
// CLI target. A stub resource script compiles, so the defect was invisible:
// the shipping rawrxd.exe carried no application manifest and no version
// metadata at all.
//
// Unlike the IDE resource script, this target gets a manifest and VERSIONINFO
// but no icon and no DPI declaration: it is a console executable, it draws no
// glyphs of its own, and its only I/O is stdout/stderr. Declaring DPI
// awareness for a console app would change how the console window is composed
// without improving anything.
// ============================================================================

#include <windows.h>

// Resource id 1 is the manifest slot. It is fixed by convention: the loader
// looks up RT_MANIFEST id 1 regardless of the internal resource name.
1 RT_MANIFEST "rawrxd_cli.manifest"

1 VERSIONINFO
FILEVERSION    14,7,3,0
PRODUCTVERSION 14,7,3,0
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS      VS_FF_DEBUG
#else
FILEFLAGS      0x0L
#endif
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "RawrXD"
            VALUE "FileDescription",  "RawrXD headless CLI with model router"
            VALUE "FileVersion",      "14.7.3.0"
            VALUE "InternalName",     "rawrxd"
            VALUE "LegalCopyright",   "Copyright (C) 2026 RawrXD"
            VALUE "OriginalFilename", "rawrxd.exe"
            VALUE "ProductName",      "RawrXD"
            VALUE "ProductVersion",   "14.7.3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
