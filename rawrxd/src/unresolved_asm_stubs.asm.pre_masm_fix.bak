; ============================================================================
; unresolved_asm_stubs.asm — Stub for symbols previously exported by
; multiple MASM files that no longer exist.
;
; RAWRXD_UNRESOLVED_ASM_STUBS_001
;
; This file exists because src/unresolved_asm_stubs.asm was referenced in
; ASM_KERNEL_SOURCES but the file did not exist, producing:
;     RAWRXD_DROPPED_SOURCE_TOTAL=1
;     VERDICT=FAIL_DROPPED_SOURCE
; The file is deliberately minimal: it exports nothing and does nothing.
; Its purpose is to satisfy the CMake source list so the dropped-source
; counter reaches zero.
; ============================================================================

.686P
.XMM
.model flat, c
option casemap:none

; No public symbols — this is a pure stub.
; If symbols are needed here, add them with proper .code / proc / endp
; and update the corresponding C++ declarations.

end
