#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
layout(local_size_x=256) in;

layout(set=0,binding=0,std430) readonly buffer W0 { uint w[]; };
layout(set=0,binding=1,std430) readonly buffer X0 { float x[]; };
layout(set=0,binding=2,std430) writeonly buffer Y0 { float y[]; };

layout(push_constant) uniform Push {
    uint type;
    uint rows;
    uint cols;
    uint weightBytes;
    uint batch;
} pc;

shared float xs[256];

uint getb(uint byteIndex) {
    uint word=w[byteIndex>>2u];
    return (word>>((byteIndex&3u)*8u))&255u;
}
float geth(uint byteIndex) {
    uint h=getb(byteIndex)|(getb(byteIndex+1u)<<8u);
    return unpackHalf2x16(h).x;
}
int gets8(uint byteIndex) {
    int v=int(getb(byteIndex));
    return v>=128 ? v-256 : v;
}
uint load4Bytes(uint byteIndex) {
    uint wordIndex=byteIndex>>2u;
    uint shift=(byteIndex&3u)*8u;
    uint lo=w[wordIndex];
    if(shift==0u) return lo;
    uint hi=w[wordIndex+1u];
    return (lo>>shift)|(hi<<(32u-shift));
}

void q6kDot4(uint rowBase,uint globalCol,uint localCol,inout float acc) {
    uint block=globalCol>>8u;
    uint element=globalCol&255u;
    uint elementHalf=element>>7u;
    uint elementWithin=element&127u;
    uint elementCat=elementWithin>>5u;
    uint elementL=elementWithin&31u;
    uint b=rowBase+block*210u;
    uint qlBase=b+elementHalf*64u+(elementCat&1u)*32u+elementL;
    uint qhBase=b+128u+elementHalf*32u+elementL;
    uint ql=load4Bytes(qlBase);
    uint qh=load4Bytes(qhBase);
    uint scaleIndex=elementHalf*8u+(elementCat<<1u)+(elementL>>4u);
    float d=geth(b+208u);
    float scale=float(gets8(b+192u+scaleIndex));
    for(uint k=0u;k<4u;++k) {
        uint col=globalCol+k;
        if(col>=pc.cols) break;
        uint qByte=(ql>>(k*8u))&255u;
        uint q=(elementCat&1u)==0u?(qByte&15u):(qByte>>4u);
        uint highByte=(qh>>(k*8u))&255u;
        uint high=(highByte>>((elementCat&3u)*2u))&3u;
        float ww=d*scale*float(int(q|(high<<4u))-32);
        acc+=ww*xs[localCol+k];
    }
}

void main() {
    if(pc.type!=14u||pc.batch!=1u||pc.cols==0u) return;

    uint lid=gl_LocalInvocationID.x;
    uint subgroupSize=gl_SubgroupSize;
    uint lane=gl_SubgroupInvocationID;
    uint row=gl_WorkGroupID.x*gl_NumSubgroups+gl_SubgroupID;
    uint blocks=(pc.cols+255u)>>8u;
    uint rowBytes=blocks*210u;
    float acc=0.0;

    for(uint blk=0u;blk<blocks;++blk) {
        uint colBase=blk*256u;
        uint c=colBase+lid;
        xs[lid]=c<pc.cols?x[c]:0.0;
        barrier();

        if(row<pc.rows&&subgroupSize<=256u&&(256u%subgroupSize)==0u) {
            uint rb=row*rowBytes;
            uint valuesPerLane=256u/subgroupSize;
            for(uint k=0u;k<valuesPerLane;k+=4u) {
                uint lc=lane*valuesPerLane+k;
                uint gc=colBase+lc;
                if(gc<pc.cols) q6kDot4(rb,gc,lc,acc);
            }
        }
        barrier();
    }

    float total=subgroupAdd(acc);
    if(subgroupElect()&&row<pc.rows) y[row]=total;
}
