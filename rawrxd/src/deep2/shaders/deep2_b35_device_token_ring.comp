#version 460
// Batch 35: device-side token handoff ring.
// One producer publishes token+sequence; consumers spin on sequence without host polling.
layout(local_size_x=64) in;

struct Slot {
    int token;
    uint owner;
    uint seqLo;
    uint seqHi;
    uint valid;
};

layout(set=0,binding=0,std430) buffer Ring { Slot slots[]; };
layout(set=0,binding=1,std430) buffer State {
    uint writeIndex;
    uint consumeSeqLo;
    uint consumeSeqHi;
} st;

layout(push_constant) uniform PC {
    int token;
    uint owner;
    uint seqLo;
    uint seqHi;
    uint ringSize;
} pc;

void main() {
    if(gl_GlobalInvocationID.x!=0u) return;
    uint idx=atomicAdd(st.writeIndex,1u)%pc.ringSize;
    slots[idx].token=pc.token;
    slots[idx].owner=pc.owner;
    slots[idx].seqLo=pc.seqLo;
    slots[idx].seqHi=pc.seqHi;
    memoryBarrierBuffer();
    slots[idx].valid=1u;
}
