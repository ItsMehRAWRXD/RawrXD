#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
// Batch 9 packed GGUF GEMV.
// Supported: Q8_0(8), Q2_K(10), Q3_K(11), Q4_K(12), Q6_K(14).
//
// 40TPS_BATCH2:
//   one workgroup = one output row
//   256 lanes cooperatively consume input columns
//   shared-memory tree reduction emits exactly one row result
layout(local_size_x = 256) in;

layout(set=0,binding=0,std430) readonly buffer W0 { uint w[]; };
layout(set=0,binding=1,std430) readonly buffer X0 { float x[]; };
layout(set=0,binding=2,std430) writeonly buffer Y0 { float y[]; };

layout(push_constant) uniform Push {
    uint type;
    uint rows;
    uint cols;
    uint weightBytes;
} pc;

// AMD target: 256-lane workgroup => at most 8 wave32 subgroups.
shared float subgroupSums[8];

// RAWRXD_B66_Q3K_SHARED_UNPACK_001
// Cooperative per-block metadata unpack, used only by the Q3_K path.
//
// The B65 per-element q3k_weight() rebuilt the four aux words, decoded a scale
// and extracted hmask/q bytes for EVERY element. On a 256-lane workgroup that
// means 256 redundant unpacks of the same 110-byte block, which is the measured
// cause of B65 being ~3.2x slower than the F32 prepared path (2.01 vs 6.49 TPS)
// despite doing zero CPU dequant.
//
// B66 amortizes: one lane group materializes the block's 16 decoded scales once
// into shared memory, then all lanes read them. The quantization math is
// UNCHANGED -- B65 remains the correctness oracle, and the gate is exact block
// and token parity against it.
shared float q3kScales[16];   // per-block decoded scale, already biased by -32
shared float q3kD;            // per-block super-scale
// B67 sweep state: 4 blocks unpacked per sweep so 256 lanes can each consume 4
// contiguous elements (1024 elements = 4 blocks).
shared float q3kScales4[64];
shared float q3kD4[4];

uint getb(uint byteIndex) {
    uint word = w[byteIndex >> 2u];
    return (word >> ((byteIndex & 3u) * 8u)) & 255u;
}
int gets8(uint byteIndex) {
    int v = int(getb(byteIndex));
    return v >= 128 ? v - 256 : v;
}
float geth(uint byteIndex) {
    uint h = getb(byteIndex) | (getb(byteIndex + 1u) << 8u);
    return unpackHalf2x16(h).x;
}

void q4kScaleMin(uint base, uint sb, out uint sc, out uint mn) {
    if (sb < 4u) {
        sc = getb(base + 4u + sb) & 63u;
        mn = getb(base + 8u + sb) & 63u;
    } else {
        uint j = sb - 4u;
        sc = (getb(base + 12u + j) & 15u) |
             ((getb(base + 4u + j) >> 6u) << 4u);
        mn = (getb(base + 12u + j) >> 4u) |
             ((getb(base + 8u + j) >> 6u) << 4u);
    }
}

float q8_0_weight(uint rowBase, uint col) {
    uint block = col / 32u;
    uint i = col % 32u;
    uint b = rowBase + block * 34u;
    return geth(b) * float(gets8(b + 2u + i));
}

float q2k_weight(uint rowBase, uint col) {
    uint block = col / 256u;
    uint idx = col % 256u;
    uint b = rowBase + block * 84u;

    // Layout B: scales[16], qs[64], d (2 bytes), dmin (2 bytes)
    uint chunk = idx / 128u;
    uint rem = idx % 128u;
    uint subBlock = rem / 32u;
    uint group = (rem % 32u) / 16u;
    uint pos = rem % 16u;

    uint scaleIdx = chunk * 8u + subBlock * 2u + group;
    uint packedScale = getb(b + 0u + scaleIdx);
    float ds = geth(b + 80u);
    float dm = geth(b + 82u);
    float dl = ds * float(packedScale & 15u);
    float ml = dm * float(packedScale >> 4u);

    uint qsIdx = chunk * 32u + group * 16u + pos;
    uint shift = subBlock * 2u;
    uint q = (getb(b + 16u + qsIdx) >> shift) & 3u;
    return dl * float(q) - ml;
}

// Q3_K: 256 weights per 110-byte super-block.
// Layout (QuantKernelRegistry.hpp:81): hmask[32], qs[64], scales[12], d(fp16).
//
// This is the HOST-VERIFIED transcription. It reproduces dequant_q3_k()
// (QuantKernelRegistry.cpp:1439) element-for-element and was proven on the
// host by tools/q3k_block_diff.cpp (RAWRXD_B65_Q3K_BLOCK_DIFF_001):
//
//   Q3K_BLOCK_PARITY_V2=PASS  cases=72 elements=18432
//   scaleRaw/scaleSigned/q/hv/weight mismatches = 0
//
// Do not hand-edit. Any change must re-pass q3k_block_diff.exe first.
//
// Three defects made attempt 1 fail. All three produce FINITE output, so a
// finiteness check cannot detect any of them -- attempt 1 emitted degenerate
// "eczecz..." text at 7.49 TPS with every GPU_FORWARD_FINITE_CHECK reporting
// nan=0 inf=0.
//
//   DEFECT A (scale layout): the 16 scales are the 16 SIGNED bytes of a
//     four-word aux array built from scales[12]. aux[2] must be snapshotted
//     BEFORE aux[0..3] are rewritten. Attempt 1 assumed the scales lived in
//     two words' low bytes: 8464/18432 elements wrong.
//   DEFECT B (missing -32 bias): wrong on 18384/18432 elements.
//   DEFECT C (hmask selector): `m` is a uint8_t declared ONCE and shifted at
//     the END of every j iteration, so it is NOT reset between the two
//     128-halves. Its eight used values are 1,2,4,8,16,32,64,128 indexed by
//     (n128*4 + j). Attempt 1 used 1<<n128 -- correct for 1/8 of the block,
//     wrong on 7804 elements.

int q3k_scale16(uint b, uint is) {
    // Rebuild aux[0..3] exactly as the reference does, snapshotting aux[2]
    // before overwriting (DEFECT A fix).
    uint a0 = getb(b + 96u) | (getb(b + 97u) << 8u) |
              (getb(b + 98u) << 16u) | (getb(b + 99u) << 24u);
    uint a1 = getb(b +100u) | (getb(b +101u) << 8u) |
              (getb(b +102u) << 16u) | (getb(b +103u) << 24u);
    uint tm = getb(b +104u) | (getb(b +105u) << 8u) |
              (getb(b +106u) << 16u) | (getb(b +107u) << 24u);

    const uint km1 = 0x03030303u;
    const uint km2 = 0x0f0f0f0fu;
    uint n2 = ((a0 >> 4u) & km2) | (((tm >> 4u) & km1) << 4u);
    uint n3 = ((a1 >> 4u) & km2) | (((tm >> 6u) & km1) << 4u);
    uint n0 = (a0 & km2) | (((tm) & km1) << 4u);
    uint n1 = (a1 & km2) | (((tm >> 2u) & km1) << 4u);

    // The 16 scales are the 16 SIGNED bytes of aux[0..3] in order.
    uint word = (is < 4u) ? n0 : (is < 8u) ? n1 : (is < 12u) ? n2 : n3;
    uint byteIdx = is & 3u;
    uint v = (word >> (byteIdx * 8u)) & 255u;
    return v >= 128u ? int(v) - 256 : int(v);
}

float q3k_weight(uint rowBase, uint col) {
    uint block = col / 256u;
    uint idx = col % 256u;
    uint b = rowBase + block * 110u;

    uint n128 = idx / 128u;
    uint inHalf = idx % 128u;
    uint j = inHalf / 32u;
    uint l = inHalf % 32u;
    uint shift = j * 2u;
    uint m = 1u << (n128 * 4u + j);      // DEFECT C fix

    uint is = n128 * 8u + j * 2u + (l >= 16u ? 1u : 0u);
    float sc = float(q3k_scale16(b, is) - 32);   // DEFECT B fix

    // Within a half, q and hm are NOT advanced between j iterations; only
    // shift and m change. q advances by 32 once per half.
    uint qsIdx = n128 * 32u + l;
    uint hmIdx = l;

    uint qv = (getb(b + 32u + qsIdx) >> shift) & 3u;
    uint hv = (getb(b + hmIdx) & m) != 0u ? 0u : 4u;

    float d = geth(b + 108u);
    if (!(d == d) || abs(d) > 3.4e38) d = 0.0;
    return d * sc * float(int(qv) - int(hv));
}

float q4k_weight(uint rowBase, uint col) {
    uint block = col / 256u;
    uint idx = col % 256u;
    uint b = rowBase + block * 144u;
    float ds = geth(b + 0u);
    float dm = geth(b + 2u);

    uint sb = idx / 32u;
    uint l = idx % 32u;
    uint sc, mn;
    q4kScaleMin(b, sb, sc, mn);

    uint pair = sb / 2u;
    uint packed = getb(b + 16u + pair * 32u + l);
    uint q = (sb & 1u) == 0u ? (packed & 15u) : (packed >> 4u);
    return ds * float(sc) * float(q) - dm * float(mn);
}

// Four-column Q4_K dot fragment.
// colBase is always a multiple of four. Q4_K block/sub-block boundaries
// are multiples of 32/256, so the 4-byte qs fetch cannot straddle either.
float q4k_dot4(uint rowBase, uint colBase) {
    uint block = colBase / 256u;
    uint idx = colBase % 256u;
    uint b = rowBase + block * 144u;

    float ds = geth(b + 0u);
    float dm = geth(b + 2u);

    uint sb = idx / 32u;
    uint l = idx % 32u;
    uint sc, mn;
    q4kScaleMin(b, sb, sc, mn);

    uint pair = sb / 2u;
    uint qsByte = b + 16u + pair * 32u + l;
    // qsByte is 4-byte aligned for colBase=(lane*4 + k*1024).
    uint packed4 = w[qsByte >> 2u];

    float d = ds * float(sc);
    float m = dm * float(mn);
    float sum = 0.0;

    for (uint k = 0u; k < 4u; ++k) {
        uint col = colBase + k;
        if (col >= pc.cols) break;
        uint packed = (packed4 >> (k * 8u)) & 255u;
        uint q = (sb & 1u) == 0u ? (packed & 15u) : (packed >> 4u);
        sum += (d * float(q) - m) * x[col];
    }
    return sum;
}

float q6k_weight(uint rowBase, uint col) {
    uint block = col / 256u;
    uint idx = col % 256u;
    uint b = rowBase + block * 210u;
    float ds = geth(b + 208u);

    uint hi128 = idx / 128u;
    uint within = idx % 128u;
    uint cat = within / 32u;
    uint l = within % 32u;
    uint is = l / 16u;

    uint qlBase = b + hi128 * 64u;
    uint qhBase = b + 128u + hi128 * 32u;
    uint scBase = b + 192u + hi128 * 8u;

    uint q = 0u;
    uint scIndex = 0u;
    if (cat == 0u) {
        q = (getb(qlBase + l) & 15u) |
            (((getb(qhBase + l) >> 0u) & 3u) << 4u);
        scIndex = is + 0u;
    } else if (cat == 1u) {
        q = (getb(qlBase + l + 32u) & 15u) |
            (((getb(qhBase + l) >> 2u) & 3u) << 4u);
        scIndex = is + 2u;
    } else if (cat == 2u) {
        q = (getb(qlBase + l) >> 4u) |
            (((getb(qhBase + l) >> 4u) & 3u) << 4u);
        scIndex = is + 4u;
    } else {
        q = (getb(qlBase + l + 32u) >> 4u) |
            (((getb(qhBase + l) >> 6u) & 3u) << 4u);
        scIndex = is + 6u;
    }
    int qs = int(q) - 32;
    int scale = gets8(scBase + scIndex);
    return ds * float(scale) * float(qs);
}

float q3k_weight_shared(uint b) {
    // B66: metadata already unpacked cooperatively into q3kScales/q3kD.
    // Index math is IDENTICAL to q3k_weight() -- only the source of the
    // decoded scale and d changed. That is deliberate: it keeps the B65
    // oracle as a valid reference for the parity gate.
    uint idx = gl_LocalInvocationIndex;   // lane == gl_LocalInvocationID.x
    uint n128 = idx / 128u;
    uint inHalf = idx % 128u;
    uint j = inHalf / 32u;
    uint l = inHalf % 32u;
    uint shift = j * 2u;
    uint m = 1u << (n128 * 4u + j);       // DEFECT C fix preserved

    uint is = n128 * 8u + j * 2u + (l >= 16u ? 1u : 0u);
    float sc = q3kScales[is];             // bias already applied

    uint qsIdx = n128 * 32u + l;
    uint hmIdx = l;

    uint qv = (getb(b + 32u + qsIdx) >> shift) & 3u;
    uint hv = (getb(b + hmIdx) & m) != 0u ? 0u : 4u;

    return q3kD * sc * float(int(qv) - int(hv));
}

// Four-column Q3_K dot fragment (RAWRXD_B67_Q3K_DOT4_001).
// colBase is always a multiple of four. Within a 128-weight half the scale
// index, the shift and the hmask selector m depend only on (n128, j), while l
// runs 0..31 contiguously. Because colBase is 4-aligned, four consecutive
// columns never straddle a 32-element sub-block boundary, so all four share
// ONE decoded scale, ONE shift and ONE m. That collapses four scale lookups,
// four m-selections and four weight computations into one each.
//
// This reduces byte-extraction COUNT per useful element, which B66 did not:
// B66 removed the redundant aux unpack, but each lane still fetched its own
// scale and its own bytes. q4k_dot4 (deep2_qgemv.comp) already does exactly
// this for type 12; this is the same structure for type 11.
float q3k_dot4(uint rowBase, uint colBase) {
    uint block = colBase / 256u;
    uint idx = colBase % 256u;
    uint b = rowBase + block * 110u;

    uint n128 = idx / 128u;
    uint inHalf = idx % 128u;
    uint j = inHalf / 32u;
    uint l = inHalf % 32u;
    uint shift = j * 2u;
    uint m = 1u << (n128 * 4u + j);          // DEFECT C fix preserved

    uint is = n128 * 8u + j * 2u + (l >= 16u ? 1u : 0u);
    float sc = q3kScales[is];               // B66 shared unpack, bias applied

    // qs is contiguous across l, so the four qs bytes are contiguous. The Q3_K
    // block stride is 110, which is NOT a multiple of 4, so qsBase is not
    // reliably 4-aligned inside the weight buffer: fetch bytes individually
    // rather than issuing a word load that could straddle a row boundary.
    uint qsBase = b + 32u + n128 * 32u;

    float dsc = q3kD * sc;
    float sum = 0.0;
    for (uint k = 0u; k < 4u; ++k) {
        uint col = colBase + k;
        if (col >= pc.cols) break;
        uint qv = (getb(qsBase + l + k) >> shift) & 3u;
        uint hv = (getb(b + l + k) & m) != 0u ? 0u : 4u;
        sum += dsc * float(int(qv) - int(hv)) * x[col];
    }
    return sum;
}

// B67: same math as q3k_dot4, but reads the per-sweep shared metadata for the
// block this lane is assigned to. Index expressions are identical to
// q3k_weight() so the B65/B66 oracle remains a valid parity reference.
float q3k_dot4_sweep(uint rowBase, uint blkIdx, uint colInBlk, uint lid) {
    uint b = rowBase + blkIdx * 110u;

    uint idx = colInBlk;
    uint n128 = idx / 128u;
    uint inHalf = idx % 128u;
    uint j = inHalf / 32u;
    uint l = inHalf % 32u;
    uint shift = j * 2u;
    uint m = 1u << (n128 * 4u + j);          // DEFECT C fix preserved

    uint is = n128 * 8u + j * 2u + (l >= 16u ? 1u : 0u);
    float sc = q3kScales4[lid / 64u * 16u + is];

    uint qsBase = b + 32u + n128 * 32u;
    float dsc = q3kD4[lid / 64u] * sc;
    float sum = 0.0;
    for (uint k = 0u; k < 4u; ++k) {
        uint col = blkIdx * 256u + colInBlk + k;
        if (col >= pc.cols) break;
        uint qv = (getb(qsBase + l + k) >> shift) & 3u;
        uint hv = (getb(b + l + k) & m) != 0u ? 0u : 4u;
        sum += dsc * float(int(qv) - int(hv)) * x[col];
    }
    return sum;
}

// One cooperative unpack for a whole block. Callers must barrier() afterwards.
void q3k_unpack_block(uint b) {
    if (gl_LocalInvocationIndex == 0u) {
        float dd = geth(b + 108u);
        if (!(dd == dd) || abs(dd) > 3.4e38) dd = 0.0;
        q3kD = dd;
        for (uint i = 0u; i < 16u; ++i) {
            q3kScales[i] = float(q3k_scale16(b, i) - 32);
        }
    }
}

void main() {
    uint row = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;
    if (row >= pc.rows) return;

    uint blocksPerRow = 0u;
    uint rowBytes = 0u;
    if (pc.type == 8u) {
        blocksPerRow = (pc.cols + 31u) / 32u;
        rowBytes = blocksPerRow * 34u;
    } else if (pc.type == 10u) {
        blocksPerRow = (pc.cols + 255u) / 256u;
        rowBytes = blocksPerRow * 84u;
    } else if (pc.type == 11u) {
        blocksPerRow = (pc.cols + 255u) / 256u;
        rowBytes = blocksPerRow * 110u;
    } else if (pc.type == 12u) {
        blocksPerRow = (pc.cols + 255u) / 256u;
        rowBytes = blocksPerRow * 144u;
    } else if (pc.type == 14u) {
        blocksPerRow = (pc.cols + 255u) / 256u;
        rowBytes = blocksPerRow * 210u;
    } else {
        y[row] = uintBitsToFloat(0x7fc00000u);
        return;
    }

    uint rb = row * rowBytes;
    if (rb + rowBytes > pc.weightBytes) {
        if (lane == 0u) y[row] = uintBitsToFloat(0x7fc00000u);
        return;
    }

    float acc = 0.0;
    if (pc.type == 12u) {
        // 256 lanes * 4 contiguous values = 1024 columns per sweep.
        for (uint j = lane * 4u; j < pc.cols; j += 1024u)
            acc += q4k_dot4(rb, j);
    } else if (pc.type == 11u && (pc.cols & 1023u) == 0u) {
        // RAWRXD_B67_Q3K_DOT4_001 -- PREFERRED Q3_K path.
        // 256 lanes * 4 contiguous elements = 1024 elements = 4 blocks per
        // sweep. Requires cols % 1024 == 0 so no sweep is partially masked.
        // Must be tested BEFORE the B66 branch, whose condition (cols % 256) is
        // strictly weaker and would otherwise shadow this one entirely.
        float acc3 = 0.0;
        const uint kBlkPerSweep = 4u;
        for (uint blkBase = 0u; blkBase < blocksPerRow; blkBase += kBlkPerSweep) {
            // Four lanes unpack one block each: 16 scales + d per block.
            if (gl_LocalInvocationIndex < kBlkPerSweep) {
                uint bb = rb + (blkBase + gl_LocalInvocationIndex) * 110u;
                float dd = geth(bb + 108u);
                if (!(dd == dd) || abs(dd) > 3.4e38) dd = 0.0;
                q3kD4[gl_LocalInvocationIndex] = dd;
                for (uint i = 0u; i < 16u; ++i)
                    q3kScales4[gl_LocalInvocationIndex * 16u + i] =
                        float(q3k_scale16(bb, i) - 32);
            }
            barrier();
            uint myBlock = gl_LocalInvocationIndex / 64u;          // 0..3
            uint colInBlk = (gl_LocalInvocationIndex % 64u) * 4u; // 0..252
            acc3 += q3k_dot4_sweep(rb, blkBase + myBlock, colInBlk,
                                   gl_LocalInvocationIndex);
            barrier();
        }
        acc = acc3;
    } else if (pc.type == 11u && (pc.cols & 255u) == 0u) {
        // RAWRXD_B66_Q3K_SHARED_UNPACK_001 -- fallback for cols % 256 == 0 but
        // cols % 1024 != 0. One unpack per block instead of one per element.
        float acc2 = 0.0;
        for (uint blk = 0u; blk < blocksPerRow; ++blk) {
            uint b = rb + blk * 110u;
            q3k_unpack_block(b);
            barrier();
            acc2 += q3k_weight_shared(b) * x[blk * 256u + lane];
            barrier();
        }
        acc = acc2;
    } else {
        for (uint j = lane; j < pc.cols; j += 256u) {
            float ww = 0.0;
            if (pc.type == 8u) ww = q8_0_weight(rb, j);
            else if (pc.type == 10u) ww = q2k_weight(rb, j);
            else if (pc.type == 11u) ww = q3k_weight(rb, j);  // ragged Q3_K only
            else if (pc.type == 14u) ww = q6k_weight(rb, j);
            acc += ww * x[j];
        }
    }

    // First reduction is entirely register/wave based.
    float wave = subgroupAdd(acc);
    if (subgroupElect())
        subgroupSums[gl_SubgroupID] = wave;
    barrier();

    // The first subgroup reduces one value per subgroup.
    if (gl_SubgroupID == 0u) {
        float v = gl_SubgroupInvocationID < gl_NumSubgroups
            ? subgroupSums[gl_SubgroupInvocationID]
            : 0.0;
        float total = subgroupAdd(v);
        if (subgroupElect())
            y[row] = total;
    }

}

