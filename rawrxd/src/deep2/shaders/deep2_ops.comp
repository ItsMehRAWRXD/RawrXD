#version 450
// Batch 9 Deep2 generic correctness-first GPU ops.
// No external shader libraries.
layout(local_size_x = 64) in;

layout(set=0,binding=0,std430) buffer A0 { float a[]; };
layout(set=0,binding=1,std430) buffer B0 { float b[]; };
layout(set=0,binding=2,std430) buffer C0 { float c[]; };
layout(set=0,binding=3,std430) buffer D0 { float d[]; };

layout(push_constant) uniform Push {
    uint op;
    uint n;
    uint p0;
    uint p1;
    uint p2;
    uint p3;
    uint p4;
    uint p5;
    float f0;
    float f1;
} pc;

const uint OP_PROBE    = 0u;
const uint OP_GEMV_F32 = 1u;
const uint OP_RMSNORM  = 2u;
const uint OP_RESIDUAL = 3u;
const uint OP_SWIGLU   = 4u;
const uint OP_ROPE     = 5u;
const uint OP_ATTN     = 6u;
const uint OP_MLA_ATTN = 7u;

void main() {
    uint gid = gl_GlobalInvocationID.x;

    if (pc.op == OP_PROBE) {
        if (gid < pc.n) c[gid] = a[gid] * pc.f0 + pc.f1;
        return;
    }

    if (pc.op == OP_GEMV_F32) {
        uint row = gid;
        uint rows = pc.n;
        uint cols = pc.p0;
        if (row >= rows) return;
        float acc = 0.0;
        uint off = row * cols;
        for (uint j = 0u; j < cols; ++j) acc += a[off + j] * b[j];
        c[row] = acc;
        return;
    }

    if (pc.op == OP_RMSNORM) {
        if (gid >= pc.n) return;
        float ss = 0.0;
        for (uint j = 0u; j < pc.n; ++j) ss += a[j] * a[j];
        float inv = inversesqrt(ss / float(pc.n) + pc.f0);
        c[gid] = a[gid] * inv * b[gid];
        return;
    }

    if (pc.op == OP_RESIDUAL) {
        if (gid < pc.n) c[gid] = a[gid] + b[gid];
        return;
    }

    if (pc.op == OP_SWIGLU) {
        if (gid < pc.n) {
            float g = a[gid];
            float silu = g >= 0.0
                ? g / (1.0 + exp(-g))
                : g * exp(g) / (1.0 + exp(g));
            c[gid] = silu * b[gid];
        }
        return;
    }

    if (pc.op == OP_ROPE) {
        // RAWRXD_VULKAN_ROPE_CONVENTION_001
        //
        // This branch implemented ONLY the GPT-J adjacent-pair convention:
        //     rotate (i, i+1) for i in [0, rotaryDim) step 2
        //     invFreq = theta^(-2*pair/rotaryDim)
        //
        // Deep2Engine::applyRoPE selects the convention from the architecture
        // and applies the NeoX ROTATED-HALF pairing for llama, qwen, qwen2,
        // mistral, baichuan, yi, olmo, starchat, replit, refact, stablelm and
        // deepseek2:
        //     rotate (i, i + rotaryDim/2) for i in [0, rotaryDim/2)
        //     invFreq = theta^(-i/(rotaryDim/2))
        //
        // Those are two different rotations of the same vector. The divergence
        // is INVISIBLE at position 0, where angle = 0, cos = 1 and sin = 0 make
        // both conventions the identity -- which is exactly why this survived
        // every position-0 gate, every "step 0 matches" bisection, and every
        // L2 comparison, and only appeared once a second visible position made
        // the (incorrectly rotated) K visible to attention.
        //
        // pc.f1 carries the rotary dimension in its integral part and the NeoX
        // flag in its fractional part. OpsPush has no free integer field: p0..p5
        // and n are all live, and f0 is theta.
        uint headDim = pc.p0;
        uint heads = pc.p1;
        uint kvHeads = pc.p2;
        uint pos = pc.p3;
        uint rotaryDim = uint(pc.f1);
        // The style flag lives in the fractional part as exactly 0.5, and the
        // test is `> 0.25` rather than `> 0.5`: for f1 = 64.5, `pc.f1 - float(64)`
        // is exactly 0.5f, so a `> 0.5` test is FALSE and the NeoX branch never
        // activates. That is what the first attempt did, and it left the output
        // bit-identical to the unfixed shader -- which is precisely why a fix
        // that cannot be distinguished from no fix must be verified by output.
        bool neox = (pc.f1 - float(rotaryDim)) > 0.25;
        if (rotaryDim == 0u || rotaryDim > headDim) rotaryDim = headDim;
        rotaryDim &= ~1u;                 // must be even
        if (rotaryDim == 0u) return;
        // NeoX rotates HALF as many pairs, each spanning the full head.
        uint pairsPerHead = rotaryDim / 2u;
        uint allHeads = heads + kvHeads;
        uint totalPairs = allHeads * pairsPerHead;
        if (gid >= totalPairs || headDim == 0u || pc.f0 <= 0.0) return;

        uint h = gid / pairsPerHead;
        uint pair = gid % pairsPerHead;
        uint halfRot = rotaryDim / 2u;
        float exponent = neox
            ? -float(pair) / float(halfRot)
            : -float(pair * 2u) / float(rotaryDim);
        float theta = float(pos) * pow(pc.f0, exponent);
        float cs = cos(theta);
        float sn = sin(theta);

        if (h < heads) {
            uint i0 = neox ? (h * headDim + pair) : (h * headDim + pair * 2u);
            uint i1 = neox ? (i0 + halfRot) : (i0 + 1u);
            float x0 = a[i0], x1 = a[i1];
            a[i0] = x0 * cs - x1 * sn;
            a[i1] = x0 * sn + x1 * cs;
        } else {
            uint kh = h - heads;
            uint i0 = neox ? (kh * headDim + pair) : (kh * headDim + pair * 2u);
            uint i1 = neox ? (i0 + halfRot) : (i0 + 1u);
            float x0 = b[i0], x1 = b[i1];
            b[i0] = x0 * cs - x1 * sn;
            b[i1] = x0 * sn + x1 * cs;
        }
        return;
    }

    if (pc.op == OP_ATTN) {
        // a=Q, b=K cache, c=V cache, d=output
        uint headDim = pc.p0;
        uint heads = pc.p1;
        uint kvHeads = pc.p2;
        uint seqLen = pc.p3;
        uint kvDim = pc.p4;
        uint layerBase = pc.p5; // float-element offset into layer's cache
        uint total = heads * headDim;
        if (gid >= total || kvHeads == 0u || heads % kvHeads != 0u) return;

        uint h = gid / headDim;
        uint od = gid % headDim;
        uint group = heads / kvHeads;
        uint kh = h / group;

        float maxScore = -3.402823466e+38;
        for (uint t = 0u; t < seqLen; ++t) {
            uint kb = layerBase + t * kvDim + kh * headDim;
            float s = 0.0;
            uint qb = h * headDim;
            for (uint j = 0u; j < headDim; ++j)
                s += a[qb + j] * b[kb + j];
            s *= pc.f0;
            maxScore = max(maxScore, s);
        }

        float denom = 0.0;
        float numer = 0.0;
        for (uint t = 0u; t < seqLen; ++t) {
            uint kb = layerBase + t * kvDim + kh * headDim;
            float s = 0.0;
            uint qb = h * headDim;
            for (uint j = 0u; j < headDim; ++j)
                s += a[qb + j] * b[kb + j];
            s *= pc.f0;
            float e = exp(s - maxScore);
            denom += e;
            numer += e * c[kb + od];
        }
        d[gid] = denom > 0.0 ? numer / denom : 0.0;
        return;
    }

    if (pc.op == OP_MLA_ATTN) {
        // a=Q [heads,keyLen]
        // b=K cache [layer,position,heads,keyLen]
        // c=V cache [layer,position,heads,valueLen]
        // d=output [heads,valueLen]
        uint keyLen = pc.p0;
        uint valueLen = pc.p1;
        uint heads = pc.p2;
        uint seqLen = pc.p3;
        uint capacity = pc.p4;
        uint layer = pc.p5;
        uint total = heads * valueLen;
        if (gid >= total || keyLen == 0u || valueLen == 0u ||
            heads == 0u || seqLen == 0u || seqLen > capacity) return;

        uint h = gid / valueLen;
        uint od = gid % valueLen;
        uint qb = h * keyLen;

        float maxScore = -3.402823466e+38;
        for (uint t = 0u; t < seqLen; ++t) {
            uint kb = ((layer * capacity + t) * heads + h) * keyLen;
            float score = 0.0;
            for (uint j = 0u; j < keyLen; ++j)
                score += a[qb + j] * b[kb + j];
            score *= pc.f0;
            maxScore = max(maxScore, score);
        }

        float denom = 0.0;
        float numer = 0.0;
        for (uint t = 0u; t < seqLen; ++t) {
            uint kb = ((layer * capacity + t) * heads + h) * keyLen;
            uint vb = ((layer * capacity + t) * heads + h) * valueLen;
            float score = 0.0;
            for (uint j = 0u; j < keyLen; ++j)
                score += a[qb + j] * b[kb + j];
            score *= pc.f0;
            float e = exp(score - maxScore);
            denom += e;
            numer += e * c[vb + od];
        }
        d[gid] = denom > 0.0 ? numer / denom : 0.0;
        return;
    }
}
