#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
layout(local_size_x=256) in;

layout(set=0,binding=0,std430) readonly buffer W0 { uint w[]; };
layout(set=0,binding=1,std430) readonly buffer X0 { float x[]; };
layout(set=0,binding=2,std430) writeonly buffer Y0 { float y[]; };

layout(push_constant) uniform Push {
    uint type;
    uint rows;
    uint cols;
    uint weightBytes;
    uint batch;
} pc;

shared float xs[4][256];

uint getb(uint byteIndex) {
    uint word=w[byteIndex>>2u];
    return (word>>((byteIndex&3u)*8u))&255u;
}
float geth(uint byteIndex) {
    uint h=getb(byteIndex)|(getb(byteIndex+1u)<<8u);
    return unpackHalf2x16(h).x;
}
void q4kScaleMin(uint base,uint sb,out uint sc,out uint mn) {
    if(sb<4u) {
        sc=getb(base+4u+sb)&63u;
        mn=getb(base+8u+sb)&63u;
    } else {
        uint j=sb-4u;
        sc=(getb(base+12u+j)&15u) |
           ((getb(base+4u+j)>>6u)<<4u);
        mn=(getb(base+12u+j)>>4u) |
           ((getb(base+8u+j)>>6u)<<4u);
    }
}
float q4kWeight(uint rowBase,uint col) {
    uint block=col>>8u;
    uint idx=col&255u;
    uint b=rowBase+block*144u;
    float d=geth(b);
    float dm=geth(b+2u);
    uint sb=idx>>5u;
    uint l=idx&31u;
    uint sc,mn;
    q4kScaleMin(b,sb,sc,mn);
    uint pair=sb>>1u;
    uint packed=getb(b+16u+pair*32u+l);
    uint q=(sb&1u)==0u ? (packed&15u) : (packed>>4u);
    return d*float(sc)*float(q)-dm*float(mn);
}

void q4kDot4(uint rowBase,uint globalCol,uint localCol,
             inout float a0,inout float a1,inout float a2,inout float a3) {
    uint block=globalCol>>8u;
    uint idx=globalCol&255u;
    uint b=rowBase+block*144u;
    float d=geth(b);
    float dm=geth(b+2u);
    uint sb=idx>>5u;
    uint l=idx&31u;
    uint sc,mn;
    q4kScaleMin(b,sb,sc,mn);
    uint pair=sb>>1u;
    uint packed4=w[(b+16u+pair*32u+l)>>2u];
    float ds=d*float(sc);
    float ms=dm*float(mn);
    for(uint k=0u;k<4u;++k) {
        uint col=globalCol+k;
        if(col>=pc.cols) break;
        uint packed=(packed4>>(k*8u))&255u;
        uint q=(sb&1u)==0u?(packed&15u):(packed>>4u);
        float ww=ds*float(q)-ms;
        uint local=localCol+k;
        a0+=ww*xs[0][local];
        if(pc.batch>1u) a1+=ww*xs[1][local];
        if(pc.batch>2u) a2+=ww*xs[2][local];
        if(pc.batch>3u) a3+=ww*xs[3][local];
    }
}

int gets8(uint byteIndex) {
    int v=int(getb(byteIndex));
    return v>=128 ? v-256 : v;
}
float q6kWeight(uint rowBase,uint col) {
    uint block=col>>8u;
    uint idx=col&255u;
    uint b=rowBase+block*210u;
    float d=geth(b+208u);
    uint hi128=idx>>7u;
    uint within=idx&127u;
    uint cat=within>>5u;
    uint l=within&31u;
    uint is=l>>4u;
    uint qlBase=b+hi128*64u;
    uint qhBase=b+128u+hi128*32u;
    uint scBase=b+192u+hi128*8u;
    uint q=0u;
    uint scIndex=0u;
    if(cat==0u) {
        q=(getb(qlBase+l)&15u)|(((getb(qhBase+l)>>0u)&3u)<<4u);
        scIndex=is;
    } else if(cat==1u) {
        q=(getb(qlBase+l+32u)&15u)|(((getb(qhBase+l)>>2u)&3u)<<4u);
        scIndex=is+2u;
    } else if(cat==2u) {
        q=(getb(qlBase+l)>>4u)|(((getb(qhBase+l)>>4u)&3u)<<4u);
        scIndex=is+4u;
    } else {
        q=(getb(qlBase+l+32u)>>4u)|(((getb(qhBase+l)>>6u)&3u)<<4u);
        scIndex=is+6u;
    }
    return d*float(gets8(scBase+scIndex))*float(int(q)-32);
}

void q6kDot4(uint rowBase,uint globalCol,uint localCol,
             inout float a0,inout float a1,inout float a2,inout float a3) {
    uint block=globalCol>>8u;
    uint b=rowBase+block*210u;
    for(uint k=0u;k<4u;++k) {
        uint col=globalCol+k;
        if(col>=pc.cols) break;
        uint element=col&255u;
        uint elementHalf=element>>7u;
        uint elementWithin=element&127u;
        uint elementCat=elementWithin>>5u;
        uint elementL=elementWithin&31u;
        uint elementQ=(getb(b+elementHalf*64u+(elementCat&1u)*32u+elementL)
                      >>((elementCat>>1u)*4u))&15u;
        uint elementHigh=(getb(b+128u+elementHalf*32u+elementL)
                         >>((elementCat&3u)*2u))&3u;
        uint elementScale=elementHalf*8u+(elementCat<<1u)+(elementL>>4u);
        float ww=geth(b+208u)*float(gets8(b+192u+elementScale))
                 *float(int(elementQ|(elementHigh<<4u))-32);
        uint local=localCol+k;
        a0+=ww*xs[0][local];
        if(pc.batch>1u) a1+=ww*xs[1][local];
        if(pc.batch>2u) a2+=ww*xs[2][local];
        if(pc.batch>3u) a3+=ww*xs[3][local];
    }
}

void main() {
    if((pc.type!=12u&&pc.type!=14u)||pc.batch==0u||pc.batch>4u||pc.cols==0u) return;

    uint lid=gl_LocalInvocationID.x;
    uint subgroupSize=gl_SubgroupSize;
    uint lane=gl_SubgroupInvocationID;
    uint row=gl_WorkGroupID.x*gl_NumSubgroups+gl_SubgroupID;
    uint blocks=(pc.cols+255u)>>8u;
    uint rowBytes=blocks*(pc.type==14u?210u:144u);

    float a0=0.0,a1=0.0,a2=0.0,a3=0.0;
    for(uint blk=0u;blk<blocks;++blk) {
        uint colBase=blk*256u;
        uint c=colBase+lid;
        if(c<pc.cols) {
            xs[0][lid]=x[c];
            xs[1][lid]=pc.batch>1u?x[pc.cols+c]:0.0;
            xs[2][lid]=pc.batch>2u?x[2u*pc.cols+c]:0.0;
            xs[3][lid]=pc.batch>3u?x[3u*pc.cols+c]:0.0;
        } else {
            xs[0][lid]=xs[1][lid]=xs[2][lid]=xs[3][lid]=0.0;
        }
        barrier();

        if(row<pc.rows && subgroupSize <= 256u &&
           (256u % subgroupSize) == 0u) {
            uint rb=row*rowBytes;
            uint valuesPerLane=256u/subgroupSize;
            if(pc.type==14u) {
                for(uint k=0u;k<valuesPerLane;k+=4u) {
                    uint lc=lane*valuesPerLane+k;
                    uint gc=colBase+lc;
                    if(gc>=pc.cols) continue;
                    q6kDot4(rb,gc,lc,a0,a1,a2,a3);
                }
            } else {
                for(uint k=0u;k<valuesPerLane;k+=4u) {
                    uint lc=lane*valuesPerLane+k;
                    uint gc=colBase+lc;
                    if(gc<pc.cols)
                        q4kDot4(rb,gc,lc,a0,a1,a2,a3);
                }
            }
        }
        barrier();
    }

    // One reduction per output row; unlike the old shared tree this does not
    // serialize all eight row cohorts through five workgroup barriers.
    float t0=subgroupAdd(a0);
    float t1=subgroupAdd(a1);
    float t2=subgroupAdd(a2);
    float t3=subgroupAdd(a3);
    if(subgroupElect()&&row<pc.rows) {
        y[row]=t0;
        if(pc.batch>1u)y[pc.rows+row]=t1;
        if(pc.batch>2u)y[2u*pc.rows+row]=t2;
        if(pc.batch>3u)y[3u*pc.rows+row]=t3;
    }
}
