@@
     uint64_t vulkanSlotSpecArenaFlips(unsigned slot) const;
+    uint64_t vulkanSlotQ4KBatch8RowOps(unsigned slot) const;
+    uint64_t vulkanSlotQ4KAutotuneRuns(unsigned slot) const;
+    uint64_t vulkanSlotRecordedQ4KSubmits(unsigned slot) const;
+    uint64_t vulkanSlotRecordedQ4KBuilds(unsigned slot) const;

diff --git a/~dev/rawrxd/src/deep2/Deep2Engine_VulkanRuntime.cpp b/~dev/rawrxd/src/deep2/Deep2Engine_VulkanRuntime.cpp
--- a/~dev/rawrxd/src/deep2/Deep2Engine_VulkanRuntime.cpp
+++ b/~dev/rawrxd/src/deep2/Deep2Engine_VulkanRuntime.cpp
@@
+uint64_t Deep2Engine::vulkanSlotQ4KBatch8RowOps(unsigned slot) const {
+    auto* vc=getVulkanComputeSlot(slot);
+    return vc?vc->Q4KBatch8RowOps():0;
+}
+uint64_t Deep2Engine::vulkanSlotQ4KAutotuneRuns(unsigned slot) const {
+    auto* vc=getVulkanComputeSlot(slot);
+    return vc?vc->Q4KAutotuneRuns():0;
+}
+uint64_t Deep2Engine::vulkanSlotRecordedQ4KSubmits(unsigned slot) const {
+    auto* vc=getVulkanComputeSlot(slot);
+    return vc?vc->RecordedQ4KSubmits():0;
+}
+uint64_t Deep2Engine::vulkanSlotRecordedQ4KBuilds(unsigned slot) const {
+    auto* vc=getVulkanComputeSlot(slot);
+    return vc?vc->RecordedQ4KBuilds():0;
+}

