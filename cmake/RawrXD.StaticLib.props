<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- RawrXD.StaticLib.props - Property sheet for Static Library projects -->
  <!-- Import this AFTER RawrXD.Common.props -->
  
  <PropertyGroup Label="RawrXD StaticLib Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <TargetExtension>.lib</TargetExtension>
  </PropertyGroup>

  <PropertyGroup Label="RawrXD StaticLib Debug" Condition="'$(Configuration)'=='Debug'">
    <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
  </PropertyGroup>

  <PropertyGroup Label="RawrXD StaticLib Release" Condition="'$(Configuration)'=='Release'">
    <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
  </PropertyGroup>

  <PropertyGroup Label="RawrXD StaticLib RelWithDebInfo" Condition="'$(Configuration)'=='RelWithDebInfo'">
    <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
  </PropertyGroup>

  <PropertyGroup Label="RawrXD StaticLib MinSizeRel" Condition="'$(Configuration)'=='MinSizeRel'">
    <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
  </PropertyGroup>

  <!-- Static library linker settings (lib.exe) -->
  <ItemDefinitionGroup>
    <Lib>
      <SuppressStartupBanner>true</SuppressStartupBanner>
      <LinkTimeCodeGeneration Condition="'$(Configuration)'!='Debug'">UseLinkTimeCodeGeneration</LinkTimeCodeGeneration>
      <LinkTimeCodeGeneration Condition="'$(Configuration)'=='Debug'">Default</LinkTimeCodeGeneration>
    </Lib>
  </ItemDefinitionGroup>
</Project>