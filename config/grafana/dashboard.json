{
  "dashboard": {
    "title": "RawrXD Performance Dashboard",
    "tags": ["rawrxd", "llm", "inference"],
    "timezone": "browser",
    "schemaVersion": 36,
    "refresh": "5s",
    "panels": [
      {
        "id": 1,
        "title": "Requests per Second",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(rawrxd_requests_total[1m])",
            "legendFormat": "RPS"
          }
        ],
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Latency (p50/p95/p99)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(rawrxd_request_duration_seconds_bucket[5m]))",
            "legendFormat": "p50"
          },
          {
            "expr": "histogram_quantile(0.95, rate(rawrxd_request_duration_seconds_bucket[5m]))",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(rawrxd_request_duration_seconds_bucket[5m]))",
            "legendFormat": "p99"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 6, "y": 0}
      },
      {
        "id": 3,
        "title": "Tokens per Second",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(rawrxd_tokens_generated_total[1m])",
            "legendFormat": "Tokens/s"
          }
        ],
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0}
      },
      {
        "id": 4,
        "title": "KV Cache Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "rawrxd_kv_cache_usage_bytes",
            "legendFormat": "Cache Usage"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 5,
        "title": "GPU Memory Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "rawrxd_gpu_memory_usage_bytes",
            "legendFormat": "GPU Memory"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      },
      {
        "id": 6,
        "title": "Batch Size Distribution",
        "type": "heatmap",
        "targets": [
          {
            "expr": "rawrxd_batch_size_bucket",
            "legendFormat": "Batch Size"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
      },
      {
        "id": 7,
        "title": "Error Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(rawrxd_requests_failed_total[1m])",
            "legendFormat": "Errors/s"
          }
        ],
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 16}
      },
      {
        "id": 8,
        "title": "Active Connections",
        "type": "stat",
        "targets": [
          {
            "expr": "rawrxd_active_connections",
            "legendFormat": "Connections"
          }
        ],
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 16}
      }
    ]
  }
}
