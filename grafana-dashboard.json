{
  "dashboard": {
    "id": null,
    "title": "RawrXD IDE Telemetry Dashboard",
    "tags": ["rawrxd", "telemetry", "inference"],
    "timezone": "browser",
    "schemaVersion": 36,
    "refresh": "5s",
    "panels": [
      {
        "id": 1,
        "title": "Inference Throughput",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(rawrxd_inference_total[1m])",
            "legendFormat": "Inferences/sec"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 30},
                {"color": "green", "value": 47}
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Token Generation Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(rawrxd_tokens_generated_total[1m])",
            "legendFormat": "Tokens/sec"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "tps",
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 40},
                {"color": "green", "value": 47}
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0}
      },
      {
        "id": 3,
        "title": "Average Latency",
        "type": "gauge",
        "targets": [
          {
            "expr": "rawrxd_latency_average_ms",
            "legendFormat": "Latency"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "min": 0,
            "max": 100,
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 22},
                {"color": "red", "value": 50}
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0}
      },
      {
        "id": 4,
        "title": "Cache Hit Rate",
        "type": "gauge",
        "targets": [
          {
            "expr": "rawrxd_cache_hit_rate_percent",
            "legendFormat": "Hit Rate %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 80},
                {"color": "green", "value": 95}
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0}
      },
      {
        "id": 5,
        "title": "Latency Distribution (P99)",
        "type": "heatmap",
        "targets": [
          {
            "expr": "rate(rawrxd_latency_histogram_bucket[1m])",
            "legendFormat": "{{le}}"
          }
        ],
        "dataFormat": "tsbuckets",
        "heatmap": {},
        "gridPos": {"h": 10, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 6,
        "title": "Quantization Distribution",
        "type": "piechart",
        "targets": [
          {
            "expr": "rawrxd_quantization_usage",
            "legendFormat": "{{type}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            }
          }
        },
        "gridPos": {"h": 10, "w": 6, "x": 12, "y": 8}
      },
      {
        "id": 7,
        "title": "Security Events",
        "type": "stat",
        "targets": [
          {
            "expr": "rawrxd_security_events_total",
            "legendFormat": "Events"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "red", "value": 1}
              ]
            }
          }
        },
        "gridPos": {"h": 10, "w": 6, "x": 18, "y": 8}
      },
      {
        "id": 8,
        "title": "Cache Performance Over Time",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(rawrxd_cache_hits_total[1m])",
            "legendFormat": "Cache Hits/sec"
          },
          {
            "expr": "rate(rawrxd_cache_misses_total[1m])",
            "legendFormat": "Cache Misses/sec"
          }
        ],
        "gridPos": {"h": 10, "w": 12, "x": 0, "y": 18}
      },
      {
        "id": 9,
        "title": "Inference Volume",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(rawrxd_inference_total[5m])",
            "legendFormat": "Inferences/sec (5m avg)"
          }
        ],
        "gridPos": {"h": 10, "w": 12, "x": 12, "y": 18}
      },
      {
        "id": 10,
        "title": "System Health",
        "type": "row",
        "collapsed": false,
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 28}
      },
      {
        "id": 11,
        "title": "Cost Optimization Metrics",
        "type": "stat",
        "targets": [
          {
            "expr": "(rawrxd_quantization_usage{type=\"INT8\"} / sum(rawrxd_quantization_usage)) * 100",
            "legendFormat": "INT8 Usage %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "steps": [
                {"color": "yellow", "value": 0},
                {"color": "green", "value": 80}
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 29}
      },
      {
        "id": 12,
        "title": "Estimated Cost Savings",
        "type": "stat",
        "targets": [
          {
            "expr": "(rawrxd_quantization_usage{type=\"INT8\"} / sum(rawrxd_quantization_usage)) * 43800",
            "legendFormat": "Annual Savings $"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD"
          }
        },
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 29}
      },
      {
        "id": 13,
        "title": "Node Consolidation Status",
        "type": "stat",
        "targets": [
          {
            "expr": "18",
            "legendFormat": "Nodes Consolidated"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"fixedColor": "green", "mode": "fixed"}
          }
        },
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 29}
      }
    ],
    "templating": {
      "list": []
    },
    "annotations": {
      "list": [
        {
          "name": "Deployments",
          "datasource": "-- Grafana --",
          "expr": "",
          "iconColor": "blue",
          "tags": ["deployment"]
        }
      ]
    }
  },
  "overwrite": true
}
