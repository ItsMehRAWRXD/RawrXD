; Sovereign_Inference_Dispatcher.asm — Production
include Sovereign_Common.inc
extern Kernel_DotProduct_Int8 : PROC

.code
; RCX = ModelBase, RDX = CurrentLayerIndex
; Returns: RAX = NextLayerIndex (or -1 if complete)
PUBLIC Inference_Dispatch_Layer
Inference_Dispatch_Layer PROC
    push rbx
    mov rbx, rdx        ; Store Index
    
    ; 1. Load Tensor Layer (via GGUF Parser logic)
    ; Call GGUF_GetTensorData logic here
    
    ; 2. Execute Compute (The Math Kernel)
    ; Assuming R8 = 4096 (Vector Size)
    mov r8, 4096
    call Kernel_DotProduct_Int8
    
    ; 3. Increment State
    inc rbx
    mov rax, rbx
    
    ; 4. Bounds Check (Hardcoded Layer Max for v24 Production)
    cmp rax, 32         ; Max Layers
    jl @done
    mov rax, -1         ; Sequence Complete
    
@done:
    pop rbx
    ret
Inference_Dispatch_Layer ENDP
END
