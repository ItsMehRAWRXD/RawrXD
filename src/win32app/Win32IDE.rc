#include "Win32IDE_CommandIDs.h"

IDR_MAIN_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New\tCtrl+N",            IDM_FILE_NEW
        MENUITEM "&Open...\tCtrl+O",        IDM_FILE_OPEN
        MENUITEM "&Save\tCtrl+S",           IDM_FILE_SAVE
        MENUITEM "Save &As...\tCtrl+Shift+S", IDM_FILE_SAVEAS
        SEPARATOR
        MENUITEM "E&xit",                 IDM_FILE_EXIT
    END
    POPUP "&Build"
    BEGIN
        MENUITEM "&Compile",              IDM_BUILD_COMPILE
        MENUITEM "&Execute",              IDM_BUILD_RUN
        MENUITEM "&Clean",                IDM_BUILD_CLEAN
        SEPARATOR
        MENUITEM "&Analyze PE",           IDM_TOOLS_ANALYZE
    END
    POPUP "&Tools"
    BEGIN
        MENUITEM "&Options...\tCtrl+P",   IDM_TOOLS_OPTIONS
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About...\tF1",           IDM_HELP_ABOUT
    END
END