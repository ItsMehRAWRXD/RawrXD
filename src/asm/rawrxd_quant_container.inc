; ============================================================================
; RawrXD Quant Container Offsets
; Shared binary contract for offline packers and MASM loaders.
; ============================================================================

IFNDEF RAWRXD_QUANT_CONTAINER_INC
RAWRXD_QUANT_CONTAINER_INC EQU 1

; File type tags
RAWRXD_QUANT_MAGIC            EQU 046515852h ; 'RXQF' little-endian
RAWRXD_QUANT_VERSION_1        EQU 1
RAWRXD_QUANT_NAMES_MAGIC      EQU 04D4E5152h ; 'RQNM' little-endian
RAWRXD_QUANT_NAMES_VERSION_1  EQU 1

RAWRXD_QUANT_FILE_FP16        EQU 1
RAWRXD_QUANT_FILE_INT8        EQU 2
RAWRXD_QUANT_FILE_INT4        EQU 3
RAWRXD_QUANT_FILE_INT4_NF     EQU 4

; File header offsets
RXQF_MAGIC_OFF                EQU 0
RXQF_VERSION_OFF              EQU 4
RXQF_ENDIANNESS_OFF           EQU 8
RXQF_HEADER_BYTES_OFF         EQU 12
RXQF_DESCRIPTOR_BYTES_OFF     EQU 16
RXQF_SHAPE_BYTES_OFF          EQU 20
RXQF_TENSOR_COUNT_OFF         EQU 24
RXQF_CHUNK_COUNT_OFF          EQU 32
RXQF_GLOBAL_ALIGNMENT_OFF     EQU 40
RXQF_DESCRIPTOR_TABLE_OFF     EQU 48
RXQF_SHAPE_TABLE_OFF          EQU 56
RXQF_PAYLOAD_OFF              EQU 64
RXQF_PAYLOAD_BYTES_OFF        EQU 72
RXQF_MODEL_CRC64_OFF          EQU 80
RXQF_RESERVED0_OFF            EQU 88
RXQF_HEADER_SIZE              EQU 96

; Optional name table header offsets
RXQF_NAMES_MAGIC_OFF          EQU 0
RXQF_NAMES_VERSION_OFF        EQU 4
RXQF_NAMES_TENSOR_COUNT_OFF   EQU 8
RXQF_NAMES_HEADER_SIZE        EQU 16

; Tensor descriptor offsets
RXQF_DESC_NAME_HASH_OFF       EQU 0
RXQF_DESC_TENSOR_KIND_OFF     EQU 8
RXQF_DESC_QUANT_MODE_OFF      EQU 12
RXQF_DESC_BLOCK_SIZE_OFF      EQU 16
RXQF_DESC_FLAGS_OFF           EQU 20
RXQF_DESC_ELEMENT_COUNT_OFF   EQU 24
RXQF_DESC_PAYLOAD_OFF         EQU 32
RXQF_DESC_PAYLOAD_BYTES_OFF   EQU 40
RXQF_DESC_SCALE_OFF           EQU 48
RXQF_DESC_SCALE_BYTES_OFF     EQU 56
RXQF_DESC_ZEROPOINT_OFF       EQU 64
RXQF_DESC_ZEROPOINT_BYTES_OFF EQU 72
RXQF_DESC_ALIGNMENT_OFF       EQU 80
RXQF_DESC_SHAPE_OFF           EQU 84
RXQF_DESC_SHAPE_BYTES_OFF     EQU 88
RXQF_DESC_RESERVED0_OFF       EQU 92
RXQF_DESC_SIZE                EQU 96

; Shape record offsets
RXQF_SHAPE_RANK_OFF           EQU 0
RXQF_SHAPE_RESERVED0_OFF      EQU 4
RXQF_SHAPE_DIMS_OFF           EQU 8
RXQF_SHAPE_SIZE               EQU 72

; Flags
RXQF_FLAG_HAS_SCALE           EQU 1
RXQF_FLAG_HAS_ZEROPOINT       EQU 2
RXQF_FLAG_BLOCK_BASED         EQU 4
RXQF_FLAG_SHAPE_INLINE        EQU 8
RXQF_FLAG_NAME_HASHED         EQU 16

ENDIF
