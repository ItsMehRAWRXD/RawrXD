#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Highly optimized tiled MatMul for RDNA3 - RX 7800 XT
// Uses 32x32 tiles with shared memory for 100x+ speedup
// Target: 100+ tok/s at 32K context

layout(local_size_x = 32, local_size_y = 32, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer MatrixA {
    float16_t data[];
} matrix_a;

layout(set = 0, binding = 1) readonly buffer MatrixB {
    float16_t data[];
} matrix_b;

layout(set = 0, binding = 2) writeonly buffer MatrixC {
    float16_t data[];
} matrix_c;

layout(push_constant) uniform PushConstants {
    uint M;
    uint N;
    uint K;
} params;

// Shared memory for tiles - 32x32 FP16 = 2KB per tile
// A tile: 32x32, B tile: 32x32
shared float16_t tile_a[32][32];
shared float16_t tile_b[32][32];

void main() {
    uint local_x = gl_LocalInvocationID.x;
    uint local_y = gl_LocalInvocationID.y;
    uint group_x = gl_WorkGroupID.x;
    uint group_y = gl_WorkGroupID.y;
    
    // Global output position
    uint global_row = group_y * 32 + local_y;
    uint global_col = group_x * 32 + local_x;
    
    // Check bounds
    if (global_row >= params.M || global_col >= params.N) return;
    
    // Accumulator
    float16_t acc = float16_t(0.0);
    
    // Number of tiles in K dimension
    uint num_tiles = (params.K + 31) / 32;
    
    for (uint tile_k = 0; tile_k < num_tiles; tile_k++) {
        uint k_start = tile_k * 32;
        
        // Load tile from A (M x K)
        // A[row, k_start + local_x] where row = global_row
        uint a_col = k_start + local_x;
        if (a_col < params.K && global_row < params.M) {
            tile_a[local_y][local_x] = matrix_a.data[global_row * params.K + a_col];
        } else {
            tile_a[local_y][local_x] = float16_t(0.0);
        }
        
        // Load tile from B (K x N)
        // B[k_start + local_y, global_col]
        uint b_row = k_start + local_y;
        if (b_row < params.K && global_col < params.N) {
            tile_b[local_y][local_x] = matrix_b.data[b_row * params.N + global_col];
        } else {
            tile_b[local_y][local_x] = float16_t(0.0);
        }
        
        // Synchronize - all threads must finish loading
        barrier();
        
        // Compute partial dot product for this tile
        // Each thread computes one element of the output
        for (uint k = 0; k < 32; k++) {
            acc += tile_a[local_y][k] * tile_b[k][local_x];
        }
        
        // Synchronize before next tile load
        barrier();
    }
    
    // Write output
    matrix_c.data[global_row * params.N + global_col] = acc;
}
