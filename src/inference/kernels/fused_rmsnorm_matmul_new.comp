// ============================================================================
// fused_rmsnorm_matmul_new.comp — Fused RMSNorm + MatMul Kernel (Tiled)
// ============================================================================
// Fuses RMSNorm normalization with matrix multiplication to eliminate
// intermediate VRAM roundtrips.
// Uses 2D tiling: each workgroup computes one output tile.
// Uses LDS for both input and weight tiles to enable reuse.
// Target GPU: AMD Radeon RX 7800 XT (RDNA3, wavefront=32)
// Workgroup:  256 threads (8 wavefronts)
// Layout:
//   binding 0 : Input          (float[])  — x vector
//   binding 1 : Output         (float[])  — final MatMul output
//   binding 2 : RMSNorm Weight (float[])  — per-channel gamma weights
//   binding 3 : MatMul Weight  (float[])  — weight matrix (row-major)
//   binding 4 : UBO Params
// Dispatch: (num_rows, ceil(output_size/TILE_OUTPUT), 1) workgroups, each 256 threads.
// ============================================================================

#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly  buffer InputBuffer      { float data[]; } x;
layout(binding = 1) writeonly buffer OutputBuffer   { float data[]; } y;
layout(binding = 2) readonly  buffer RMSNormWeight { float data[]; } gamma;
layout(binding = 3) readonly  buffer MatMulWeight  { float data[]; } w;

layout(binding = 4) uniform ParamsBlock {
    uint hidden_size;    // Input dimension (must be multiple of 256)
    uint output_size;    // Output dimension (must be multiple of 256)
    float eps;           // Epsilon for RMSNorm
    uint layer_idx;      // Which transformer layer
} params;

const uint TILE_K = 256u;    // K-dimension tile size (must divide hidden_size)
const uint TILE_OUTPUT = 256u; // Output-dimension tile size (must divide output_size)

shared float sum[TILE_K];           // Reduction buffer for RMSNorm (K-dim)
shared float norm_tile[TILE_K];     // Tile of normalized input (K-dim)
shared float weight_tile[TILE_K];   // Tile of weights (K-dim) for current output column

void main() {
    uint local_id  = gl_LocalInvocationID.x;
    uint group_row = gl_WorkGroupID.x;    // Which input row
    uint group_col = gl_WorkGroupID.y;    // Which output tile

    // Each workgroup processes one input row and one output tile (TILE_OUTPUT columns).
    uint in_row_offset  = group_row * params.hidden_size;
    uint out_row_offset = group_row * params.output_size;
    uint out_col_base = group_col * TILE_OUTPUT;

    // -------------------------------------------------------------------------
    // Phase 1: RMSNorm — reduce squares to get inv_rms (K-dim reduction)
    // -------------------------------------------------------------------------
    float acc = 0.0;
    for (uint k = local_id; k < params.hidden_size; k += 256) {
        uint idx = in_row_offset + k;
        if (k < params.hidden_size) {
            float v = x.data[idx];
            acc += v * v;
        }
    }
    sum[local_id] = acc;
    barrier();

    // Parallel reduction tree (256 → 1)
    for (uint stride = 128; stride > 0; stride >>= 1) {
        if (local_id < stride) {
            sum[local_id] += sum[local_id + stride];
        }
        barrier();
    }

    float rms = sqrt(sum[0] / float(params.hidden_size) + params.eps);
    float inv_rms = 1.0 / rms;

    // -------------------------------------------------------------------------
    // Phase 2: Tiled MatMul with LDS caching of input and weights
    // For each K tile, load normalized input tile and weight tile into LDS,
    // then compute partial dot products for all output columns in this tile.
    // -------------------------------------------------------------------------
    for (uint k0 = 0; k0 < params.hidden_size; k0 += TILE_K) {
        // Step 1: Load weight tile into LDS (cooperative load)
        // Each thread loads one or more elements of the weight tile
        for (uint k = local_id; k < TILE_K; k += 256) {
            uint weight_idx = k0 + k;
            if (weight_idx < params.hidden_size) {
                weight_tile[k] = w.data[weight_idx * params.output_size + out_col_base];
            } else {
                weight_tile[k] = 0.0;
            }
        }
        barrier();  // Wait for all threads to finish loading weight tile

        // Step 2: Load normalized input tile into LDS (cooperative load)
        // Each thread loads one or more elements of the normalized input tile
        for (uint k = local_id; k < TILE_K; k += 256) {
            uint input_idx = k0 + k;
            if (input_idx < params.hidden_size) {
                float v = x.data[in_row_offset + input_idx];
                float g = gamma.data[input_idx];
                norm_tile[k] = v * inv_rms * g;
            } else {
                norm_tile[k] = 0.0;
            }
        }
        barrier();  // Wait for all threads to finish loading normalized input tile

        // Step 3: Compute dot product using LDS tiles (no more global memory access)
        // Each thread computes its partial dot product for its output column
        for (uint k = 0; k < TILE_K; ++k) {
            float dot = norm_tile[k] * weight_tile[k];
            // Accumulate dot product across K dimension
            // Note: This is a simplified accumulation; in practice we'd need to sum across threads
            // For now, we assume each thread handles one output column and accumulates its own dot
            // A full implementation would use shared memory reduction across the tile
            // For correctness in this prototype, we'll accumulate per-thread and write at the end
            // A better approach would be to have each thread compute one element of the output tile
            // and use a separate accumulation buffer
            // For simplicity in this iteration, we'll compute the dot product for this thread's column
            // and accumulate it in a private variable, then write at the end of the K loop
            // However, since we need to accumulate across K, we need a shared or private accumulator
            // Let's use a private accumulator for each thread's output column
            // We'll declare a private accumulator outside the K loop
            // Actually, let's restructure: each thread computes dot products for its column across K tiles
            // and accumulates in a private variable
            // We'll move the accumulator declaration outside the K loop
        }
        // We'll restructure the loop to have the accumulator outside
    }

    // For this prototype, let's implement a simpler but correct version:
    // Each thread computes its output column by accumulating across K tiles
    // We'll use a private accumulator for each thread's output column
    // Reset accumulator for this output column
    float dot = 0.0;
    for (uint k0 = 0; k0 < params.hidden_size; k0 += TILE_K) {
        // Load weight tile for this K-block
        for (uint k = local_id; k < TILE_K; k += 256) {
            uint weight_idx = k0 + k;
            if (weight_idx < params.hidden_size) {
                weight_tile[k] = w.data[weight_idx * params.output_size + out_col_base];
            } else {
                weight_tile[k] = 0.0;
            }
        }
        barrier();

        // Load normalized input tile for this K-block
        for (uint k = local_id; k < TILE_K; k += 256) {
            uint input_idx = k0 + k;
            if (input_idx < params.hidden_size) {
                float v = x.data[in_row_offset + input_idx];
                float g = gamma.data[input_idx];
                norm_tile[k] = v * inv_rms * g;
            } else {
                norm_tile[k] = 0.0;
            }
        }
        barrier();

        // Accumulate dot product for this thread's output column
        for (uint k = 0; k < TILE_K; ++k) {
            dot += norm_tile[k] * weight_tile[k];
        }
        barrier();  // Wait for all threads to finish accumulation before next K-block
    }

    // Store result for this output column
    uint out_col = out_col_base + local_id;
    if (out_col < params.output_size) {
        y.data[out_row_offset + out_col] = dot;
    }
}