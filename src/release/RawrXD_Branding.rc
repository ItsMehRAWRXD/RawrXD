#include <windows.h>

// 1. Executable Visual Icon Configuration Location
// IDI_APP_ICON        ICON        "../../assets/branding/app_main.ico"

// 2. Clear System Manifest Binding Integration Layout
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "RawrXD.exe.manifest"

// 3. Official Corporate Version Mapping Block Definitions
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Sovereign AI Systems International Inc."
            VALUE "FileDescription",  "RawrXD Edge Inference Node Management Console"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "RawrXDNative"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Sovereign Systems. All Rights Reserved."
            VALUE "OriginalFilename", "RawrXD.exe"
            VALUE "ProductName",      "RawrXD Inference Architecture Platform"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
