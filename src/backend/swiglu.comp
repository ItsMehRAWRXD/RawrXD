#version 450
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer Gate { float g[]; };
layout(binding = 1) readonly buffer Up { float u[]; };
layout(binding = 2) writeonly buffer Out { float y[]; };
layout(push_constant) uniform PC { uint n; } pc;
void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pc.n) return;
  float gv = g[i];
  float silu = gv / (1.0 + exp(-gv));
  y[i] = silu * u[i];
}
