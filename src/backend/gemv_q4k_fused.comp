#version 450
// gemv_q4k_fused.comp — packed Q4_K → FMA (no F32 weight expand)
// Twin math of gemv_q4k.comp; activation tile in shared memory.
layout(local_size_x = 64) in;
layout(binding = 0) readonly buffer W { uint packed[]; };
layout(binding = 1) readonly buffer In { float x[]; };
layout(binding = 2) writeonly buffer Out { float y[]; };
layout(push_constant) uniform PC { uint rows; uint cols; } pc;
shared float xs[256];

uint u8(uint off) {
  uint w = packed[off >> 2];
  return (w >> ((off & 3u) * 8u)) & 0xFFu;
}
float f16(uint h) { return unpackHalf2x16(h).x; }

void scmin(uint base, uint j, out uint sc, out uint m) {
  if (j < 4u) {
    sc = u8(base + j) & 63u;
    m = u8(base + j + 4u) & 63u;
  } else {
    uint a = u8(base + j + 4u);
    uint b = u8(base + j - 4u);
    uint c = u8(base + j);
    sc = (a & 15u) | ((b >> 6) << 4);
    m = (a >> 4) | ((c >> 6) << 4);
  }
}

void main() {
  uint row = gl_GlobalInvocationID.x;
  uint lid = gl_LocalInvocationID.x;
  bool rowOk = row < pc.rows;
  uint nblk = (pc.cols + 255u) / 256u;
  uint rowOff = rowOk ? (row * nblk * 144u) : 0u;
  float sum = 0.0;
  for (uint b = 0u; b < nblk; ++b) {
    uint baseX = b * 256u;
    for (uint t = lid; t < 256u; t += 64u) {
      uint ix = baseX + t;
      xs[t] = (ix < pc.cols) ? x[ix] : 0.0;
    }
    barrier();
    if (rowOk) {
      uint blk = rowOff + b * 144u;
      float d = f16(u8(blk) | (u8(blk + 1u) << 8));
      float dmin = f16(u8(blk + 2u) | (u8(blk + 3u) << 8));
      uint scb = blk + 4u;
      uint qbase = blk + 16u;
      for (uint s = 0u; s < 8u; ++s) {
        uint sc, m;
        scmin(scb, s, sc, m);
        float scale = d * float(sc);
        float minv = dmin * float(m);
        uint qo = qbase + s * 16u;
        uint baseIdx = s * 32u;
        for (uint k = 0u; k < 16u; ++k) {
          uint byte = u8(qo + k);
          uint lo = baseIdx + k;
          uint hi = lo + 16u;
          sum += (scale * float(byte & 15u) - minv) * xs[lo];
          sum += (scale * float((byte >> 4) & 15u) - minv) * xs[hi];
        }
      }
    }
    barrier();
  }
  if (rowOk) y[row] = sum;
}
