#version 450
// gemv_q4k_fused.comp — Q4_K GEMV: 4 rows/WG × 16 lane column-split
layout(local_size_x = 64) in;
layout(binding = 0) readonly buffer W { uint packed[]; };
layout(binding = 1) readonly buffer In { float x[]; };
layout(binding = 2) writeonly buffer Out { float y[]; };
layout(push_constant) uniform PC { uint rows; uint cols; } pc;
shared float partial[64];

uint u8(uint off) {
  uint w = packed[off >> 2];
  return (w >> ((off & 3u) * 8u)) & 0xFFu;
}
float f16(uint h) { return unpackHalf2x16(h).x; }

void scmin(uint base, uint j, out uint sc, out uint m) {
  if (j < 4u) {
    sc = u8(base + j) & 63u;
    m = u8(base + j + 4u) & 63u;
  } else {
    uint a = u8(base + j + 4u);
    uint b = u8(base + j - 4u);
    uint c = u8(base + j);
    sc = (a & 15u) | ((b >> 6) << 4);
    m = (a >> 4) | ((c >> 6) << 4);
  }
}

void main() {
  uint lid = gl_LocalInvocationID.x;
  uint rowLocal = lid >> 4;
  uint lane = lid & 15u;
  uint row = gl_WorkGroupID.x * 4u + rowLocal;
  bool rowOk = row < pc.rows;
  uint nblk = (pc.cols + 255u) / 256u;
  uint rowOff = rowOk ? (row * nblk * 144u) : 0u;
  float sum = 0.0;
  if (rowOk) {
    for (uint b = lane; b < nblk; b += 16u) {
      uint blk = rowOff + b * 144u;
      float d = f16(u8(blk) | (u8(blk + 1u) << 8));
      float dmin = f16(u8(blk + 2u) | (u8(blk + 3u) << 8));
      uint scb = blk + 4u;
      uint qbase = blk + 16u;
      // ggml Q4_K paired lo-then-hi over 32 qs bytes per scale pair.
      uint elem = b * 256u;
      for (uint pair = 0u; pair < 4u; ++pair) {
        uint s0 = pair * 2u;
        uint s1 = s0 + 1u;
        uint sc0, m0, sc1, m1;
        scmin(scb, s0, sc0, m0);
        scmin(scb, s1, sc1, m1);
        float scale0 = d * float(sc0);
        float min0 = dmin * float(m0);
        float scale1 = d * float(sc1);
        float min1 = dmin * float(m1);
        uint qo = qbase + pair * 32u;
        uint base0 = elem + pair * 64u;
        for (uint k = 0u; k < 32u; ++k) {
          uint byte = u8(qo + k);
          uint lo = base0 + k;
          uint hi = base0 + 32u + k;
          if (lo < pc.cols)
            sum += (scale0 * float(byte & 15u) - min0) * x[lo];
          if (hi < pc.cols)
            sum += (scale1 * float((byte >> 4) & 15u) - min1) * x[hi];
        }
      }
    }
  }
  partial[lid] = sum;
  barrier();
  uint base = rowLocal << 4;
  if (lane < 8u)
    partial[base + lane] += partial[base + lane + 8u];
  barrier();
  if (lane < 4u)
    partial[base + lane] += partial[base + lane + 4u];
  barrier();
  if (lane < 2u)
    partial[base + lane] += partial[base + lane + 2u];
  barrier();
  if (lane == 0u) {
    float v = partial[base] + partial[base + 1u];
    if (rowOk) y[row] = v;
  }
}
