#version 450
layout(local_size_x = 256) in;
layout(binding = 0) buffer Accum { float a[]; };
layout(binding = 1) readonly buffer Src { float b[]; };
layout(push_constant) uniform PC { uint n; float scale; } pc;
void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i < pc.n) a[i] = a[i] + pc.scale * b[i];
}
