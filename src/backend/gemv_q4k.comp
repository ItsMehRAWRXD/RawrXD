#version 450
// gemv_q4k.comp — fused Q4_K dequant+dot matching ggml dequantize_row_q4_K
// Layout: for scale pair (is,is+1), qs[0..31] lo→group is, hi→group is+1.
// Do NOT use per-16-byte interleaved lo/hi within one scale (pre-VAL-051 bug).
layout(local_size_x = 64) in;
layout(binding = 0) readonly buffer W { uint packed[]; };
layout(binding = 1) readonly buffer In { float x[]; };
layout(binding = 2) writeonly buffer Out { float y[]; };
layout(push_constant) uniform PC { uint rows; uint cols; } pc;

uint u8(uint off) {
  uint w = packed[off >> 2];
  return (w >> ((off & 3u) * 8u)) & 0xFFu;
}
float f16(uint h) { return unpackHalf2x16(h).x; }

void scmin(uint base, uint j, out uint sc, out uint m) {
  if (j < 4u) {
    sc = u8(base + j) & 63u;
    m = u8(base + j + 4u) & 63u;
  } else {
    // llama.cpp get_scale_min_k4: 6-bit scales packed in 12 bytes.
    sc = (u8(base + j + 4u) & 0xFu) | ((u8(base + j - 4u) >> 6u) << 4u);
    m = (u8(base + j + 4u) >> 4u) | ((u8(base + j) >> 6u) << 4u);
  }
}

void main() {
  uint row = gl_GlobalInvocationID.x;
  if (row >= pc.rows) return;
  uint nblk = (pc.cols + 255u) / 256u;
  uint rowOff = row * nblk * 144u;
  float sum = 0.0;
  for (uint b = 0u; b < nblk; ++b) {
    uint blk = rowOff + b * 144u;
    float d = f16(u8(blk) | (u8(blk + 1u) << 8));
    float dmin = f16(u8(blk + 2u) | (u8(blk + 3u) << 8));
    uint scb = blk + 4u;
    uint qbase = blk + 16u;
    uint elem = b * 256u;
    // 4 groups of 64 elements; each uses 32 qs bytes (paired scales).
    for (uint j = 0u; j < 4u; ++j) {
      uint sc0, m0, sc1, m1;
      scmin(scb, j * 2u, sc0, m0);
      scmin(scb, j * 2u + 1u, sc1, m1);
      float d1 = d * float(sc0);
      float m1v = dmin * float(m0);
      float d2 = d * float(sc1);
      float m2v = dmin * float(m1);
      uint qo = qbase + j * 32u;
      uint baseIdx = elem + j * 64u;
      for (uint l = 0u; l < 32u; ++l) {
        uint byte = u8(qo + l);
        if (baseIdx + l < pc.cols)
          sum += (d1 * float(byte & 15u) - m1v) * x[baseIdx + l];
        if (baseIdx + l + 32u < pc.cols)
          sum += (d2 * float((byte >> 4) & 15u) - m2v) * x[baseIdx + l + 32u];
      }
    }
  }
  y[row] = sum;
}
