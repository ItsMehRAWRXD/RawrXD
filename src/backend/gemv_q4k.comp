#version 450
// gemv_q4k.comp — Q4_K×Q8_K integer mul_mat (ggml vec_dot_q4_K_q8_K_generic).
// In = float x; each 256-col block is quantize_row_q8_K'd then integer-dotted.
// FIRST_DIVERGE_001: prior FP32 dequant·x matched dequantize_row_q4_K but
// HARD_L2 vs llama at Q_PRE_ROPE_0 (maxAbs~1.94e-3). Host QuantKernelRegistry
// already uses Q8_K; SPV must match that path (same class as gemv_q6k.comp).
layout(local_size_x = 64) in;
layout(binding = 0) readonly buffer W { uint packed[]; };
layout(binding = 1) readonly buffer In { float x[]; };
layout(binding = 2) writeonly buffer Out { float y[]; };
layout(push_constant) uniform PC { uint rows; uint cols; } pc;

uint u8(uint off) {
  uint w = packed[off >> 2];
  return (w >> ((off & 3u) * 8u)) & 0xFFu;
}
float f16(uint h) { return unpackHalf2x16(h).x; }
int nearest_int_q8k(float fval) {
  float val = fval + 12582912.0;
  uint bits = floatBitsToUint(val);
  return int(bits & 0x007fffffu) - 0x00400000;
}

void main() {
  uint row = gl_GlobalInvocationID.x;
  if (row >= pc.rows) return;
  uint nblk = pc.cols / 256u;
  if (nblk == 0u || (pc.cols % 256u) != 0u) { y[row] = 0.0; return; }

  const uint kmask1 = 0x3f3f3f3fu;
  const uint kmask2 = 0x0f0f0f0fu;
  const uint kmask3 = 0x03030303u;

  uint rowOff = row * nblk * 144u;
  // precise: disable FMA/reassoc (match gemv_q6k; GATE/UP 0-ULP vs llama)
  precise float sumf = 0.0;
  precise float sums[8];
  for (uint i = 0u; i < 8u; ++i) sums[i] = 0.0;

  for (uint b = 0u; b < nblk; ++b) {
    uint base = b * 256u;
    // quantize_row_q8_K for this 256-wide activation tile
    // precise amax/maxv/iscale (annotate-only; SPV hash still 4548BCF1/16868).
    // FFN_DOWN_2 MATERIAL owner = SPV Q4K×Q8K accumulate 1ULP (blk.2 down=Q4_K).
    precise float amax = 0.0, maxv = 0.0;
    for (uint j = 0u; j < 256u; ++j) {
      precise float ax = abs(x[base + j]);
      if (ax > amax) { amax = ax; maxv = x[base + j]; }
    }
    precise float xd = 0.0;
    precise float iscale = 0.0;
    int q8[256];
    int bsums[16];
    for (uint j = 0u; j < 256u; ++j) q8[j] = 0;
    for (uint j = 0u; j < 16u; ++j) bsums[j] = 0;
    if (amax != 0.0) {
      iscale = -127.0 / maxv;
      xd = 1.0 / iscale;
      for (uint j = 0u; j < 256u; ++j) {
        int v = nearest_int_q8k(iscale * x[base + j]);
        q8[j] = (v > 127) ? 127 : v;
      }
      for (uint j = 0u; j < 16u; ++j) {
        int s = 0;
        for (uint ii = 0u; ii < 16u; ++ii) s += q8[j * 16u + ii];
        bsums[j] = s;
      }
    }

    uint blk = rowOff + b * 144u;
    float d = f16(u8(blk) | (u8(blk + 1u) << 8));
    float dmin = f16(u8(blk + 2u) | (u8(blk + 3u) << 8));
    uint qbase = blk + 16u;

    // Expand Q4 nibbles → aux8[256] (grouped lo/hi per 32 qs bytes)
    int aux8[256];
    uint a = 0u;
    for (uint j = 0u; j < 4u; ++j) {
      uint qo = qbase + j * 32u;
      for (uint l = 0u; l < 32u; ++l)
        aux8[a + l] = int(u8(qo + l) & 15u);
      a += 32u;
      for (uint l = 0u; l < 32u; ++l)
        aux8[a + l] = int(u8(qo + l) >> 4);
      a += 32u;
    }

    // Scale/min unpack — ggml vec_dot_q4_K_q8_K_generic utmp dance
    uint utmp0 = u8(blk + 4u) | (u8(blk + 5u) << 8) | (u8(blk + 6u) << 16) | (u8(blk + 7u) << 24);
    uint utmp1 = u8(blk + 8u) | (u8(blk + 9u) << 8) | (u8(blk + 10u) << 16) | (u8(blk + 11u) << 24);
    uint utmp2 = u8(blk + 12u) | (u8(blk + 13u) << 8) | (u8(blk + 14u) << 16) | (u8(blk + 15u) << 24);
    uint utmp3 = ((utmp2 >> 4) & kmask2) | (((utmp1 >> 6) & kmask3) << 4);
    uint uaux = utmp1 & kmask1;
    utmp1 = (utmp2 & kmask2) | (((utmp0 >> 6) & kmask3) << 4);
    utmp2 = uaux;
    utmp0 &= kmask1;

    uint scales[8];
    uint mins[8];
    scales[0] = utmp0 & 0xFFu; scales[1] = (utmp0 >> 8) & 0xFFu;
    scales[2] = (utmp0 >> 16) & 0xFFu; scales[3] = (utmp0 >> 24) & 0xFFu;
    scales[4] = utmp1 & 0xFFu; scales[5] = (utmp1 >> 8) & 0xFFu;
    scales[6] = (utmp1 >> 16) & 0xFFu; scales[7] = (utmp1 >> 24) & 0xFFu;
    mins[0] = utmp2 & 0xFFu; mins[1] = (utmp2 >> 8) & 0xFFu;
    mins[2] = (utmp2 >> 16) & 0xFFu; mins[3] = (utmp2 >> 24) & 0xFFu;
    mins[4] = utmp3 & 0xFFu; mins[5] = (utmp3 >> 8) & 0xFFu;
    mins[6] = (utmp3 >> 16) & 0xFFu; mins[7] = (utmp3 >> 24) & 0xFFu;

    int sumi = 0;
    for (uint j = 0u; j < 16u; ++j)
      sumi += bsums[j] * int(mins[j / 2u]);

    int aux32[8];
    for (uint i = 0u; i < 8u; ++i) aux32[i] = 0;
    uint qi = 0u;
    uint ai = 0u;
    for (uint j = 0u; j < 8u; ++j) {
      int scale = int(scales[j]);
      for (uint r = 0u; r < 4u; ++r) {
        for (uint l = 0u; l < 8u; ++l)
          aux32[l] += scale * (q8[qi + l] * aux8[ai + l]);
        qi += 8u;
        ai += 8u;
      }
    }

    precise float dw = d * xd;
    for (uint l = 0u; l < 8u; ++l)
      sums[l] = sums[l] + dw * float(aux32[l]);
    precise float dm = dmin * xd;
    sumf = sumf - dm * float(sumi);
  }
  for (uint l = 0u; l < 8u; ++l) sumf = sumf + sums[l];
  y[row] = sumf;
}
