#version 450
// gemv_q4k.comp — Q4_K dequant+dot matching ggml dequantize_row_q4_K /
// Deep2Engine::dequantizeQ4KBlock (paired scales over 32-byte qs chunks).
// PRIOR bug: per-subblock 16B lo/hi interleave ≠ host → V_0@pos0 DIFF.
layout(local_size_x = 64) in;
layout(binding = 0) readonly buffer W { uint packed[]; };
layout(binding = 1) readonly buffer In { float x[]; };
layout(binding = 2) writeonly buffer Out { float y[]; };
layout(push_constant) uniform PC { uint rows; uint cols; } pc;

uint u8(uint off) {
  uint w = packed[off >> 2];
  return (w >> ((off & 3u) * 8u)) & 0xFFu;
}
float f16(uint h) { return unpackHalf2x16(h).x; }

void scmin(uint base, uint j, out uint sc, out uint m) {
  if (j < 4u) {
    sc = u8(base + j) & 63u;
    m = u8(base + j + 4u) & 63u;
  } else {
    uint a = u8(base + j + 4u);
    uint b = u8(base + j - 4u);
    uint c = u8(base + j);
    sc = (a & 15u) | ((b >> 6) << 4);
    m = (a >> 4) | ((c >> 6) << 4);
  }
}

void main() {
  uint row = gl_GlobalInvocationID.x;
  if (row >= pc.rows) return;
  uint nblk = (pc.cols + 255u) / 256u;
  uint rowOff = row * nblk * 144u;
  float sum = 0.0;
  for (uint b = 0u; b < nblk; ++b) {
    uint blk = rowOff + b * 144u;
    float d = f16(u8(blk) | (u8(blk + 1u) << 8));
    float dmin = f16(u8(blk + 2u) | (u8(blk + 3u) << 8));
    uint scb = blk + 4u;
    uint qbase = blk + 16u;
    uint elem = b * 256u;
    // ggml: is = 0,2,4,6 — 32 lo-nibbles then 32 hi-nibbles from same 32 qs bytes
    for (uint pair = 0u; pair < 4u; ++pair) {
      uint is0 = pair * 2u;
      uint sc0, m0, sc1, m1;
      scmin(scb, is0, sc0, m0);
      scmin(scb, is0 + 1u, sc1, m1);
      float d1 = d * float(sc0);
      float min1 = dmin * float(m0);
      float d2 = d * float(sc1);
      float min2 = dmin * float(m1);
      uint qo = qbase + pair * 32u;
      uint loBase = elem + pair * 64u;
      uint hiBase = loBase + 32u;
      for (uint l = 0u; l < 32u; ++l) {
        uint byte = u8(qo + l);
        uint ilo = loBase + l;
        uint ihi = hiBase + l;
        if (ilo < pc.cols)
          sum += (d1 * float(byte & 15u) - min1) * x[ilo];
        if (ihi < pc.cols)
          sum += (d2 * float((byte >> 4) & 15u) - min2) * x[ihi];
      }
    }
  }
  y[row] = sum;
}
