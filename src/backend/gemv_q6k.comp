#version 450
// gemv_q6k.comp — Q6_K×Q8_K integer mul_mat (ggml_vec_dot_q6_K_q8_K_generic).
// ATTN_PRE_O_1: match host sums[8]+prequant (wv/ffn_down are Q6_K on TinyLlama).
layout(local_size_x = 64) in;
layout(binding = 0) readonly buffer W { uint packed[]; };
layout(binding = 1) readonly buffer In { float x[]; };
layout(binding = 2) writeonly buffer Out { float y[]; };
layout(push_constant) uniform PC { uint rows; uint cols; } pc;
uint u8(uint off) {
  uint w = packed[off >> 2];
  return (w >> ((off & 3u) * 8u)) & 0xFFu;
}
float f16(uint h) { return unpackHalf2x16(h).x; }
int i8(uint b) { return int(b) - ((b >= 128u) ? 256 : 0); }
int nearest_int_q8k(float fval) {
  float val = fval + 12582912.0;
  uint bits = floatBitsToUint(val);
  return int(bits & 0x007fffffu) - 0x00400000;
}
void main() {
  uint row = gl_GlobalInvocationID.x;
  if (row >= pc.rows) return;
  uint nblk = pc.cols / 256u;
  if (nblk == 0u || (pc.cols % 256u) != 0u) { y[row] = 0.0; return; }
  uint rowOff = row * nblk * 210u;
  precise float sums[8];
  for (uint i = 0u; i < 8u; ++i) sums[i] = 0.0;
  for (uint b = 0u; b < nblk; ++b) {
    uint base = b * 256u;
    float amax = 0.0, maxv = 0.0;
    for (uint j = 0u; j < 256u; ++j) {
      float ax = abs(x[base + j]);
      if (ax > amax) { amax = ax; maxv = x[base + j]; }
    }
    float xd = 0.0;
    float iscale = 0.0;
    int q8[256];
    for (uint j = 0u; j < 256u; ++j) q8[j] = 0;
    if (amax != 0.0) {
      iscale = -127.0 / maxv;
      xd = 1.0 / iscale;
      for (uint j = 0u; j < 256u; ++j) {
        int v = nearest_int_q8k(iscale * x[base + j]);
        q8[j] = (v > 127) ? 127 : v;
      }
    }
    uint blk = rowOff + b * 210u;
    float d = f16(u8(blk + 208u) | (u8(blk + 209u) << 8));
    int aux8[256];
    uint ql0 = blk, qh0 = blk + 128u;
    for (uint pass = 0u; pass < 2u; ++pass) {
      uint ql = ql0 + pass * 64u, qh = qh0 + pass * 32u, yb = pass * 128u;
      for (uint l = 0u; l < 32u; ++l) {
        uint qlA = u8(ql + l), qlB = u8(ql + l + 32u), qhv = u8(qh + l);
        aux8[yb + l] = int((qlA & 15u) | ((qhv & 3u) << 4)) - 32;
        aux8[yb + l + 32u] = int((qlB & 15u) | (((qhv >> 2) & 3u) << 4)) - 32;
        aux8[yb + l + 64u] = int((qlA >> 4) | (((qhv >> 4) & 3u) << 4)) - 32;
        aux8[yb + l + 96u] = int((qlB >> 4) | (((qhv >> 6) & 3u) << 4)) - 32;
      }
    }
    int aux32[8];
    for (uint i = 0u; i < 8u; ++i) aux32[i] = 0;
    uint scb = blk + 192u, qi = 0u;
    for (uint j = 0u; j < 16u; ++j) {
      int scale = i8(u8(scb + j));
      for (uint r = 0u; r < 2u; ++r) {
        for (uint l = 0u; l < 8u; ++l)
          aux32[l] += scale * (q8[qi + l] * aux8[qi + l]);
        qi += 8u;
      }
    }
    precise float dwdx = d * xd;
    for (uint l = 0u; l < 8u; ++l)
      sums[l] = sums[l] + dwdx * float(aux32[l]);
  }
  precise float sumf = 0.0;
  for (uint l = 0u; l < 8u; ++l) sumf = sumf + sums[l];
  y[row] = sumf;
}
