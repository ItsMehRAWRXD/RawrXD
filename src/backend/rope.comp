#version 450
layout(local_size_x = 64) in;
layout(binding = 0) buffer Q { float q[]; };
layout(binding = 1) buffer K { float k[]; };
layout(push_constant) uniform PC {
  uint head_dim; uint n_heads; uint n_kv; uint pos; float theta;
} pc;
void main() {
  uint h = gl_GlobalInvocationID.x;
  if (h >= pc.n_heads) return;
  uint group = max(pc.n_heads / max(pc.n_kv, 1u), 1u);
  uint kv = h / group;
  uint qd = h * pc.head_dim;
  uint kd = kv * pc.head_dim;
  for (uint i = 0u; i < pc.head_dim; i += 2u) {
    float freq = 1.0 / pow(pc.theta, float(i) / float(pc.head_dim));
    float ang = float(pc.pos) * freq;
    float c = cos(ang), s = sin(ang);
    float q0 = q[qd + i], q1 = q[qd + i + 1u];
    q[qd + i] = q0 * c - q1 * s;
    q[qd + i + 1u] = q0 * s + q1 * c;
    if ((h % group) == 0u) {
      float k0 = k[kd + i], k1 = k[kd + i + 1u];
      k[kd + i] = k0 * c - k1 * s;
      k[kd + i + 1u] = k0 * s + k1 * c;
    }
  }
}
