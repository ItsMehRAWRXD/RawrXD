; memcmp(const void* s1, const void* s2, size_t n)
memcmp PROC
    test r8, r8
    jz memcmp_equal
    mov r9, rcx
    mov r10, rdx
memcmp_loop:
    mov al, [r9]
    mov bl, [r10]
    cmp al, bl
    jne memcmp_not_equal
    inc r9
    inc r10
    dec r8
    jnz memcmp_loop
memcmp_equal:
    xor rax, rax
    ret
memcmp_not_equal:
    movzx rax, al
    movzx rbx, bl
    sub rax, rbx
    ret
memcmp ENDP

