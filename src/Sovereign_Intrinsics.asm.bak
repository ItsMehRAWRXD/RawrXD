__stdio_common_vsprintf_s PROC
    push rbp
    mov rbp, rsp
    sub rsp, 48
    mov rcx, rdx      ; buffer
    mov rdx, r9      ; format
    mov r8, [rbp+56]  ; argptr (original rsp+48 before push rbp and sub rsp 48)
    ; Actually, let's just stub it for safety.
    xor eax, eax
    add rsp, 48
    pop rbp
    ret
__stdio_common_vsprintf_s ENDP

