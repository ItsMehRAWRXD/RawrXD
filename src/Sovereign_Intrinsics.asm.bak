__report_gsfailure PROC
    sub rsp, 40
    call GetCurrentProcess
    mov rcx, rax
    mov rdx, 0C0000409h ; STATUS_STACK_BUFFER_OVERRUN
    call TerminateProcess
    add rsp, 40
    ret
__report_gsfailure ENDP

_beginthreadex PROC
    ; This is a bit complex as beginthreadex has different signature than CreateThread,
    ; but for a stub we might just try to make it work or fail.
    ; uintptr_t _beginthreadex(void *security, unsigned stack_size, unsigned (*start_address)(void *), void *arglist, unsigned initflag, unsigned *thrdaddr);
    ; CreateThread(LPSECURITY_ATTRIBUTES, SIZE_T, LPTHREAD_START_ROUTINE, LPVOID, DWORD, LPDWORD)
    ; The signatures are compatible enough for a simple proxy.
    jmp CreateThread
_beginthreadex ENDP

