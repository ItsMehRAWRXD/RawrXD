; Minimal implementation for compiler intrinsics
memset PROC
    ; RCX = dest, RDX = value (byte), R8 = count
    mov rax, rcx
@@loop:
    test r8, r8
    jz @@done
    mov [rcx], dl
    inc rcx
    dec r8
    jmp @@loop
@@done:
    ret
memset ENDP

memcpy PROC
    ; RCX = dest, RDX = src, R8 = count
    mov rax, rcx
@@loop:
    test r8, r8
    jz @@done
    mov r9b, [rdx]
    mov [rcx], r9b
    inc rcx
    inc rdx
    dec r8
    jmp @@loop
@@done:
    ret
memcpy ENDP

memmove PROC
    ; Simplified memmove (same as memcpy for now)
    jmp memcpy
memmove ENDP

malloc PROC
    sub rsp, 40
    mov r8, rcx       ; size
    call GetProcessHeap
    mov rcx, rax      ; heap handle
    mov rdx, 0        ; flags
    call HeapAlloc
    add rsp, 40
    ret
malloc ENDP

free PROC
    test rcx, rcx
    jz @exit
    sub rsp, 40
    mov r8, rcx       ; ptr
    call GetProcessHeap
    mov rcx, rax      ; heap handle
    mov rdx, 0        ; flags
    call HeapFree
    add rsp, 40
@exit:
    ret
free ENDP

