_Tolower PROC
    mov rax, rcx
    cmp cl, 'A'
    jl @f
    cmp cl, 'Z'
    jg @f
    add al, 20h
@@:
    ret
_Tolower ENDP

_Toupper PROC
    mov rax, rcx
    cmp cl, 'a'
    jl @f
    cmp cl, 'z'
    jg @f
    sub al, 20h
@@:
    ret
_Toupper ENDP

