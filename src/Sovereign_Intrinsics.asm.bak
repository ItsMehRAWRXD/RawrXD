_malloc_dbg PROC
    ; arg1: size, arg2: blockType, arg3: filename, arg4: line
    jmp malloc
_malloc_dbg ENDP

_free_dbg PROC
    ; arg1: userData, arg2: blockType
    jmp free
_free_dbg ENDP

_calloc_dbg PROC
    ; arg1: count, arg2: size, arg3: blockType, arg4: filename, arg5: line
    push rbp
    mov rbp, rsp
    sub rsp, 40
    
    mov rax, rcx
    mul rdx
    mov rcx, rax
    call malloc ; malloc(count * size)
    
    leave
    ret
_calloc_dbg ENDP

