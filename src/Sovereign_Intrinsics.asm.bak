strlen PROC
    xor rax, rax
@@:
    cmp byte ptr [rcx + rax], 0
    je @f
    inc rax
    jmp @b
@@:
    ret
strlen ENDP

strcmp PROC
@@:
    mov al, [rcx]
    cmp al, [rdx]
    jne @f
    test al, al
    je @f
    inc rcx
    inc rdx
    jmp @b
@@:
    sub al, [rdx]
    movsx rax, al
    ret
strcmp ENDP

strcpy PROC
    mov rax, rcx
@@:
    mov dl, [rdx]
    mov [rcx], dl
    test dl, dl
    je @f
    inc rcx
    inc rdx
    jmp @b
@@:
    ret
strcpy ENDP

strncpy PROC
    mov rax, rcx
    test r8, r8
    je @f
@@:
    mov dl, [rdx]
    mov [rcx], dl
    test dl, dl
    je pad
    inc rcx
    inc rdx
    dec r8
    jne @b
    jmp @f
pad:
    inc rcx
    dec r8
    je @f
    mov byte ptr [rcx], 0
    jmp pad
@@:
    ret
strncpy ENDP

strncmp PROC
    xor rax, rax
    test r8, r8
    je @f
@@:
    mov al, [rcx]
    cmp al, [rdx]
    jne diff
    test al, al
    je @f
    inc rcx
    inc rdx
    dec r8
    jne @b
    jmp @f
diff:
    sub al, [rdx]
    movsx rax, al
@@:
    ret
strncmp ENDP

strchr PROC
@@:
    mov al, [rcx]
    cmp al, dl
    je found
    test al, al
    je notfound
    inc rcx
    jmp @b
found:
    mov rax, rcx
    ret
notfound:
    xor rax, rax
    ret
strchr ENDP

