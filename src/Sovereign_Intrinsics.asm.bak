_ceil PROC
    roundsd xmm0, xmm0, 2
    ret
_ceil ENDP

_frexp PROC
    ; rcx: double x (actually in xmm0)
    ; rdx: int* exp
    movq rax, xmm0
    mov r8, rax
    shr r8, 52
    and r8, 7FFh ; exponent bits
    
    test r8, r8
    jz load_zero
    cmp r8, 7FFh
    je load_inf_nan
    
    sub r8, 1022 ; convert bias to return 0.5 to 1.0 range
    mov [rdx], r8d
    
    ; Setup masks
    mov r8, 000FFFFFFFFFFFFFh ; Mantissa mask
    and rax, r8
    mov r8, 3FE0000000000000h ; 0.5 bias
    or rax, r8
    
    ; preserve sign
    movq r9, xmm0
    mov r8, 8000000000000000h
    and r9, r8
    or rax, r9
    
    movq xmm0, rax
    ret

load_zero:
    mov dword ptr [rdx], 0
    ; xmm0 is already zero or subnormal (handled as zero for now)
    ret

load_inf_nan:
    ; For inf/nan, exp is usually set to 0 or unchanged by some impls, 
    ; but let's just leave xmm0 as is.
    ret
_frexp ENDP
