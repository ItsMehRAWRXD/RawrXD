memchr PROC
    test r8, r8
    jz memchr_null
memchr_loop:
    mov al, [rcx]
    cmp al, dl
    je memchr_found
    inc rcx
    dec r8
    jnz memchr_loop
memchr_null:
    xor rax, rax
    ret
memchr_found:
    mov rax, rcx
    ret
memchr ENDP

