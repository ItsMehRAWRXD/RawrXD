; void* operator new(size_t size)
??2@YAPEAX_K@Z PROC
    sub rsp, 40
    mov r8, rcx       ; size
    call GetProcessHeap
    mov rcx, rax      ; heap handle
    mov rdx, 8        ; HEAP_ZERO_MEMORY
    call HeapAlloc
    add rsp, 40
    ret
??2@YAPEAX_K@Z ENDP

; void operator delete(void* p)
??3@YAXPEAX@Z PROC
    test rcx, rcx
    jz @exit
    sub rsp, 40
    mov r8, rcx       ; ptr
    call GetProcessHeap
    mov rcx, rax      ; heap handle
    mov rdx, 0        ; flags
    call HeapFree
    add rsp, 40
@exit:
    ret
??3@YAXPEAX@Z ENDP

