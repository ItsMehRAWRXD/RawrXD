    je @f
    inc rax
    jmp @b
@@:
    ret
wcslen ENDP

wcscpy PROC
    mov rax, rcx
@@:
    mov dx, [rdx]
    mov [rcx], dx
    test dx, dx
    je @f
    add rcx, 2
    add rdx, 2
    jmp @b
@@:
    ret
wcscpy ENDP

wcscat PROC
    mov rax, rcx
@@:
    cmp word ptr [rcx], 0
    je copy
    add rcx, 2
    jmp @b
copy:
@@:
    mov dx, [rdx]
    mov [rcx], dx
    test dx, dx
    je @f
    add rcx, 2
    add rdx, 2
    jmp @b
@@:
    ret
wcscat ENDP

_wcsicmp PROC
    ; case-insensitive wide string compare
@@:
    mov ax, [rcx]
    mov dx, [rdx]
    
    ; Convert AX to lowercase
    cmp ax, 'A'
    jl @f
    cmp ax, 'Z'
    jg @f
    add ax, 32
@@:
    ; Convert DX to lowercase
    cmp dx, 'A'
    jl @f
    cmp dx, 'Z'
    jg @f
    add dx, 32
@@:
    cmp ax, dx
    jne diff
    test ax, ax
    je @f
    add rcx, 2
    add rdx, 2
    jmp @b
diff:
    sub ax, dx
    movsx rax, ax
@@:
    ret
_wcsicmp ENDP

