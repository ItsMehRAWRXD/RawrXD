// ============================================================================
// deep2_b34_splitkv_reduce.comp
// Context-Scaled Parallel Decode — Stable Reduction Kernel
// Merges per-chunk (m, l, o) partials into final attention output.
// ============================================================================
#version 460

// Descriptor set 0 bindings
layout(set = 0, binding = 0, std430) readonly buffer SCRATCH { float s[]; };  // Partial inputs
layout(set = 0, binding = 1, std430) buffer OUT { float out[]; };             // Final output

// Push constants
layout(push_constant) uniform PushConstants {
    uint headDim;       // per-head dimension
    uint heads;         // number of query heads
    uint numChunks;     // number of chunks
} pc;

layout(local_size_x = 64) in;

void main() {
    uint headDim = pc.headDim;
    uint heads = pc.heads;
    uint numChunks = pc.numChunks;

    uint gid = gl_GlobalInvocationID.x;
    uint totalWork = heads * headDim;
    if (gid >= totalWork) return;

    uint head = gid / headDim;
    uint dim = gid % headDim;

    // Scratch layout: [chunk][head][headDim+2] = {m, l, o[headDim]}
    uint slotStride = heads * (headDim + 2);

    // First pass: find global max m
    double m = -1.7976931348623157e308;
    for (uint chunk = 0; chunk < numChunks; ++chunk) {
        uint base = chunk * heads * (headDim + 2) + head * (headDim + 2);
        double m_i = s[base + 0];
        double l_i = s[base + 1];
        if (l_i > 0.0 && m_i > m) {
            m = m_i;
        }
    }

    // All chunks empty -> output 0
    if (m == -1.7976931348623157e308) {
        out[gid] = 0.0;
        return;
    }

    // Second pass: accumulate
    double l = 0.0;
    double o = 0.0;

    for (uint chunk = 0; chunk < numChunks; ++chunk) {
        uint base = chunk * heads * (headDim + 2) + head * (headDim + 2);
        double m_i = s[base + 0];
        double l_i = s[base + 1];
        if (l_i <= 0.0) continue;

        double w = exp(m_i - m);
        l += w * l_i;
        o += w * s[base + 2 + dim];
    }

    if (l > 0.0) {
        out[gid] = float(o / l);
    } else {
        out[gid] = 0.0;
    }
}