#version 460
// B28 reference: normalized hidden -> vocabulary GEMV -> per-workgroup argmax.
// Full logits never need to leave the device. Production quant specialization
// consumes packed lm_head/embedding weights directly.
layout(local_size_x=256) in;

layout(set=0,binding=0,std430) readonly buffer X { float x[]; };
layout(set=0,binding=1,std430) readonly buffer N { float normW[]; };
layout(set=0,binding=2,std430) readonly buffer W { float lm[]; };
layout(set=0,binding=3,std430) buffer Out { float bestValue[]; uint bestToken[]; };

layout(push_constant) uniform PC {
    uint hidden;
    uint vocabBegin;
    uint vocabEnd;
    float invRms;
} pc;

shared float vals[256];
shared uint ids[256];

void main() {
    uint localToken = gl_WorkGroupID.x;
    uint tok = pc.vocabBegin + localToken;
    if(tok>=pc.vocabEnd) return;
    uint lid=gl_LocalInvocationID.x;
    float sum=0.0;
    for(uint c=lid;c<pc.hidden;c+=256u)
        sum += lm[uint64_t(tok)*pc.hidden+c] * (x[c]*pc.invRms*normW[c]);
    vals[lid]=sum; ids[lid]=tok; barrier();
    for(uint stride=128u;stride>0u;stride>>=1u) {
        if(lid<stride && vals[lid+stride]>vals[lid]) {
            vals[lid]=vals[lid+stride]; ids[lid]=ids[lid+stride];
        }
        barrier();
    }
    if(lid==0u) {
        bestValue[localToken]=vals[0];
        bestToken[localToken]=ids[0];
    }
}
