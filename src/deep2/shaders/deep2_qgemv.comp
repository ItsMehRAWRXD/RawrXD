#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
// Batch 9 packed GGUF GEMV.
// Supported: Q5_0(6), Q8_0(8), Q2_K(10), Q4_K(12), Q6_K(14).
//
// 40TPS_BATCH2:
//   one workgroup = one output row
//   256 lanes cooperatively consume input columns
//   shared-memory tree reduction emits exactly one row result
layout(local_size_x = 256) in;

layout(set=0,binding=0,std430) readonly buffer W0 { uint w[]; };
layout(set=0,binding=1,std430) readonly buffer X0 { float x[]; };
layout(set=0,binding=2,std430) writeonly buffer Y0 { float y[]; };

layout(push_constant) uniform Push {
    uint type;
    uint rows;
    uint cols;
    uint weightBytes;
    uint strictOrder;
} pc;

// A 256-lane workgroup can have up to 256 subgroups on a legal implementation.
shared float subgroupSums[256];

// Q4_K/Q6_K use the same Q8_K activation quantization as the CPU ggml
// authority. These per-workgroup scratch arrays mirror one 256-value Q8_K
// super-block at a time, so GPU and CPU use the same quantized dot contract.
shared float q8Raw[256];
shared int q8Quant[256];
shared float q8InvScale;
shared float q8D;

uint getb(uint byteIndex) {
    uint word = w[byteIndex >> 2u];
    return (word >> ((byteIndex & 3u) * 8u)) & 255u;
}
int gets8(uint byteIndex) {
    int v = int(getb(byteIndex));
    return v >= 128 ? v - 256 : v;
}
float geth(uint byteIndex) {
    uint h = getb(byteIndex) | (getb(byteIndex + 1u) << 8u);
    return unpackHalf2x16(h).x;
}

void q4kScaleMin(uint base, uint sb, out uint sc, out uint mn) {
    if (sb < 4u) {
        // base points at the start of the packed block: d/dmin occupy the
        // first four bytes, followed by GGML's 12-byte scales array.
        sc = getb(base + 4u + sb) & 63u;
        mn = getb(base + 8u + sb) & 63u;
    } else {
        uint j = sb - 4u;
        sc = (getb(base + 12u + j) & 15u) |
             ((getb(base + 4u + j) >> 6u) << 4u);
        mn = (getb(base + 12u + j) >> 4u) |
             ((getb(base + 8u + j) >> 6u) << 4u);
    }
}

float q8_0_weight(uint rowBase, uint col) {
    uint block = col / 32u;
    uint i = col % 32u;
    uint b = rowBase + block * 34u;
    return geth(b) * float(gets8(b + 2u + i));
}

float q2k_weight(uint rowBase, uint col) {
    uint block = col / 256u;
    uint idx = col % 256u;
    uint b = rowBase + block * 84u;
    float ds = geth(b + 0u);
    float dm = geth(b + 2u);

    uint chunk = idx / 128u;
    uint rem = idx % 128u;
    uint subBlock = rem / 32u;
    uint group = (rem % 32u) / 16u;
    uint pos = rem % 16u;

    uint scaleIdx = chunk * 8u + subBlock * 2u + group;
    uint packedScale = getb(b + 4u + scaleIdx);
    float dl = ds * float(packedScale & 15u);
    float ml = dm * float(packedScale >> 4u);

    uint qsIdx = chunk * 32u + group * 16u + pos;
    uint shift = subBlock * 2u;
    uint q = (getb(b + 20u + qsIdx) >> shift) & 3u;
    return dl * float(q) - ml;
}

float q4k_weight(uint rowBase, uint col) {
    uint block = col / 256u;
    uint idx = col % 256u;
    uint b = rowBase + block * 144u;
    float ds = geth(b + 0u);
    float dm = geth(b + 2u);

    uint sb = idx / 32u;
    uint l = idx % 32u;
    uint sc, mn;
    q4kScaleMin(b, sb, sc, mn);

    uint pair = sb / 2u;
    uint packed = getb(b + 16u + pair * 32u + l);
    uint q = (sb & 1u) == 0u ? (packed & 15u) : (packed >> 4u);
    return ds * float(sc) * float(q) - dm * float(mn);
}

// GGML Q5_0: FP16 d (2), 32 high bits (4), 16 packed nibbles.
float q5_0_weight(uint rowBase, uint col) {
    uint b = rowBase + (col / 32u) * 22u;
    uint idx = col % 32u;
    float d = geth(b);
    uint high = getb(b + 2u) | (getb(b + 3u) << 8u) |
                (getb(b + 4u) << 16u) | (getb(b + 5u) << 24u);
    uint packed = getb(b + 6u + (idx & 15u));
    uint q = idx < 16u ? (packed & 15u) : (packed >> 4u);
    q |= ((high >> idx) & 1u) << 4u;
    return d * float(int(q) - 16);
}

// Four-column Q4_K dot fragment.
// colBase is always a multiple of four. Q4_K block/sub-block boundaries
// are multiples of 32/256, so the 4-byte qs fetch cannot straddle either.
float q4k_dot4(uint rowBase, uint colBase) {
    uint block = colBase / 256u;
    uint idx = colBase % 256u;
    uint b = rowBase + block * 144u;

    float ds = geth(b + 0u);
    float dm = geth(b + 2u);

    uint sb = idx / 32u;
    uint l = idx % 32u;
    uint sc, mn;
    q4kScaleMin(b, sb, sc, mn);

    uint pair = sb / 2u;
    uint qsByte = b + 16u + pair * 32u + l;
    // qsByte is 4-byte aligned for colBase=(lane*4 + k*1024).
    uint packed4 = w[qsByte >> 2u];

    float d = ds * float(sc);
    float m = dm * float(mn);
    float sum = 0.0;

    for (uint k = 0u; k < 4u; ++k) {
        uint col = colBase + k;
        if (col >= pc.cols) break;
        uint packed = (packed4 >> (k * 8u)) & 255u;
        uint q = (sb & 1u) == 0u ? (packed & 15u) : (packed >> 4u);
        sum += (d * float(q) - m) * x[col];
    }
    return sum;
}

float q6k_weight(uint rowBase, uint col) {
    uint block = col / 256u;
    uint idx = col % 256u;
    uint b = rowBase + block * 210u;
    float ds = geth(b + 208u);

    uint hi128 = idx / 128u;
    uint within = idx % 128u;
    uint cat = within / 32u;
    uint l = within % 32u;
    uint is = l / 16u;

    uint qlBase = b + hi128 * 64u;
    uint qhBase = b + 128u + hi128 * 32u;
    uint scBase = b + 192u + hi128 * 8u;

    uint q = 0u;
    uint scIndex = 0u;
    if (cat == 0u) {
        q = (getb(qlBase + l) & 15u) |
            (((getb(qhBase + l) >> 0u) & 3u) << 4u);
        scIndex = is + 0u;
    } else if (cat == 1u) {
        q = (getb(qlBase + l + 32u) & 15u) |
            (((getb(qhBase + l) >> 2u) & 3u) << 4u);
        scIndex = is + 2u;
    } else if (cat == 2u) {
        q = (getb(qlBase + l) >> 4u) |
            (((getb(qhBase + l) >> 4u) & 3u) << 4u);
        scIndex = is + 4u;
    } else {
        q = (getb(qlBase + l + 32u) >> 4u) |
            (((getb(qhBase + l) >> 6u) & 3u) << 4u);
        scIndex = is + 6u;
    }
    int qs = int(q) - 32;
    int scale = gets8(scBase + scIndex);
    return ds * float(scale) * float(qs);
}

void main() {
    uint row = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;
    if (row >= pc.rows) return;

    uint blocksPerRow = 0u;
    uint rowBytes = 0u;
    if (pc.type == 6u) {
        blocksPerRow = pc.cols / 32u + uint(pc.cols % 32u != 0u);
        if (blocksPerRow > 0xffffffffu / 22u) { if (lane == 0u) y[row] = uintBitsToFloat(0x7fc00000u); return; }
        rowBytes = blocksPerRow * 22u;
    } else if (pc.type == 8u) {
        blocksPerRow = (pc.cols + 31u) / 32u;
        if (blocksPerRow > 0xffffffffu / 34u) { if (lane == 0u) y[row] = uintBitsToFloat(0x7fc00000u); return; }
        rowBytes = blocksPerRow * 34u;
    } else if (pc.type == 10u) {
        blocksPerRow = pc.cols / 256u + uint(pc.cols % 256u != 0u);
        if (blocksPerRow > 0xffffffffu / 84u) { if (lane == 0u) y[row] = uintBitsToFloat(0x7fc00000u); return; }
        rowBytes = blocksPerRow * 84u;
    } else if (pc.type == 12u) {
        blocksPerRow = (pc.cols + 255u) / 256u;
        if (blocksPerRow > 0xffffffffu / 144u) { if (lane == 0u) y[row] = uintBitsToFloat(0x7fc00000u); return; }
        rowBytes = blocksPerRow * 144u;
    } else if (pc.type == 14u) {
        blocksPerRow = (pc.cols + 255u) / 256u;
        if (blocksPerRow > 0xffffffffu / 210u) { if (lane == 0u) y[row] = uintBitsToFloat(0x7fc00000u); return; }
        rowBytes = blocksPerRow * 210u;
    } else {
        if (lane == 0u) y[row] = uintBitsToFloat(0x7fc00000u);
        return;
    }

    // Check multiplication and range before calculating row byte offset.
    if (rowBytes == 0u || rowBytes > pc.weightBytes ||
        row >= pc.weightBytes / rowBytes) {
        if (lane == 0u) y[row] = uintBitsToFloat(0x7fc00000u);
        return;
    }
    uint rb = row * rowBytes;
    if (rb > pc.weightBytes - rowBytes) {
        if (lane == 0u) y[row] = uintBitsToFloat(0x7fc00000u);
        return;
    }

    float acc = 0.0;
    if (pc.type == 12u || pc.type == 14u) {
        // Match vec_dot_q{4,6}_K_q8_K: quantize each activation super-block
        // with the selected signed maximum, then perform the integer dot with
        // the packed q4/q6 values and apply the block scales.
        const uint blocks = (pc.cols + 255u) / 256u;
        for (uint block = 0u; block < blocks; ++block) {
            const uint col = block * 256u + lane;
            q8Raw[lane] = col < pc.cols ? x[col] : 0.0;
            barrier();

            if (lane == 0u) {
                float amax = 0.0;
                float maxValue = 0.0;
                for (uint i = 0u; i < 256u; ++i) {
                    const float value = q8Raw[i];
                    const float av = abs(value);
                    if (av > amax) {
                        amax = av;
                        maxValue = value;
                    }
                }
                if (amax == 0.0) {
                    q8InvScale = 0.0;
                    q8D = 0.0;
                } else {
                    q8InvScale = -127.0 / maxValue;
                    q8D = 1.0 / q8InvScale;
                }
            }
            barrier();

            int q8 = 0;
            if (q8InvScale != 0.0)
                q8 = int(floatBitsToInt(q8InvScale * q8Raw[lane] + 12582912.0) & 0x007fffff) - 0x00400000;
            q8 = clamp(q8, -127, 127);
            q8Quant[lane] = q8;
            barrier();

            if (col < pc.cols) {
                if (pc.type == 12u) {
                    const uint b = rb + block * 144u;
                    const uint idx = lane;
                    const uint sb = idx / 32u;
                    const uint l = idx % 32u;
                    uint sc, mn;
                    q4kScaleMin(b, sb, sc, mn);
                    const uint pair = sb / 2u;
                    const uint packed = getb(b + 16u + pair * 32u + l);
                    const uint q = (sb & 1u) == 0u ? (packed & 15u) : (packed >> 4u);
                    acc += q8D * float(q8) * geth(b) * float(sc) * float(q) -
                           q8D * float(q8) * geth(b + 2u) * float(mn);
                } else {
                    const uint b = rb + block * 210u;
                    const uint idx = lane;
                    const uint hi128 = idx / 128u;
                    const uint within = idx % 128u;
                    const uint cat = within / 32u;
                    const uint l = within % 32u;
                    const uint is = l / 16u;
                    const uint qlBase = b + hi128 * 64u;
                    const uint qhBase = b + 128u + hi128 * 32u;
                    const uint scBase = b + 192u + hi128 * 8u;
                    uint q = 0u;
                    uint scIndex = 0u;
                    if (cat == 0u) {
                        q = (getb(qlBase + l) & 15u) |
                            (((getb(qhBase + l) >> 0u) & 3u) << 4u);
                        scIndex = is + 0u;
                    } else if (cat == 1u) {
                        q = (getb(qlBase + l + 32u) & 15u) |
                            (((getb(qhBase + l) >> 2u) & 3u) << 4u);
                        scIndex = is + 2u;
                    } else if (cat == 2u) {
                        q = (getb(qlBase + l) >> 4u) |
                            (((getb(qhBase + l) >> 4u) & 3u) << 4u);
                        scIndex = is + 4u;
                    } else {
                        q = (getb(qlBase + l + 32u) >> 4u) |
                            (((getb(qhBase + l) >> 6u) & 3u) << 4u);
                        scIndex = is + 6u;
                    }
                    const int qs = int(q) - 32;
                    const int scale = gets8(scBase + scIndex);
                    acc += q8D * float(q8) * geth(b + 208u) * float(scale) * float(qs);
                }
            }
            barrier();
        }
    } else {
        for (uint j = lane; j < pc.cols; j += 256u) {
            float ww = 0.0;
            if (pc.type == 6u) ww = q5_0_weight(rb, j);
            else if (pc.type == 8u) ww = q8_0_weight(rb, j);
            else if (pc.type == 10u) ww = q2k_weight(rb, j);
            acc += ww * x[j];
        }
    }

    // First reduction is entirely register/wave based.
    float wave = subgroupAdd(acc);
    if (subgroupElect())
        subgroupSums[gl_SubgroupID] = wave;
    barrier();

    // A single elected invocation completes the cross-subgroup reduction.
    // Do not assume 32/64-lane subgroups or a maximum of eight subgroups.
    if (lane == 0u) {
        float total = 0.0;
        for (uint i = 0u; i < gl_NumSubgroups; ++i)
            total += subgroupSums[i];
        y[row] = total;
    }

}

