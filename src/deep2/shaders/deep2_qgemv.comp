#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
// Batch 9 packed GGUF GEMV.
// Supported: Q8_0(8), Q2_K(10), Q3_K(11), Q4_K(12), Q5_K(13), Q6_K(14).
//
// 40TPS_BATCH2:
//   one workgroup = one output row
//   256 lanes cooperatively consume input columns
//   shared-memory tree reduction emits exactly one row result
layout(local_size_x = 256) in;

layout(set=0,binding=0,std430) readonly buffer W0 { uint w[]; };
layout(set=0,binding=1,std430) readonly buffer X0 { float x[]; };
layout(set=0,binding=2,std430) writeonly buffer Y0 { float y[]; };

layout(push_constant) uniform Push {
    uint type;
    uint rows;
    uint cols;
    uint weightBytes;
} pc;

// AMD target: 256-lane workgroup => at most 8 wave32 subgroups.
shared float subgroupSums[8];

uint getb(uint byteIndex) {
    uint word = w[byteIndex >> 2u];
    return (word >> ((byteIndex & 3u) * 8u)) & 255u;
}
int gets8(uint byteIndex) {
    int v = int(getb(byteIndex));
    return v >= 128 ? v - 256 : v;
}
float geth(uint byteIndex) {
    uint h = getb(byteIndex) | (getb(byteIndex + 1u) << 8u);
    return unpackHalf2x16(h).x;
}

void q4kScaleMin(uint base, uint sb, out uint sc, out uint mn) {
    if (sb < 4u) {
        sc = getb(base + 4u + sb) & 63u;
        mn = getb(base + 8u + sb) & 63u;
    } else {
        uint j = sb - 4u;
        sc = (getb(base + 12u + j) & 15u) |
             ((getb(base + 4u + j) >> 6u) << 4u);
        mn = (getb(base + 12u + j) >> 4u) |
             ((getb(base + 8u + j) >> 6u) << 4u);
    }
}

float q8_0_weight(uint rowBase, uint col) {
    uint block = col / 32u;
    uint i = col % 32u;
    uint b = rowBase + block * 34u;
    return geth(b) * float(gets8(b + 2u + i));
}

float q2k_weight(uint rowBase, uint col) {
    uint block = col / 256u;
    uint idx = col % 256u;
    uint b = rowBase + block * 84u;
    // Canonical GGML Q2_K layout is scales[16] | qs[64] | d | dmin.
    // The production quant-dot path and GGML reference both use the FP16
    // super-block values at offsets 80/82. Reading them from 0/2 interprets
    // packed scale bytes as half values and can produce NaN GEMV outputs.
    float ds = geth(b + 80u);
    float dm = geth(b + 82u);

    uint chunk = idx / 128u;
    uint rem = idx % 128u;
    uint subBlock = rem / 32u;
    uint group = (rem % 32u) / 16u;
    uint pos = rem % 16u;

    uint scaleIdx = chunk * 8u + subBlock * 2u + group;
    uint packedScale = getb(b + scaleIdx);
    float dl = ds * float(packedScale & 15u);
    float ml = dm * float(packedScale >> 4u);

    uint qsIdx = chunk * 32u + group * 16u + pos;
    uint shift = subBlock * 2u;
    uint q = (getb(b + 16u + qsIdx) >> shift) & 3u;
    return dl * float(q) - ml;
}

// Q3_K weight decoder — GGML block layout: scales[12] | hmask[32] | qs[64] | d(2)
// Total: 110 bytes per 256-weight block.
// scales: 16 values, 6 bits each, packed across 12 bytes.
// hmask: 32 bytes, bit j of byte i indicates sign extension for element (i*8 + j%8).
// qs: 64 bytes, 2 bits per weight value.
// d: FP16 super-block scale at offset 108.
float q3k_weight(uint rowBase, uint col) {
    uint block = col / 256u;
    uint idx = col % 256u;
    uint b = rowBase + block * 110u;

    // Super-block scale (FP16 at offset 108)
    float d_all = geth(b + 108u);

    uint group = idx / 128u;        // 0 or 1
    uint within = idx % 128u;       // 0-127
    uint sub_group = within / 32u;  // 0-3
    uint pos_in_subgroup = within % 32u;  // 0-31

    // Scale index within block: sub_group * 2 + half_part (0-15)
    uint half_part = pos_in_subgroup / 16u;     // 0 or 1
    uint scale_idx = sub_group * 2u + half_part;

    // Decode packed scale[scale_idx] from 12 bytes at offset 0-11
    // GGML packing: for j < 8, lower 4 bits in byte j, upper 2 bits in byte 8 + j/4 at bit 2*(j%4)
    //               for j >= 8, lower 4 bits in byte j-8 (upper nibble), upper 2 bits in byte 8 + j/4 at bit 2*(j%4)
    uint sc_byte_low, sc_bit_low, sc_byte_high, sc_bit_high;
    if (scale_idx < 8u) {
        sc_byte_low = scale_idx;
        sc_bit_low = 0u;
    } else {
        sc_byte_low = scale_idx - 8u;
        sc_bit_low = 4u;
    }
    sc_byte_high = 8u + scale_idx / 4u;
    sc_bit_high = 2u * (scale_idx % 4u);

    uint sc_low = (getb(b + sc_byte_low) >> sc_bit_low) & 15u;
    uint sc_high = (getb(b + sc_byte_high) >> sc_bit_high) & 3u;
    uint sc = sc_low | (sc_high << 4u);
    sc = sc - 32u;  // signed offset

    float dl = d_all * float(int(sc));

    // Decode qs: 64 bytes at offset 44-107, 2 bits per weight
    // qs advances by 32 bytes per 128-element group (ggml: q += 32 after each group)
    uint qs_base = b + 44u + group * 32u;
    uint qs_byte = getb(qs_base + pos_in_subgroup);
    uint shift = sub_group * 2u;
    uint q = (qs_byte >> shift) & 3u;
    int qv = int(q);

    // Decode hmask: 32 bytes at offset 12-43
    // hmask byte at offset 12 + pos_in_subgroup, bit position = sub_group
    uint hbyte = getb(b + 12u + pos_in_subgroup);
    uint hbit = 1u << sub_group;
    bool hmask_set = (hbyte & hbit) != 0u;

    if (hmask_set) {
        qv -= 4;  // sign-extend: q >= 4 means negative value
    }

    return dl * float(qv);
}

float q4k_weight(uint rowBase, uint col) {
    uint block = col / 256u;
    uint idx = col % 256u;
    uint b = rowBase + block * 144u;
    float ds = geth(b + 0u);
    float dm = geth(b + 2u);

    uint sb = idx / 32u;
    uint l = idx % 32u;
    uint sc, mn;
    q4kScaleMin(b, sb, sc, mn);

    uint pair = sb / 2u;
    uint packed = getb(b + 16u + pair * 32u + l);
    uint q = (sb & 1u) == 0u ? (packed & 15u) : (packed >> 4u);
    return ds * float(sc) * float(q) - dm * float(mn);
}

void q5kScaleMin(uint base, uint sb, out uint sc, out uint mn) {
    uint u0 = getb(base + 0u) | (getb(base + 1u) << 8u) |
              (getb(base + 2u) << 16u) | (getb(base + 3u) << 24u);
    uint u1 = getb(base + 4u) | (getb(base + 5u) << 8u) |
              (getb(base + 6u) << 16u) | (getb(base + 7u) << 24u);
    uint u2 = getb(base + 8u) | (getb(base + 9u) << 8u) |
              (getb(base + 10u) << 16u) | (getb(base + 11u) << 24u);
    const uint kmask1 = 0x3f3f3f3fu;
    const uint kmask2 = 0x0f0f0f0fu;
    const uint kmask3 = 0x03030303u;
    uint u3 = ((u2 >> 4u) & kmask2) | (((u1 >> 6u) & kmask3) << 4u);
    uint aux = u1 & kmask1;
    u1 = (u2 & kmask2) | (((u0 >> 6u) & kmask3) << 4u);
    u2 = aux;
    u0 &= kmask1;
    const uint scaleWord = sb < 4u ? u0 : u1;
    const uint minWord = sb < 4u ? u2 : u3;
    const uint shift = (sb & 3u) * 8u;
    sc = (scaleWord >> shift) & 0xffu;
    mn = (minWord >> shift) & 0xffu;
}

float q5k_weight(uint rowBase, uint col) {
    uint block = col / 256u;
    uint idx = col % 256u;
    uint b = rowBase + block * 176u;
    float ds = geth(b + 0u);
    float dm = geth(b + 2u);
    uint sb = idx / 32u;
    uint l = idx % 32u;
    uint pair = sb / 2u;
    uint half_group = sb & 1u;
    uint packed = getb(b + 48u + pair * 32u + l);
    uint q = half_group == 0u ? (packed & 15u) : (packed >> 4u);
    uint high = getb(b + 16u + l);
    q += (high & (1u << sb)) != 0u ? 16u : 0u;
    uint sc, mn;
    q5kScaleMin(b + 4u, sb, sc, mn);
    return ds * float(sc) * float(q) - dm * float(mn);
}

// Four-column Q4_K dot fragment.
// colBase is always a multiple of four. Q4_K block/sub-block boundaries
// are multiples of 32/256, so the 4-byte qs fetch cannot straddle either.
float q4k_dot4(uint rowBase, uint colBase) {
    uint block = colBase / 256u;
    uint idx = colBase % 256u;
    uint b = rowBase + block * 144u;

    float ds = geth(b + 0u);
    float dm = geth(b + 2u);

    uint sb = idx / 32u;
    uint l = idx % 32u;
    uint sc, mn;
    q4kScaleMin(b, sb, sc, mn);

    uint pair = sb / 2u;
    uint qsByte = b + 16u + pair * 32u + l;
    // qsByte is 4-byte aligned for colBase=(lane*4 + k*1024).
    uint packed4 = w[qsByte >> 2u];

    float d = ds * float(sc);
    float m = dm * float(mn);
    float sum = 0.0;

    for (uint k = 0u; k < 4u; ++k) {
        uint col = colBase + k;
        if (col >= pc.cols) break;
        uint packed = (packed4 >> (k * 8u)) & 255u;
        uint q = (sb & 1u) == 0u ? (packed & 15u) : (packed >> 4u);
        sum += (d * float(q) - m) * x[col];
    }
    return sum;
}

float q6k_weight(uint rowBase, uint col) {
    uint block = col / 256u;
    uint idx = col % 256u;
    uint b = rowBase + block * 210u;
    float ds = geth(b + 208u);

    uint hi128 = idx / 128u;
    uint within = idx % 128u;
    uint cat = within / 32u;
    uint l = within % 32u;
    uint is = l / 16u;

    uint qlBase = b + hi128 * 64u;
    uint qhBase = b + 128u + hi128 * 32u;
    uint scBase = b + 192u + hi128 * 8u;

    uint q = 0u;
    uint scIndex = 0u;
    if (cat == 0u) {
        q = (getb(qlBase + l) & 15u) |
            (((getb(qhBase + l) >> 0u) & 3u) << 4u);
        scIndex = is + 0u;
    } else if (cat == 1u) {
        q = (getb(qlBase + l + 32u) & 15u) |
            (((getb(qhBase + l) >> 2u) & 3u) << 4u);
        scIndex = is + 2u;
    } else if (cat == 2u) {
        q = (getb(qlBase + l) >> 4u) |
            (((getb(qhBase + l) >> 4u) & 3u) << 4u);
        scIndex = is + 4u;
    } else {
        q = (getb(qlBase + l + 32u) >> 4u) |
            (((getb(qhBase + l) >> 6u) & 3u) << 4u);
        scIndex = is + 6u;
    }
    int qs = int(q) - 32;
    int scale = gets8(scBase + scIndex);
    return ds * float(scale) * float(qs);
}

void main() {
    uint row = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;
    if (row >= pc.rows) return;

    uint blocksPerRow = 0u;
    uint rowBytes = 0u;
    if (pc.type == 8u) {
        blocksPerRow = (pc.cols + 31u) / 32u;
        rowBytes = blocksPerRow * 34u;
    } else if (pc.type == 10u) {
        blocksPerRow = (pc.cols + 255u) / 256u;
        rowBytes = blocksPerRow * 84u;
    } else if (pc.type == 11u) {
        blocksPerRow = (pc.cols + 255u) / 256u;
        rowBytes = blocksPerRow * 110u;
    } else if (pc.type == 12u) {
        blocksPerRow = (pc.cols + 255u) / 256u;
        rowBytes = blocksPerRow * 144u;
    } else if (pc.type == 13u) {
        blocksPerRow = (pc.cols + 255u) / 256u;
        rowBytes = blocksPerRow * 176u;
    } else if (pc.type == 14u) {
        blocksPerRow = (pc.cols + 255u) / 256u;
        rowBytes = blocksPerRow * 210u;
    } else {
        y[row] = uintBitsToFloat(0x7fc00000u);
        return;
    }

    uint rb = row * rowBytes;
    if (rb + rowBytes > pc.weightBytes) {
        if (lane == 0u) y[row] = uintBitsToFloat(0x7fc00000u);
        return;
    }

    float acc = 0.0;
    if (pc.type == 12u) {
        // 256 lanes * 4 contiguous values = 1024 columns per sweep.
        for (uint j = lane * 4u; j < pc.cols; j += 1024u)
            acc += q4k_dot4(rb, j);
    } else {
        for (uint j = lane; j < pc.cols; j += 256u) {
            float ww = 0.0;
            if (pc.type == 8u) ww = q8_0_weight(rb, j);
            else if (pc.type == 10u) ww = q2k_weight(rb, j);
            else if (pc.type == 11u) ww = q3k_weight(rb, j);
            else if (pc.type == 13u) ww = q5k_weight(rb, j);
            else if (pc.type == 14u) ww = q6k_weight(rb, j);
            acc += ww * x[j];
        }
    }

    // First reduction is entirely register/wave based.
    float wave = subgroupAdd(acc);
    if (subgroupElect())
        subgroupSums[gl_SubgroupID] = wave;
    barrier();

    // The first subgroup reduces one value per subgroup.
    if (gl_SubgroupID == 0u) {
        float v = gl_SubgroupInvocationID < gl_NumSubgroups
            ? subgroupSums[gl_SubgroupInvocationID]
            : 0.0;
        float total = subgroupAdd(v);
        if (subgroupElect())
            y[row] = total;
    }

}

