#version 460
// B29 activation ping-pong helper used by a persistent command graph.
// This kernel is deliberately tiny: the production chain executes B26/B27/B28
// kernels against alternating resident activation buffers without host copies.
layout(local_size_x=256) in;
layout(set=0,binding=0,std430) readonly buffer A { float src[]; };
layout(set=0,binding=1,std430) writeonly buffer B { float dst[]; };
layout(push_constant) uniform PC { uint n; } pc;
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i<pc.n) dst[i]=src[i];
}
