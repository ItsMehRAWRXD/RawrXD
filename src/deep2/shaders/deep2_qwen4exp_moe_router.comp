#version 450

layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) readonly buffer HiddenBuffer { float hidden[]; };
layout(set = 0, binding = 1, std430) readonly buffer RouterBuffer { float router_weight[]; };
layout(set = 0, binding = 2, std430) writeonly buffer LogitBuffer { float router_logits[]; };

layout(push_constant) uniform Push {
    uint hidden_width;
    uint experts;
    uint top_k;
    uint reserved;
} pc;

void main() {
    const uint expert = gl_GlobalInvocationID.x;
    if (pc.hidden_width == 0u || pc.experts == 0u || expert >= pc.experts) return;
    float value = 0.0;
    for (uint i = 0u; i < pc.hidden_width; ++i)
        value += hidden[i] * router_weight[i * pc.experts + expert];
    router_logits[expert] = value;
}
