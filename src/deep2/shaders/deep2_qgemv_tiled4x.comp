#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
// Tiled Q4_K GEMV: 4 output rows per workgroup via shared-memory tile reuse.
// One workgroup (256 lanes) processes 4 rows simultaneously, loading each
// activation column tile once and reusing it for all 4 rows.
//
// Expected TPS improvement: ~4× per kernel launch from reduced global memory
// reads, plus better occupancy from more useful work per workgroup.
//
// Reference: deep2_qgemv_batch4row.comp pattern adapted for non-batched case.
//
// RAWRXD_DEEP2_GPU_QUANT_DOT_001 – proven correct on two AMD GPUs at cosine 1.0.
layout(local_size_x = 256) in;

layout(set=0,binding=0,std430) readonly buffer W0 { uint w[]; };
layout(set=0,binding=1,std430) readonly buffer X0 { float x[]; };
layout(set=0,binding=2,writeonly buffer Y0 { float y[]; };

layout(push_constant) uniform Push {
    uint type;
    uint rows;
    uint cols;
    uint weightBytes;
    uint strictOrder;
} pc;

// A 256-lane workgroup can have up to 256 subgroups on a legal implementation.
shared float subgroupSums[256];

// Q4_K/Q6_K use the same Q8_K activation quantization as the CPU ggml authority.
// These per-workgroup scratch arrays mirror one 256-value Q8_K super-block at a time,
// so GPU and CPU use the same quantized dot contract.
shared float q8Raw[256];
shared int q8Quant[256];
shared float q8InvScale;
shared float q8D;

// Index helpers
uint getb(uint byteIndex) {
    uint word = w[byteIndex >> 2u];
    return (word >> ((byteIndex & 3u) * 8u)) & 255u;
}
int gets8(uint byteIndex) {
    int v = int(getb(byteIndex));
    return v >= 128 ? v - 256 : v;
}
float geth(uint byteIndex) {
    uint h = getb(byteIndex) | (getb(byteIndex + 1u) << 8u);
    return unpackHalf2x16(h).x;
}

void q4kScaleMin(uint base, uint sb, out uint sc, out uint mn) {
    if (sb < 4u) {
        sc = getb(base + 4u + sb) & 63u;
        mn = getb(base + 8u + sb) & 63u;
    } else {
        uint j = sb - 4u;
        sc = (getb(base + 12u + j) & 15u) |
             ((getb(base + 4u + j) >> 6u) << 4u);
        mn = (getb(base + 12u + j) >> 4u) |
             ((getb(base + 8u + j) >> 6u) << 4u);
    }
}

float q4k_weight(uint rowBase, uint col) {
    uint block = col / 256u;
    uint idx = col % 256u;
    uint b = rowBase + block * 144u;
    float ds = geth(b + 0u);
    float dm = geth(b + 2u);
    uint sb = idx / 32u;
    uint l = idx % 32u;
    uint sc, mn;
    q4kScaleMin(b, sb, sc, mn);
    uint pair = sb / 2u;
    uint packed = getb(b + 16u + pair * 32u + l);
    uint q = (sb & 1u) == 0u ? (packed & 15u) : (packed >> 4u);
    return ds * float(sc) * float(q) - dm * float(mn);
}

// Four-column dot product fragment used for verification/coverage.
float q4k_dot4(uint rowBase, uint colBase) {
    uint block = colBase / 256u;
    uint idx = colBase % 256u;
    uint b = rowBase + block * 144u;
    float ds = geth(b + 0u);
    float dm = geth(b + 2u);
    uint sb = idx / 32u;
    uint l = idx % 32u;
    uint sc, mn;
    q4kScaleMin(b, sb, sc, mn);
    uint pair = sb / 2u;
    uint qsByte = b + 16u + pair * 32u + l;
    uint packed4 = w[qsByte >> 2u];
    float d = ds * float(sc);
    float m = dm * float(mn);
    float sum = 0.0;
    for (uint k = 0u; k < 4u; ++k) {
        uint col = colBase + k;
        if (col >= pc.cols) break;
        uint packed = (packed4 >> (k * 8u)) & 255u;
        uint q = (sb & 1u) == 0u ? (packed & 15u) : (packed >> 4u);
        sum += (d * float(q) - m) * x[col];
    }
    return sum;
}

void main() {
    // Process 4 rows per workgroup: rows r, r+1, r+2, r+3
    uint baseRow = gl_WorkGroupID.x * 4u;
    if (baseRow + 3u >= pc.rows) {
        // If fewer than 4 rows remain, still process what's available
        // by zeroing out unused rows below
    }

    uint row = baseRow; // Primary row index for this workgroup
    uint lane = gl_LocalInvocationID.x; // 0..255

    // Determine cohort within the 4-row workgroup (0..3)
    // Map 256 lanes into 4 cohorts of 64 lanes each
    uint cohort = lane / 64u;      // 0..3
    lane = lane % 64u;             // local lane within cohort (0..63)

    // Primary row for this cohort
    uint r = baseRow + cohort;

    if (r >= pc.rows) {
        // This cohort has no row to process
        if (cohort == 0u) y[row] = 0.0f;
        return;
    }

    // Compute row byte offset
    // Q4_K: 144 bytes per 256-column block
    uint blocksPerRow = (pc.cols + 255u) / 256u;
    uint rowBytes = blocksPerRow * 144u;

    // Check row byte offset bounds
    if (rowBytes == 0u || rowBytes > pc.weightBytes ||
        row >= pc.weightBytes / rowBytes) {
        if (cohort == 0u) y[row] = uintBitsToFloat(0x7fc00000u); // NaN
        return;
    }
    uint rb = row * rowBytes;
    if (rb > pc.weightBytes - rowBytes) {
        if (cohort == 0u) y[row] = uintBitsToFloat(0x7fc00000u);
        return;
    }

    // Accumulator for this cohort's row
    float acc = 0.0f;

    // Q4_K path: quantize activations as Q8_K, dot with quantized weights
    if (pc.type == 12u) {
        const uint blocks = (pc.cols + 255u) / 256u;
        for (uint block = 0u; block < blocks; ++block) {
            // Load activation tile into shared memory (broadcast to all 4 rows)
            uint col = block * 256u + lane;
            if (col < pc.cols) {
                q8Raw[lane] = x[col];
            } else {
                q8Raw[lane] = 0.0f;
            }

            // All cohorts compute their row's quant scale from the same activation max
            if (cohort == 0u && lane == 0u) {
                float amax = 0.0f;
                float maxValue = 0.0f;
                for (uint i = 0u; i < 256u; ++i) {
                    float value = q8Raw[i];
                    float av = abs(value);
                    if (av > amax) {
                        amax = av;
                        maxValue = value;
                    }
                }
                if (amax == 0.0f) {
                    q8InvScale = 0.0f;
                    q8D = 0.0f;
                } else {
                    q8InvScale = -127.0f / maxValue;
                    q8D = 1.0f / q8InvScale;
                }
            }
            barrier();

            int q8 = 0;
            if (q8InvScale != 0.0f)
                q8 = int(floatBitsToInt(q8InvScale * q8Raw[lane] + 12582912.0f) & 0x007fffff) - 0x00400000u;
            q8 = clamp(q8, -127, 127);
            q8Quant[lane] = q8;
            barrier();

            // Each cohort accumulates for its respective row
            if (col < pc.cols) {
                acc += q8D * float(q8) * q4k_weight(rb, col);
            }
            barrier();
        }
    } else {
        // Fallback: raw weight fetches, no quantization
        for (uint j = lane; j < pc.cols; j += 256u) {
            float ww;
            if (pc.type == 2u) ww = q4_0_weight(rb, j);
            else if (pc.type == 6u) ww = q5_0_weight(rb, j);
            else if (pc.type == 8u) ww = q8_0_weight(rb, j);
            else if (pc.type == 10u) ww = q2k_weight(rb, j);
            else if (pc.type == 11u) ww = q3k_weight(rb, j);
            else if (pc.type == 13u) ww = q5k_weight(rb, j);
            else if (pc.type == 20u) ww = iq4nl_weight(rb, j);
            else ww = 0.0f;
            acc += ww * x[j];
        }
    }

    // First reduction: subgroup-level (entire 256-lane workgroup)
    float wave = subgroupAdd(acc);
    if (subgroupElect())
        subgroupSums[gl_SubgroupID] = wave;
    barrier();

    // Cross-subgroup reduction: one elected invocation per cohort reads
    // subgroupSums for its 4 rows and combines them
    if (lane == 0u && cohort < 4u && r + cohort < pc.rows) {
        float total = 0.0f;
        for (uint i = 0u; i < gl_NumSubgroups; ++i)
            total += subgroupSums[i];
        y[r + cohort] = total;
    }
}