#version 460
// Batch 16: source-only fused Q4 dequant + dot skeleton.
// Bindings intentionally match no external framework; wire to existing Deep2 Vulkan descriptors.
layout(local_size_x = 256) in;

layout(set=0,binding=0,std430) readonly buffer W { uint q[]; } weights;
layout(set=0,binding=1,std430) readonly buffer X { float x[]; } inputVec;
layout(set=0,binding=2,std430) writeonly buffer Y { float y[]; } outputVec;
layout(push_constant) uniform PC {
    uint rows;
    uint cols;
    uint wordsPerRow;
    uint rowBase;
} pc;

shared float laneSum[256];

float q4_to_f(uint word, uint nibble) {
    uint v = (word >> (nibble * 4u)) & 15u;
    return float(int(v) - 8);
}

void main() {
    uint row = pc.rowBase + gl_WorkGroupID.x;
    if (row >= pc.rows) return;

    uint lid = gl_LocalInvocationID.x;
    float sum = 0.0;
    for (uint c = lid; c < pc.cols; c += 256u) {
        uint wordIndex = row * pc.wordsPerRow + (c >> 3u);
        uint nibble = c & 7u;
        sum += q4_to_f(weights.q[wordIndex], nibble) * inputVec.x[c];
    }
    laneSum[lid] = sum;
    barrier();

    for (uint stride=128u; stride>0u; stride>>=1u) {
        if (lid < stride) laneSum[lid] += laneSum[lid + stride];
        barrier();
    }
    if (lid == 0u) outputVec.y[row] = laneSum[0];
}
