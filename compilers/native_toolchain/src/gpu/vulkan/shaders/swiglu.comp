#version 450

// SwiGLU activation compute shader
// SwiGLU(x) = Swish(x) * (x @ W_gate) where Swish(x) = x * sigmoid(x)
// This is used in the FFN: output = SwiGLU(x @ W_gate) * (x @ W_up) @ W_down

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer GateBuffer {
    float gate_data[];
};

layout(std430, binding = 1) readonly buffer UpBuffer {
    float up_data[];
};

layout(std430, binding = 2) writeonly buffer OutputBuffer {
    float output_data[];
};

layout(push_constant) uniform PushConstants {
    uint n_elements;
};

// SiLU (Swish) activation: x * sigmoid(x)
float silu(float x) {
    return x / (1.0 + exp(-x));
}

void main() {
    uint global_id = gl_GlobalInvocationID.x;
    
    if (global_id >= n_elements) return;
    
    float gate = gate_data[global_id];
    float up = up_data[global_id];
    
    // SwiGLU: silu(gate) * up
    output_data[global_id] = silu(gate) * up;
}