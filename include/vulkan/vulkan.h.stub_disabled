#ifndef RAWRXD_VULKAN_STUB_H
#define RAWRXD_VULKAN_STUB_H

// Minimal Vulkan type stub for RawrXD CPU-only builds.
// All Vulkan handles are void* so VK_NULL_HANDLE (=0) converts implicitly.
// The engine never actually calls Vulkan functions on this path.

#include <cstdint>
#include <vector>
#include <string>

