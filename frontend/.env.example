# Sovereign IDE Frontend Environment Configuration
# Copy this file to .env and adjust values for your deployment.

# Engine backend host and port
# Default: localhost:11435 (matches mock_backend.py default)
VITE_ENGINE_HOST=localhost
VITE_ENGINE_PORT=11435

# Example: connect to Node.js backend on port 8080
# VITE_ENGINE_HOST=localhost
# VITE_ENGINE_PORT=8080
