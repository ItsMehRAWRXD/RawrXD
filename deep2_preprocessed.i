    return true;
}


inline bool DimsEqOrSwap2(const Deep2::TensorInfo& t, const uint64_t* e) {
    if (DimsEq(t, e, 2)) return true;
    if (t.dimensions.size() != 2) return false;
    return t.dimensions[0] == e[1] && t.dimensions[1] == e[0];
