  "Dependencies": [],
  
  "Conflicts": [],
  
  "Prerequisites": {
    "MinDiskSpaceMB": 10,
    "MinMemoryMB": 128,
    "ServicesToStop": ["rawrxd-swarm", "rawrxd-agent", "rawrxd-tools"],
    "ServicesToStart": [],
    "PrePatchCommands": [
      "powershell -Command 'Write-Host \"EMERGENCY ROLLBACK INITIATED\" -ForegroundColor Red'",
