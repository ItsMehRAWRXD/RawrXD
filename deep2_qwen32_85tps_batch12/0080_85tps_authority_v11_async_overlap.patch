# Base: apply after 0079.
#
# Authority v11:
# - retains every previous correctness / residency / kernel / 3x85 condition
# - requires nonblocking Q4_K submits on both GPUs
# - requires persistent secondary transfer ring activity
# - requires measured positive arithmetic overlap
# - reports overlap ratio = overlap_ns / async_wall_ns
#
# Apply:
#   git -C F:\~dev apply --3way 0080_85tps_authority_v11_async_overlap.patch

diff --git a/~dev/rawrxd/src/deep2/Deep2Engine.h b/~dev/rawrxd/src/deep2/Deep2Engine.h
--- a/~dev/rawrxd/src/deep2/Deep2Engine.h
+++ b/~dev/rawrxd/src/deep2/Deep2Engine.h
@@
     uint64_t vulkanSlotRecordedQ4KBuilds(unsigned slot) const;
+    uint64_t vulkanSlotQ4KAsyncSubmits(unsigned slot) const;
+    uint64_t vulkanSlotQ4KAsyncWaitNs(unsigned slot) const;
+    uint64_t vulkanSlotDownloadRingSubmits(unsigned slot) const;
+    uint64_t vulkanSlotDownloadRingWaitNs(unsigned slot) const;

diff --git a/~dev/rawrxd/src/deep2/Deep2Engine_VulkanRuntime.cpp b/~dev/rawrxd/src/deep2/Deep2Engine_VulkanRuntime.cpp
--- a/~dev/rawrxd/src/deep2/Deep2Engine_VulkanRuntime.cpp
+++ b/~dev/rawrxd/src/deep2/Deep2Engine_VulkanRuntime.cpp
@@
+uint64_t Deep2Engine::vulkanSlotQ4KAsyncSubmits(unsigned slot) const {
+    auto* vc=getVulkanComputeSlot(slot);
+    return vc?vc->Q4KAsyncSubmits():0;
+}
+uint64_t Deep2Engine::vulkanSlotQ4KAsyncWaitNs(unsigned slot) const {
+    auto* vc=getVulkanComputeSlot(slot);
+    return vc?vc->Q4KAsyncWaitNs():0;
+}
+uint64_t Deep2Engine::vulkanSlotDownloadRingSubmits(unsigned slot) const {
+    auto* vc=getVulkanComputeSlot(slot);
+    return vc?vc->DownloadRingSubmits():0;
+}
+uint64_t Deep2Engine::vulkanSlotDownloadRingWaitNs(unsigned slot) const {
+    auto* vc=getVulkanComputeSlot(slot);
+    return vc?vc->DownloadRingWaitNs():0;
+}

