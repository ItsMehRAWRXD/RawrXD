# Deep2 Qwen32 85TPS — Batch 9, item 62
# Base: apply after 0061.
#
# Goal:
#   transfer ONLY GPU1's row slice through persistent mapped staging and import
#   it directly into GPU0's ResidentFullOutput at the final row offset.
#
# No CPU concatenate, no complete-vector readback, no peer-memory requirement.
#
# Apply:
#   git -C F:\~dev apply --3way 0062_secondary_slice_direct_offset_import.patch

diff --git a/~dev/rawrxd/src/deep2/vulkan_compute.h b/~dev/rawrxd/src/deep2/vulkan_compute.h
--- a/~dev/rawrxd/src/deep2/vulkan_compute.h
+++ b/~dev/rawrxd/src/deep2/vulkan_compute.h
@@
     bool WaitDownloadAsync(
         DownloadTicket& ticket,void* dst,size_t bytes);
     void CancelDownloadTicket(DownloadTicket& ticket);
+    bool ImportHostRowsIntoFullOutput(
+        const float* rows,uint32_t rowCount,uint32_t rowBegin,
+        uint32_t fullRows,uint32_t batch);
+    uint64_t SecondaryImportBytes() const noexcept {
+        return secondaryImportBytes_;
+    }
@@
 private:
+    uint64_t secondaryImportBytes_=0;

diff --git a/~dev/rawrxd/src/deep2/vulkan_compute.cpp b/~dev/rawrxd/src/deep2/vulkan_compute.cpp
--- a/~dev/rawrxd/src/deep2/vulkan_compute.cpp
+++ b/~dev/rawrxd/src/deep2/vulkan_compute.cpp
@@
+bool VulkanCompute::ImportHostRowsIntoFullOutput(
+    const float* rows,uint32_t rowCount,uint32_t rowBegin,
+    uint32_t fullRows,uint32_t batch)
+{
+    if(!rows||!rowCount||!fullRows||!batch||batch>4||
+       rowBegin>fullRows||rowCount>fullRows-rowBegin||
+       !EnsureResidentFullOutput(fullRows,batch))
+        return false;
+    const size_t slab=(size_t)rowCount*batch;
+    DeviceBuf* staging=nullptr;
+    void* mapped=nullptr;
+    if(!ensureMappedStaging(
+            true,slab*sizeof(float),staging,mapped))
+        return false;
+    std::memcpy(mapped,rows,slab*sizeof(float));
+    VkCommandBuffer cmd{};
+    VkQueryPool query{};
+    if(!beginCommand(cmd,query,true)) return false;
+    const VkDeviceSize rowBytes=(VkDeviceSize)rowCount*sizeof(float);
+    for(uint32_t b=0;b<batch;++b) {
+        const VkDeviceSize so=(VkDeviceSize)b*rowBytes;
+        const VkDeviceSize doff=
+            ((VkDeviceSize)b*fullRows+rowBegin)*sizeof(float);
+        if(!recordCopy(
+                cmd,*staging,residentFullOutput_,rowBytes,so,doff))
+            return false;
+    }
+    if(!endSubmitWait(
+            cmd,query,GpuWorkKind::ModelTransfer,
+            slab*sizeof(float),workEpoch_,nullptr))
+        return false;
+    secondaryImportBytes_+=slab*sizeof(float);
+    return true;
+}

