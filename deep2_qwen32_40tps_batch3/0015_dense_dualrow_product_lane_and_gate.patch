diff --git a/~dev/rawrxd/src/deep2/Deep2Engine.cpp b/~dev/rawrxd/src/deep2/Deep2Engine.cpp
--- a/~dev/rawrxd/src/deep2/Deep2Engine.cpp
+++ b/~dev/rawrxd/src/deep2/Deep2Engine.cpp
@@
