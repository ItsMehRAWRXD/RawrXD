# Deep2 Qwen32 40TPS — Batch 3/5, item 13
# Base: Batch 1-2 applied.
# Goal: allocate/update each Vulkan descriptor set once per unique buffer tuple.
# Current dispatchOps/dispatchQuant allocate and write descriptors on every
# matrix/op dispatch even when all buffers are resident and unchanged.
#
# Apply:
#   git -C F:\~dev apply --3way 0013_persistent_descriptor_cache.patch

diff --git a/~dev/rawrxd/src/deep2/vulkan_compute.h b/~dev/rawrxd/src/deep2/vulkan_compute.h
--- a/~dev/rawrxd/src/deep2/vulkan_compute.h
+++ b/~dev/rawrxd/src/deep2/vulkan_compute.h
@@
 private:
+    struct DescriptorKey {
+        uint64_t b0=0,b1=0,b2=0,b3=0;
+        bool operator==(const DescriptorKey& o) const noexcept {
+            return b0==o.b0&&b1==o.b1&&b2==o.b2&&b3==o.b3;
+        }
+    };
+    struct DescriptorKeyHash {
+        size_t operator()(const DescriptorKey& k) const noexcept {
+            uint64_t h=14695981039346656037ull;
+            const uint64_t v[4]={k.b0,k.b1,k.b2,k.b3};
+            for(uint64_t x:v){
+                h^=x; h*=1099511628211ull;
+                h^=x>>32; h*=1099511628211ull;
+            }
+            return static_cast<size_t>(h);
+        }
+    };
+
+    VkDescriptorSet getOpsDescriptor(
+        DeviceBuf& a,DeviceBuf& b,DeviceBuf& c,DeviceBuf& d);
+    VkDescriptorSet getQuantDescriptor(
+        DeviceBuf& w,DeviceBuf& in,DeviceBuf& out);
@@
     VkDescriptorPool descriptorPool_ = VK_NULL_HANDLE;
@@
     VkPipeline qPipeline_ = VK_NULL_HANDLE;
+    std::unordered_map<DescriptorKey,VkDescriptorSet,DescriptorKeyHash>
+        opsDescriptorCache_;
+    std::unordered_map<DescriptorKey,VkDescriptorSet,DescriptorKeyHash>
+        quantDescriptorCache_;

