file(REMOVE "${OUT}/${CASE}.json")
execute_process(COMMAND "${EXE}" evaluate "${ROOT}/tests/${CASE}/evidence.txt" "${OUT}/${CASE}.json" RESULT_VARIABLE rc OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(CASE STREQUAL "positive")
 if(NOT rc EQUAL 0)
  message(FATAL_ERROR "positive fixture failed: ${stderr}")
 endif()
 file(READ "${OUT}/${CASE}.json" body)
 if(NOT body MATCHES "\"overall\": \"FULL_PASS\"")
  message(FATAL_ERROR "positive fixture lacked FULL_PASS")
 endif()
elseif(CASE STREQUAL "partial")
 if(NOT rc EQUAL 1)
  message(FATAL_ERROR "partial fixture wrong exit: ${rc}")
 endif()
 file(READ "${OUT}/${CASE}.json" body)
 if(NOT body MATCHES "\"overall\": \"NOT_CERTIFIED\"")
  message(FATAL_ERROR "partial improperly certified")
 endif()
else()
 if(NOT rc EQUAL 2)
  message(FATAL_ERROR "malformed fixture not rejected: ${rc}")
 endif()
endif()
